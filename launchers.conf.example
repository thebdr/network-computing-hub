# Connection programs, per protocol.
#
# Each section is a protocol. Every other key is a launcher name mapped to its
# command line. "default" names the launcher the toolbar buttons use; right-click
# a connection in the manager to pick any of the others.
#
# Placeholders, substituted per token (so paths with spaces stay one argument):
#   {file}  full path to the .rdp file
#   {host}  hostname or IP
#   {user}  username
#   {port}  protocol port (RDP: "server port", VNC: rcm-vnc-port, default 5900)
#   {name}  connection name

[rdp]
default = Thincast
Thincast = flatpak run com.thincast.client {file}
xfreerdp = xfreerdp3 /v:{host}:{port} /u:{user} +clipboard +fonts /dynamic-resolution /cert:ignore
Remmina = remmina -c {file}
mstsc = mstsc {file}

[vnc]
default = Remmina
Remmina = remmina -c vnc://{host}:{port}
TigerVNC = vncviewer {host}::{port}

# Radmin Viewer. Nothing here is guessed by the code -- if a value is missing or
# points at something that does not exist, rcm says so instead of falling back.
# Run `rcm radmin detect --write` to fill in `exe` automatically.
[radmin]
exe =
# Wine binary. Leave EMPTY when Radmin runs natively (Windows, or a native build).
wine =
wineprefix =
port = 4899
# Only `rcm phonebook` needs this; it uses the file as a structural template.
phonebook =

# Credential-dialog handling. Raise the delays if characters go missing.
dialog_wait = 20
settle = 0.3
type_delay = 40
window_class = [Rr]admin
title_match = security
#   user-tab-pass : username field focused on open -> user, Tab, pass, Enter
#   pass-only     : password field focused, username prefilled -> pass, Enter
inject_order = user-tab-pass
