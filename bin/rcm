def missing_configs() -> list[str]:
    return [name for name in DEFAULT_CONFIGS if not (APP / name).is_file()]


def write_default_configs(names: list[str] | None = None) -> list[str]:
    """Create any missing config file from its documented default."""
    written = []
    for name in (names if names is not None else missing_configs()):
        dest = APP / name
        if dest.is_file():
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(DEFAULT_CONFIGS[name], encoding="utf-8")
        if name == "creds.conf":
            dest.chmod(0o600)
        written.append(name)
    # A clone carries templates/ in the repo; the .exe carries it inside, so
    # its first run puts an editable copy beside it like any other default.
    if names is None and not TEMPLATE.is_file() and BUNDLE != APP:
        TEMPLATE.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(BUNDLE / "templates" / "default.rdp", TEMPLATE)
        written.append("templates/default.rdp")
    return written


def expand_user_and_vars(value: str) -> str:
    return os.path.expandvars(os.path.expanduser(value.strip()))


def protocol_detect(p: Protocol) -> list[Path]:
    """Candidate paths for a protocol's `exe`, best first.

    Ranked, not first-hit: a machine can easily have a real install, an abandoned
    Wine prefix with no exe, and a couple of portable copies in Downloads.
    """
    stem = Path(p.exe).name if p.exe else f"{p.id}.exe"
    home = Path.home()
    roots = [home / ".local/share/wineprefixes", home, home / "WindowsApps",
             home / "Downloads", Path("/opt")]
    for env in ("ProgramFiles(x86)", "ProgramFiles"):
        if os.environ.get(env):
            roots.append(Path(os.environ[env]))
    seen, found = set(), []
    for root in roots:
        if not root.is_dir():
            continue
        try:
            for hit in root.glob(f"**/{stem}"):
                rp = hit.resolve()
                if rp not in seen and rp.is_file():
                    seen.add(rp)
                    found.append(rp)
        except (OSError, PermissionError):
            continue

    def rank(f: Path) -> tuple:
        s = str(f)
        return (0 if "wineprefixes" in s or "Program Files" in s else 1,
                0 if "Downloads" not in s else 1, -f.stat().st_size, s)
    return sorted(found, key=rank)


def save_protocols(protos: dict[str, Protocol]) -> None:
    """Rewrite protocols.conf.

    Regenerates the documentation header rather than round-tripping arbitrary
    comments -- configparser cannot preserve them, and a silently de-commented
    config is worse than a re-commented one.
    """
    head, _, _ = DEFAULT_CONFIGS["protocols.conf"].partition("\n[protocol:")
    L = [head.rstrip("\n"), ""]
    for p in protos.values():
        L.append(f"[protocol:{p.id}]")
        L.append(f"label = {p.label}")
        L.append(f"color = {p.color}")
        L.append(f"order = {p.order}")
        if p.port:
            L.append(f"port = {p.port}")
        if p.exe:
            L.append(f"exe = {p.exe}")
        for k, v in p.env.items():
            L.append(f"env.{k} = {v}")
        if p.default:
            L.append(f"default = {p.default}")
        for name, cmd in p.launchers.items():
            L.append(f"launcher.{name} = {cmd}")
        if p.detect_process:
            L.append(f"detect.process = {p.detect_process}")
        if p.detect_window:
            L.append(f"detect.window = {p.detect_window}")
        if p.inject_steps:
            if p.inject_class:
                L.append(f"inject.window_class = {p.inject_class}")
            if p.inject_title:
                L.append(f"inject.window_title = {p.inject_title}")
            L.append(f"inject.wait = {p.inject_wait}")
            L.append(f"inject.settle = {p.inject_settle}")
            L.append(f"inject.delay = {p.inject_delay}")
            L.append("inject.steps = " + " | ".join(
                op if not arg else f"{op}:{arg}" for op, arg in p.inject_steps))
        for k, v in p.extras.items():
            L.append(f"{k} = {v}")
        L.append("")
    PROTOCOLS_FILE.write_text("\n".join(L) + "\n", encoding="utf-8")


def migrate_launchers() -> bool:
    """Turn a pre-protocols launchers.conf into protocols.conf. One-way."""
    if PROTOCOLS_FILE.is_file() or not LEGACY_LAUNCHERS.is_file():
        return False
    cp = configparser.ConfigParser(inline_comment_prefixes=(";",))
    cp.optionxform = str
    cp.read(LEGACY_LAUNCHERS, encoding="utf-8")
    write_default_configs(["protocols.conf"])
    protos = load_protocols()
    for pid in ("rdp", "vnc"):
        if cp.has_section(pid):
            items = {k: v.strip() for k, v in cp.items(pid) if k != "default" and v.strip()}
            if items:
                protos[pid].launchers = items
            dflt = cp.get(pid, "default", fallback="").strip()
            if dflt in protos[pid].launchers:
                protos[pid].default = dflt
    if cp.has_section("radmin") and "radmin" in protos:
        r, p = dict(cp.items("radmin")), protos["radmin"]
        if r.get("exe"):
            p.exe = expand_user_and_vars(r["exe"])
        if r.get("wineprefix"):
            p.env["WINEPREFIX"] = expand_user_and_vars(r["wineprefix"])
        p.default = "Native" if not r.get("wine", "").strip() else "Wine"
        if r.get("wine", "").strip():
            p.launchers["Wine"] = f"{r['wine'].strip()} {{exe}} /connect:{{host}}:{{port}}"
        if r.get("phonebook"):
            p.extras["phonebook"] = expand_user_and_vars(r["phonebook"])
        for src, dst in (("port", "port"), ("dialog_wait", "inject_wait"),
                         ("settle", "inject_settle"), ("type_delay", "inject_delay")):
            if r.get(src):
                try:
                    setattr(p, dst, type(getattr(p, dst))(r[src]))
                except ValueError:
                    pass
        if r.get("window_class"):
            p.inject_class = r["window_class"]
        if r.get("title_match"):
            p.inject_title = r["title_match"]
        if r.get("inject_order") == "pass-only":
            p.inject_steps = parse_steps("type:{password} | key:Return")
    save_protocols(protos)
    LEGACY_LAUNCHERS.rename(LEGACY_LAUNCHERS.with_suffix(".conf.migrated"))
    return True


def launcher_names(proto: str) -> list[str]:
    try:
        return list(protocol(proto).launchers)
    except ConfigError:
        return []


@help_topic("via-gateways", "Via-gateways (SSH tunnels)",
            ("via", "gateway", "tunnel", "jump host", "bastion"),
            section="Connections")
def load_vias() -> dict[str, dict]:
    """A host behind a bastion connects through an SSH tunnel, automatically.

    Define the gateway once in protocols.conf: a `[via:plant-gw]` section with
    `host =` and optionally `user =`, `port =` (its SSH port, 22) and `hold =`
    (seconds the tunnel waits for the client to attach, 30). Point a
    connection at it under Edit ▸ Hooks & gateway — stored in the .rdp as
    `rcm-via:s:plant-gw`. Connecting then runs `ssh -f -L <free local
    port>:<host>:<port> <gateway> sleep <hold>` and the launcher receives
    127.0.0.1 and that port in {host} and {port}; the tunnel needs key auth
    to the gateway (BatchMode, so it never sits on a hidden prompt) and ends
    when the client disconnects. Such a session appears in the live list
    under the tunnel address rather than the connection's name, and the pre
    hook still sees the real {host} — it runs before the tunnel opens.
    """
    if not PROTOCOLS_FILE.is_file():
        return {}
    cp = configparser.ConfigParser(inline_comment_prefixes=(";",))
    cp.optionxform = str
    cp.read(PROTOCOLS_FILE, encoding="utf-8")
    out: dict[str, dict] = {}
    for section in cp.sections():
        if not section.startswith("via:"):
            continue
        name = section.split(":", 1)[1].strip()
        if not name:
            raise ConfigError(f"{PROTOCOLS_FILE}: a [via:] section has no name")
        raw = {k: v.strip() for k, v in cp.items(section)}
        if not raw.get("host"):
            raise ConfigError(f"{PROTOCOLS_FILE} [{section}] needs host =")
        via = {"host": raw["host"], "user": raw.get("user", "")}
        for key, default in (("port", 22), ("hold", 30)):
            try:
                via[key] = int(raw.get(key) or default)
            except ValueError:
                raise ConfigError(
                    f"{PROTOCOLS_FILE} [{section}] {key}={raw[key]!r} "
                    "is not a whole number") from None
        out[name] = via
    return out


def open_via_tunnel(via_name: str, dest_host: str, dest_port: int) -> int:
    """`ssh -f -L` to dest through the named gateway; returns the local port.

    `-f` + ExitOnForwardFailure means a zero exit guarantees the forward is
    listening; ssh backgrounds itself, holds `sleep <hold>` for the client to
    attach, then lives exactly as long as the forwarded connection does.
    """
    vias = load_vias()
    if via_name not in vias:
        raise ConfigError(f"unknown via {via_name!r} -- {PROTOCOLS_FILE} "
                          "defines: " + (", ".join(sorted(vias)) or "none"))
    via = vias[via_name]
    import socket
    # Picked-then-released, so a parallel launch could steal it; ssh fails
    # loudly (ExitOnForwardFailure) rather than silently sharing.
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        local_port = probe.getsockname()[1]
    target = f"{via['user']}@{via['host']}" if via["user"] else via["host"]
    argv = ["ssh", "-f", "-o", "BatchMode=yes",
            "-o", "ExitOnForwardFailure=yes", "-o", "ConnectTimeout=10",
            "-L", f"{local_port}:{dest_host}:{dest_port}",
            "-p", str(via["port"]), target, "sleep", str(via["hold"])]
    # Output goes to a file, not pipes: the backgrounded (-f) tunnel keeps
    # stderr open for its whole life, and reading a pipe to EOF would block
    # the launch here until the tunnel died.
    with tempfile.TemporaryFile(mode="w+") as output:
        completed = run_child(argv, stdin=subprocess.DEVNULL,
                              stdout=output, stderr=output, timeout=45)
        output.seek(0)
        ssh_said = output.read().strip()
    log_event("via", via=via_name, host=dest_host, port=dest_port,
              local_port=local_port, exit_code=completed.returncode)
    if completed.returncode != 0:
        raise RuntimeError(
            f"via {via_name}: tunnel failed (exit {completed.returncode}): "
            f"{ssh_said or ' '.join(argv)}")
    return local_port


def launch_placeholder_values(c: Conn, p: Protocol, password: str = "",
                              via: str = "") -> dict[str, str]:
    return {"file": str(c.path), "host": c.host, "user": c.username,
            "port": str(c.port_for(p)), "name": c.name, "exe": p.exe,
            "password": password, "via": via}


def build_argv(c: Conn, proto: str, launcher: str = "",
               overrides: dict | None = None) -> list[str]:
    p = protocol(proto)
    name = launcher or p.default
    tmpl = p.launchers.get(name, "")
    if not tmpl:
        raise RuntimeError(f"{PROTOCOLS_FILE}: protocol {proto!r} has no launcher"
                           + (f" named {name!r}" if name else ""))
    vals = launch_placeholder_values(c, p)
    if overrides:
        vals.update(overrides)
    # Substitute per token so a path with spaces stays a single argument.
    return [tok.format(**vals) for tok in shlex.split(tmpl)]


@help_topic("connecting", "Connecting", ("connect", "launch", "protocol"),
            section="Connections")
def launch(c: Conn, proto: str = "", launcher: str = "") -> str:
    """Connecting hands the connection to the protocol's configured program.

    The Connect buttons use each protocol's default launcher; right-click a
    row or a chip for the alternatives. A pre hook (rcm-pre) must exit 0
    first or the launch stops; a via-gateway (rcm-via) then opens its SSH
    tunnel and the client is pointed at the localhost end; clients that
    refuse a password on the command line get it typed into their prompt per
    the protocol's inject steps; the MAC is learned after launch so ⚡ Wake
    works later; and every launch is one line in the event log.
    """
    p = protocol(proto or next(iter(load_protocols())))
    via_name = (c.extra.get("rcm-via") or "").strip()
    argv = build_argv(c, p.id, launcher)
    if not shutil.which(argv[0]) and not Path(argv[0]).is_file():
        raise RuntimeError(f"{argv[0]} is not installed "
                           f"(launcher {launcher or p.default!r} for {p.label})")
    # Pre-hook: must exit 0 or the launch stops -- that is the contract that
    # makes gateway tunnels and mount scripts safe to rely on. It sees the
    # real {host}: it runs before any via-tunnel exists.
    pre_command = (c.extra.get("rcm-pre") or "").strip()
    if pre_command:
        rendered = pre_command.format(
            **launch_placeholder_values(c, p, via=via_name))
        completed = run_child(rendered, shell=True, capture_output=True,
                              text=True, timeout=120)
        log_event("pre-hook", sel=c.sel, command=rendered,
                  exit_code=completed.returncode)
        if completed.returncode != 0:
            raise RuntimeError(
                f"pre hook failed (exit {completed.returncode}): "
                f"{completed.stderr.strip() or rendered}")
    if via_name:
        local_port = open_via_tunnel(via_name, c.host, c.port_for(p))
        argv = build_argv(c, p.id, launcher,
                          {"host": "127.0.0.1", "port": str(local_port)})
    if p.injects:
        result = inject_credentials(c, p, argv)
    else:
        spawn_detached(argv, env=p.env or None)
        result = f"{p.label} -> {c.sel} ({c.host}) via {Path(argv[0]).name}"
    forget_sessions()
    if via_name:
        result += f" (through via {via_name})"
    log_event("launch", sel=c.sel, host=c.host, protocol=p.id,
              launcher=launcher or p.default,
              **({"via": via_name} if via_name else {}))
    post_command = (c.extra.get("rcm-post") or "").strip()
    if post_command:
        spawn_detached(["/bin/sh", "-c",
                        post_command.format(
                            **launch_placeholder_values(c, p, via=via_name))])
    # Remember the MAC while the host is surely on: that is what Wake needs later.
    mac = learn_mac(c.host)
    if mac and c.extra.get("rcm-mac") != mac:
        set_connection_extra(c, "rcm-mac", mac)
    return result


def inject_credentials(c: Conn, p: Protocol, argv: list[str]) -> str:
    """Launch, wait for the credential prompt, then perform inject.steps.

    Generic on purpose: any client that insists on typing (Radmin has no
    /password: switch by design, and others are the same) is handled by a step
    list in protocols.conf rather than bespoke code.
    """
    problem = PLATFORM.credential_typing_problem()
    if problem:
        raise RuntimeError(problem)

    user, pw = creds_lookup(c.sel, c.username, proto=p.id)
    win, _ = open_credential_prompt(p, c.host, argv)
    if not pw or pw == "CHANGEME":
        return f"prompt open on {c.host}; no password set -- type it manually"

    vals = launch_placeholder_values(c, p, password=pw)
    vals["user"] = user
    # xdotool type --window uses XSendEvent, which Wine ignores outright.
    # Always activate first, then type to the focused window via XTEST.
    xdotool("windowactivate", "--sync", win)
    time.sleep(p.inject_settle)
    for op, arg in p.inject_steps:
        if op == "type":
            xdotool("type", "--delay", str(p.inject_delay), "--", arg.format(**vals))
        elif op == "key":
            xdotool("key", arg)
        elif op == "sleep":
            time.sleep(float(arg or 0))
        elif op == "activate":
            xdotool("windowactivate", "--sync", win)
        elif op == "clear":
            xdotool("key", "ctrl+a")
            xdotool("key", "Delete")
    return f"{p.label} -> {c.sel} ({c.host}) as {user}"


def open_credential_prompt(p: Protocol, host: str, argv: list[str]) -> tuple[str, list[str]]:
    """Launch and wait for the credential window. (chosen window, all new)."""
    before = visible_protocol_windows(p)
    spawn_detached(argv, env=p.env or None)
    deadline = time.time() + p.inject_wait
    new: list[str] = []
    while time.time() < deadline:
        new = sorted(visible_protocol_windows(p) - before)
        if new:
            break
        time.sleep(0.25)
    if not new:
        raise RuntimeError(f"no {p.label} window appeared within {p.inject_wait:.0f}s")
    # Prefer the prompt by title, falling back to the newest window if the
    # wording ever changes.
    for w in new:
        nm = xdotool("getwindowname", w)
        if p.inject_title.lower() in nm.lower() and host in nm:
            return w, new
    return new[-1], new


def visible_protocol_windows(p: Protocol) -> set[str]:
    if p.inject_class:
        out = xdotool("search", "--onlyvisible", "--class", p.inject_class)
    else:
        out = xdotool("search", "--onlyvisible", "--name", p.inject_title or p.label)
    return {w for w in out.splitlines() if w.strip()}


def launch_rdp(c: Conn) -> None:
    launch(c, "rdp")


def xdotool(*args: str) -> str:
    return PLATFORM.xdotool(*args)


def capture_window(win: str, dest: Path) -> Path | None:
    """Save a picture of one window, or None if the tools are missing.

    Wine draws dialog controls inside a single X window, so no X query can say
    which field holds the caret. A picture can.
    """
    try:
        from PIL import Image
    except ImportError:
        return None
    geom = {}
    for line in xdotool("getwindowgeometry", "--shell", win).splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            geom[k.strip()] = v.strip()
    try:
        gx, gy = int(geom["X"]), int(geom["Y"])
        gw, gh = int(geom["WIDTH"]), int(geom["HEIGHT"])
    except (KeyError, ValueError):
        return None
    full = Path(tempfile.mkstemp(suffix=".png")[1])
    try:
        if not PLATFORM.screenshot_to(full):
            return None
        im = Image.open(full)
        pad = 10
        im.crop((max(0, gx - pad), max(0, gy - pad),
                 min(im.width, gx + gw + pad),
                 min(im.height, gy + gh + pad))).save(dest)
        return dest
    except (OSError, ValueError):
        return None
    finally:
        full.unlink(missing_ok=True)


def process_command_lines() -> list[tuple[int, str]]:
    return PLATFORM.process_command_lines()


def launcher_exe(p: Protocol, tmpl: str) -> str:
    """The program a launcher command runs, for the 'is it installed' check.

    {exe} is substituted whole rather than through shlex: a Windows-style path
    under Wine ("Program Files/Radmin Viewer 3") contains spaces and would
    otherwise be split into fragments that exist nowhere.
    """
    tmpl = tmpl.strip()
    if tmpl.startswith("{exe}"):
        return p.exe
    try:
        return shlex.split(tmpl)[0]
    except (ValueError, IndexError):
        return ""


def classify_process_protocol(args: str, protos: dict[str, Protocol] | None = None) -> Protocol | None:
    """Which protocol a command line represents, from each detect.process regex."""
    # A shell invoked with -c carries its whole script in argv, so a command that
    # merely mentions a host or a .rdp path would otherwise register as a session.
    if re.match(r"^\S*(ba|z|k)?sh\s+-c\b", args):
        return None
    # Thincast execs into "rdc <path>.rdp" inside its flatpak sandbox; bwrap is
    # the sandbox wrapper around the same argv, so counting it would double rows.
    if "bwrap" in args:
        return None
    for p in (protos or load_protocols()).values():
        if p.detect_process and re.search(p.detect_process, args):
            return p
    return None


@dataclass
class Session:
    """One live remote session, matched back to a saved connection when possible."""
    proto: str      # protocol label as configured, e.g. "RDP"
    label: str      # connection sel, or best-effort name when unmatched
    host: str
    pid: int
    window: str = ""   # X11 window id, empty when none was found


# One answer per moment. The manager's 4 s tick asks twice (the cards, the
# list), and the Live chip asks once per row each time the list refilters --
# on every keystroke in the filter box. Launching or ending a session forgets
# the answer, so neither waits for it to age out.
SESSIONS_FRESH_FOR = 1.0    # seconds
_sessions_seen: tuple[float, list[Session]] | None = None


def forget_sessions() -> None:
    global _sessions_seen
    _sessions_seen = None


def sessions() -> list[Session]:
    """Live sessions from any configured launcher, matched back to connections."""
    global _sessions_seen
    seen = _sessions_seen
    if seen and time.monotonic() - seen[0] < SESSIONS_FRESH_FOR:
        return list(seen[1])
    found = scan_sessions()
    _sessions_seen = (time.monotonic(), found)
    return list(found)


def scan_sessions() -> list[Session]:
    """sessions(), read from the process list now."""
    out: list[Session] = []
    by_path = {str(c.path): c for c in conns_cached()}
    seen: set[tuple[str, str, str]] = set()

    try:
        protos = load_protocols()
    except ConfigError:
        return out
    mine = {os.getpid(), os.getppid()}
    for pid, args in process_command_lines():
        if pid in mine:
            continue
        p = classify_process_protocol(args, protos)
        if not p:
            continue
        proto = p.label

        # Match the full .rdp path as a substring. A regex like (\S+\.rdp) breaks
        # the moment a connection is named "Line 1.rdp" -- it captures "1.rdp".
        c = next((cand for cand in by_path.values() if str(cand.path) in args), None)
        if c is None:
            # Fall back to matching the host anywhere in the command line.
            for cand in conns_cached():
                if cand.host and re.search(rf"(?<![\d.]){re.escape(cand.host)}(?![\d.])", args):
                    c = cand
                    break
        if c is not None:
            host, label = c.host, c.sel
        else:
            m = re.search(r"(\S+\.rdp)", args)
            host = ""
            label = Path(m.group(1)).stem if m else "?"

        key = (proto, label, host)
        if key in seen:
            continue
        seen.add(key)

        win = ""
        if host:
            pattern = (p.detect_window or "{host}").format(host=host, name=label)
            win = PLATFORM.session_window(pid, pattern)
        out.append(Session(proto, label, host, pid, win))

    # Stable, meaningful order: follow the saved list, then protocol. next/prev
    # would otherwise jump around, since ps order is not guaranteed.
    order = {c.sel: i for i, c in enumerate(conns_cached())}
    out.sort(key=lambda s: (order.get(s.label, 10_000), s.proto, s.pid))
    return out


def active_sels() -> dict[str, list[str]]:
    """{connection sel: [protocols currently connected]} -- for the GUI highlight."""
    live: dict[str, list[str]] = {}
    for s in sessions():
        live.setdefault(s.label, [])
        if s.proto not in live[s.label]:
            live[s.label].append(s.proto)
    return live


def focus_session(s: Session) -> bool:
    if s.window:
        xdotool("windowactivate", "--sync", s.window)
        return True
    return False


def kill_session(s: Session) -> None:
    try:
        os.kill(s.pid, 15)
    # Already gone: ProcessLookupError on Linux, "access denied" on Windows.
    except (ProcessLookupError, PermissionError):
        pass
    forget_sessions()


# --------------------------------------------------------------------------- #
# CSV import / export
# --------------------------------------------------------------------------- #
CSV_FIELDS = ["group", "name", "host", "username", "port"]


def csv_fields() -> list[str]:
    """Every column a full export writes, so it can be imported back unchanged.

    Per-protocol ports get a port_<id> column each, generated from the registry
    rather than listed, so a new protocol needs no change here.
    """
    extra = [f"port_{pid}" for pid in protocol_ids() if pid != "rdp"]
    return CSV_FIELDS + extra + ["protocols", "default_protocol", "shortcut"]


def export_csv(dest: Path, conns: list[Conn] | None = None) -> int:
    dest.parent.mkdir(parents=True, exist_ok=True)
    rows = conns if conns is not None else conns_cached(refresh=True)
    fields = csv_fields()
    keys = session_bindings()
    with dest.open("w", newline="", encoding="utf-8") as fh:
        w = csv.DictWriter(fh, fieldnames=fields)
        w.writeheader()
        for c in rows:
            row = {"group": c.group, "name": c.name, "host": c.host,
                   "username": c.username, "port": c.port,
                   "protocols": ",".join(c.protocols),
                   "default_protocol": c.default_protocol,
                   "shortcut": keys.get(c.sel, "")}
            for f in fields:
                if f.startswith("port_"):
                    row[f] = c.port_for(f[5:])
            w.writerow(row)
    return len(rows)


def export_rdp_files(conns: list[Conn], dest_dir: Path) -> int:
    """Copy the selected .rdp files out, keeping their group folders."""
    dest_dir.mkdir(parents=True, exist_ok=True)
    n = 0
    for c in conns:
        target = (dest_dir / c.group) if c.group else dest_dir
        target.mkdir(parents=True, exist_ok=True)
        shutil.copy2(c.path, target / c.path.name)
        n += 1
    return n


def import_csv(src: Path, overwrite: bool = False,
               dry_run: bool = False) -> tuple[list[str], list[str]]:
    """Returns (created, skipped) as human-readable lines."""
    created, skipped = [], []
    # utf-8-sig: Excel's "CSV UTF-8" leads with a BOM that would otherwise
    # glue itself onto the first column name.
    with src.open(newline="", encoding="utf-8-sig") as fh:
        reader = csv.DictReader(fh)
        missing = {"name", "host"} - set(reader.fieldnames or [])
        if missing:
            raise SystemExit(f"CSV missing required column(s): {', '.join(sorted(missing))}")
        for i, row in enumerate(reader, start=2):
            name = (row.get("name") or "").strip()
            host = (row.get("host") or "").strip()
            if not name or not host:
                skipped.append(f"line {i}: blank name or host")
                continue
            group = (row.get("group") or "").strip()
            user = (row.get("username") or "").strip()
            try:
                port = int((row.get("port") or "3389").strip() or 3389)
            except ValueError:
                skipped.append(f"line {i}: bad port {row.get('port')!r}")
                continue
            if re.search(r"[/\\]", name) or "\\" in group:
                skipped.append(f"line {i}: '/' is only allowed in group, to nest it")
                continue
            if group.startswith("/") or ".." in group.split("/"):
                skipped.append(f"line {i}: group must be a relative path")
                continue
            target = (RDP_DIR / group / f"{name}.rdp") if group else RDP_DIR / f"{name}.rdp"
            if target.exists() and not overwrite:
                skipped.append(f"{group}/{name}: already exists")
                continue
            ports = {}
            for col, val in row.items():
                if col and col.startswith("port_") and (val or "").strip():
                    try:
                        ports[col[5:]] = int(val.strip())
                    except ValueError:
                        pass
            protos = (row.get("protocols") or "").strip()
            if dry_run:
                created.append(f"{group}/{name} -> {host}:{port} (dry run)")
                continue
            write_rdp(group, name, host, user, port, overwrite=True,
                      ports=ports, protocols=protos,
                      default_proto=(row.get("default_protocol") or "").strip())
            binding = (row.get("shortcut") or "").strip()
            if binding:
                g, sess = load_shortcuts()
                sess[f"{group}/{name}" if group else name] = binding
                save_shortcuts(g, sess)
            created.append(f"{group}/{name} -> {host}:{port}")
    conns_cached(refresh=True)
    return created, skipped


# --------------------------------------------------------------------------- #
# Radmin phonebook export (experimental, never writes the live phonebook)
# --------------------------------------------------------------------------- #
# The .rpb is a fixed-stride record file: a small header, then N records of
# equal size (the stride is stored in the header at 0x0c, the count at 0x00).
# It is 99% zero padding, with UTF-16LE strings at fixed offsets inside each
# record. We clone real records as templates and patch only those strings.
PB_OFF_HOST = 4904
PB_OFF_NAME = 5104
PB_OFF_USER = 5908
PB_FIELD_CAP = 128  # bytes; conservative, verified against the live file


def phonebook_layout(raw: bytes) -> tuple[int, int, int]:
    count = int.from_bytes(raw[0:4], "little")
    stride = int.from_bytes(raw[12:16], "little")
    if not stride or count <= 0:
        raise RuntimeError("unrecognised phonebook header")
    header = len(raw) - count * stride
    if header < 0 or header > stride:
        raise RuntimeError(
            f"phonebook layout does not add up (size={len(raw)} count={count} stride={stride})")
    return header, stride, count


def phonebook_patch_string(rec: bytearray, off: int, value: str, marker: str = "") -> None:
    """Write a UTF-16LE string at off, optionally followed by a packed marker.

    Folder records store their type string ("folder") immediately after the name's
    terminator, so its position shifts with the name length -- it is packed, not at
    a fixed offset. Zeroing a flat span without rewriting it destroys the marker and
    Radmin stops seeing the record as a folder.
    """
    enc = value.encode("utf-16-le") + b"\x00\x00"
    if marker:
        enc += marker.encode("utf-16-le") + b"\x00\x00"
    if len(enc) > PB_FIELD_CAP:
        raise RuntimeError(f"value too long for phonebook field: {value!r}")
    rec[off:off + PB_FIELD_CAP] = b"\x00" * PB_FIELD_CAP
    rec[off:off + len(enc)] = enc


def export_phonebook(dest: Path, conns: list[Conn] | None = None,
                     source: Path | None = None) -> int:
    if source is None:
        pb = protocol("radmin").extras.get("phonebook", "")
        if not pb:
            raise RuntimeError(f"{PROTOCOLS_FILE} [protocol:radmin] has no "
                               "phonebook path; the export needs one as a "
                               "structural template")
        src = Path(pb)
    else:
        src = source
    if not src.is_file():
        raise RuntimeError(f"no source phonebook to use as a template: {src}")
    if dest.resolve() == src.resolve():
        raise RuntimeError("refusing to overwrite the live phonebook")
    raw = src.read_bytes()
    header_len, stride, count = phonebook_layout(raw)
    recs = [raw[header_len + i * stride: header_len + (i + 1) * stride]
            for i in range(count)]

    # A host record has an IP at PB_OFF_HOST; anything else is a folder record.
    def is_host(r: bytes) -> bool:
        s = r[PB_OFF_HOST:PB_OFF_HOST + 64].decode("utf-16-le", "ignore").split("\x00")[0]
        return bool(re.match(r"^[0-9]{1,3}(\.[0-9]{1,3}){3}$|^[A-Za-z]", s)) and bool(s)

    host_tpl = next((r for r in recs if is_host(r)), None)
    if host_tpl is None:
        raise RuntimeError("no host record found to use as a template")
    folder_tpl = next((r for r in recs if not is_host(r)), None)

    conns = conns if conns is not None else conns_cached(refresh=True)
    out_recs: list[bytes] = []
    for g in sorted({c.group for c in conns if c.group}):
        if folder_tpl is not None:
            fr = bytearray(folder_tpl)
            phonebook_patch_string(fr, PB_OFF_NAME, g, marker="folder")
            out_recs.append(bytes(fr))
    for c in conns:
        r = bytearray(host_tpl)
        phonebook_patch_string(r, PB_OFF_HOST, c.host)
        phonebook_patch_string(r, PB_OFF_NAME, c.name)
        phonebook_patch_string(r, PB_OFF_USER, c.username)
        out_recs.append(bytes(r))

    head = bytearray(raw[:header_len])
    head[0:4] = len(out_recs).to_bytes(4, "little")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(bytes(head) + b"".join(out_recs))
    return len(out_recs)


# --------------------------------------------------------------------------- #
# help: generated guide + Open-code editor chain
# --------------------------------------------------------------------------- #
HELP_DIR = APP / "help"
EDITOR_CANDIDATES = (
    ("code", ["code", "--goto", "{file}:{line}"]),
    ("subl", ["subl", "{file}:{line}"]),
    ("gedit", ["gedit", "+{line}", "{file}"]),
    ("kate", ["kate", "-l", "{line}", "{file}"]),
    ("notepad++", ["notepad++", "-n{line}", "{file}"]),
)


def open_in_editor(file: str, line: int) -> str:
    """Open a source location in a goto-capable editor. Returns a status.

    The editor chosen in ui.conf wins; otherwise the first known editor on
    PATH is used and remembered. With none found the caller shows the advice
    dialog — this function never guesses at a plain text editor by itself.
    """
    state = load_ui_state()
    target = str((APP / file).resolve()) if not Path(file).is_absolute() else file
    chain = list(EDITOR_CANDIDATES)
    if state.get("editor"):
        chain.insert(0, (state["editor"].split()[0],
                         state["editor"].split() + ["{file}:{line}"]))
    for name, template in chain:
        if shutil.which(name):
            argv = [part.format(file=target, line=line) for part in template]
            spawn_detached(argv)
            if not state.get("editor"):
                state["editor"] = name
                save_ui_state(state)
            return f"opened {file}:{line} in {name}"
    return ""


def dump_help_html() -> int:
    """Write help/*.html from the registry: the offline guide, generated.

    Behaviour text lives only in the source docstrings; this render adds
    framing, never content. Regenerated whenever the topics change.
    """
    import html
    HELP_DIR.mkdir(parents=True, exist_ok=True)
    style = ("<style>body{font-family:sans-serif;margin:2em;max-width:46em}"
             "pre{background:#f4f4f4;padding:1em}a{color:#1a5fb4}"
             "small{color:#777}</style>")
    index_lines = [f"<h1>Network Computing Hub — guide</h1>{style}",
                   "<p><small>generated from the source at launch — the code "
                   "is the manual</small></p>"]
    from rcm_help import topics_by_section
    for section, topics in topics_by_section().items():
        index_lines.append(f"<h2>{html.escape(section)}</h2><ul>")
        for topic in topics:
            index_lines.append(
                f'<li><a href="{topic.topic_id}.html">'
                f"{html.escape(topic.title)}</a></li>")
            body = "".join(f"<p>{html.escape(par)}</p>"
                           for par in topic.body.split("\n\n"))
            source = (f"<hr><p><small>⌁ the source is the full manual: "
                      f"{html.escape(topic.source_file)}:{topic.source_line} "
                      f"{html.escape(topic.symbol)}()</small></p>"
                      if topic.source_file else "")
            (HELP_DIR / f"{topic.topic_id}.html").write_text(
                f"<h1>{html.escape(topic.title)}</h1>{style}{body}{source}"
                f'<p><a href="index.html">← guide index</a></p>',
                encoding="utf-8")
        index_lines.append("</ul>")
    (HELP_DIR / "index.html").write_text("\n".join(index_lines), encoding="utf-8")
    return len(HELP_TOPICS)


# --------------------------------------------------------------------------- #
# workspaces: named sets of connections opened together
# --------------------------------------------------------------------------- #
@help_topic("workspaces", "Workspaces", ("workspace", "connect all", "sets"),
            section="Connections")
def load_workspaces() -> dict[str, list[dict]]:
    """A workspace opens a named set of connections in one go.

    workspaces.conf holds one [workspace:<name>] section per set; each member
    line is `member.<n> = <sel>|<protocol>|<monitor>` (protocol and monitor
    optional; monitor is 1-based in xrandr order and the member's window is
    moved there once it appears). Connecting a workspace walks its members
    with the usual launch stagger; members that are already live are focused,
    never relaunched. A workspace can carry its own keyboard shortcut —
    `workspace:<name> = <combo>` under [sessions] in shortcuts.conf — and
    sits in the Browse sidebar: click to see its members, double-click to
    connect them all.
    """
    if not WORKSPACES_CONF.is_file():
        return {}
    parser = configparser.ConfigParser(inline_comment_prefixes=(";",))
    parser.optionxform = str
    parser.read(WORKSPACES_CONF, encoding="utf-8")
    out: dict[str, list[dict]] = {}
    for section in parser.sections():
        if not section.startswith("workspace:"):
            continue
        name = section.split(":", 1)[1].strip()
        members = []
        for _key, raw in sorted(parser.items(section)):
            if not _key.startswith("member"):
                continue
            parts = (raw.split("|") + ["", ""])[:3]
            if parts[0].strip():
                members.append({"sel": parts[0].strip(),
                                "protocol": parts[1].strip(),
                                "monitor": parts[2].strip()})
        out[name] = members
    return out


def save_workspaces(spaces: dict[str, list[dict]]) -> None:
    """Rewrite workspaces.conf. Managed file: the header is the documented
    default, so hand-edits to comments don't survive a GUI save -- sections do."""
    lines = [DEFAULT_CONFIGS["workspaces.conf"].rstrip("\n"), ""]
    for name, members in spaces.items():
        lines.append(f"[workspace:{name}]")
        for index, member in enumerate(members, start=1):
            parts = [member.get("sel", ""), member.get("protocol", ""),
                     str(member.get("monitor", "") or "")]
            while parts and not parts[-1]:
                parts.pop()
            lines.append(f"member.{index} = {'|'.join(parts)}")
        lines.append("")
    WORKSPACES_CONF.write_text("\n".join(lines).rstrip("\n") + "\n", encoding="utf-8")


def connect_workspace(name: str) -> list[str]:
    """Open every member; focus the ones already live. Returns status lines.

    A member with a monitor number gets its window moved to that monitor
    (1-based, xrandr order) once it appears — a move, not a resize, and only
    for members launched by this call: already-live windows stay where the
    operator put them.
    """
    members = load_workspaces().get(name)
    if members is None:
        raise ConfigError(f"{WORKSPACES_CONF}: no [workspace:{name}] section")
    live = active_sels()
    lines = []
    pending_placement: list[tuple[str, str]] = []
    for position, member in enumerate(members):
        c = find(member["sel"])
        if not c:
            lines.append(f"{member['sel']}: not found")
            continue
        if member["sel"] in live:
            for session in sessions():
                if session.label == member["sel"] and session.window:
                    focus_session(session)
                    break
            lines.append(f"{member['sel']}: already live — focused")
            continue
        if position:
            time.sleep(2)
        try:
            lines.append(launch(c, member["protocol"] or c.default_protocol))
        except (RuntimeError, ConfigError) as problem:
            lines.append(f"{member['sel']}: {problem}")
            continue
        if member["monitor"]:
            pending_placement.append((member["sel"], member["monitor"]))
    place_workspace_members(pending_placement, lines)
    log_event("workspace", name=name, members=len(members))
    return lines


def monitor_geometry() -> dict[int, tuple[int, int, int, int]]:
    """1-based monitor index -> (x, y, width, height), in xrandr order."""
    return PLATFORM.monitor_geometry()


def place_workspace_members(pending: list[tuple[str, str]], lines: list[str],
                            wait_seconds: float = 20.0) -> None:
    """Move freshly launched members' windows to their configured monitors.

    One shared deadline for the lot: windows appear on their own schedule,
    so keep sweeping the session list and place whatever has shown up.
    """
    todo: dict[str, int] = {}
    for sel, monitor_raw in pending:
        try:
            todo[sel] = int(monitor_raw)
        except ValueError:
            lines.append(f"{sel}: monitor {monitor_raw!r} is not a number")
    if not todo:
        return
    # The members are already connected by now; losing their result lines to
    # a raise would hide that, so say what was skipped and keep them.
    if not PLATFORM.window_control:
        lines.append(f"monitor placement skipped: not available on "
                     f"{PLATFORM.name} yet")
        return
    monitors = monitor_geometry()
    deadline = time.time() + wait_seconds
    while todo and time.time() < deadline:
        for session in sessions():
            wanted = todo.get(session.label)
            if wanted is None or not session.window:
                continue
            geometry = monitors.get(wanted)
            if geometry is None:
                lines.append(f"{session.label}: monitor {wanted} not present "
                             f"({len(monitors)} active)")
            else:
                xdotool("windowmove", session.window,
                        str(geometry[0]), str(geometry[1]))
                lines.append(f"{session.label}: placed on monitor {wanted}")
            del todo[session.label]
        if todo:
            time.sleep(0.5)
    for sel in todo:
        lines.append(f"{sel}: window never appeared for monitor placement")


# --------------------------------------------------------------------------- #
# backups: folders on remote PCs, archived there, fetched here
# --------------------------------------------------------------------------- #
BACKUP_STAMP = "%Y%m%d_%H%M"     # in the archive's name; its day folder is [:8]


@dataclass
class BackupSettings:
    keep_days: int
    archiver: str
    extension: str
    remote_temp: str
    timeout_minutes: float
    dest: dict[str, str]          # scope -> folder on this computer
    folders: dict[str, str]       # scope -> "C:\A; D:\B" ("" = nothing here)
    skip: dict[str, str]          # scope -> regex ("" = skip nothing)


@dataclass
class BackupResult:
    sel: str
    ok: bool
    message: str
    archive: Path | None = None
    log: Path | None = None
    files: int = 0
    size: int = 0
    skipped: int = 0
    skipped_size: int = 0
    largest: list[tuple[int, str]] = field(default_factory=list)
    skipped_largest: list[tuple[int, str]] = field(default_factory=list)
    dest_dir: Path | None = None
    idle: bool = False     # no folders configured: nothing to do, not a failure


def load_backup_settings() -> BackupSettings:
    if not BACKUPS_CONF.is_file():
        raise ConfigError(f"no {BACKUPS_CONF} -- run `rcm init`, or open the "
                          "manager once")
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    cp.read(BACKUPS_CONF, encoding="utf-8")
    if not cp.has_section("backup"):
        raise ConfigError(f"{BACKUPS_CONF}: no [backup] section")
    raw = dict(cp.items("backup"))

    def need(key: str) -> str:
        value = raw.get(key, "").strip()
        if not value:
            raise ConfigError(f"{BACKUPS_CONF} [backup] {key} is not set")
        return value

    def number(key: str, cast):
        try:
            return cast(need(key))
        except ValueError:
            raise ConfigError(f"{BACKUPS_CONF} [backup] {key}={raw[key]!r} "
                              "is not a number") from None

    archiver = need("archiver")
    for placeholder in ("{archive}", "{list}"):
        if placeholder not in archiver:
            raise ConfigError(f"{BACKUPS_CONF} [backup] archiver has no "
                              f"{placeholder}")
    table = {name: dict(cp.items(name)) if cp.has_section(name) else {}
             for name in ("dest", "folders", "skip")}
    if raw.get("dest", "").strip() and "DEFAULT" not in table["dest"]:
        table["dest"]["DEFAULT"] = raw["dest"]   # written before [dest] existed
    return BackupSettings(
        keep_days=number("keep_days", int),
        archiver=archiver,
        extension=need("extension").lstrip("."),
        remote_temp=need("remote_temp").rstrip("\\"),
        timeout_minutes=number("timeout_minutes", float),
        **table)


def save_backup_settings(settings: BackupSettings) -> None:
    """Rewrite backups.conf: its documented template, carrying these values.

    The comments are regenerated rather than round-tripped, as for
    protocols.conf -- configparser cannot keep them, and a file that lost
    its documentation is worse than one that got it back.
    """
    values = {"keep_days": str(settings.keep_days),
              "archiver": settings.archiver, "extension": settings.extension,
              "remote_temp": settings.remote_temp,
              "timeout_minutes": f"{settings.timeout_minutes:g}"}
    tables = {"dest": settings.dest, "folders": settings.folders,
              "skip": settings.skip}
    out: list[str] = []
    section = ""

    def close_table():
        if section in tables:
            while out and not out[-1].strip():
                out.pop()
            out.extend(f"{scope} = {value}".rstrip()
                       for scope, value in tables[section].items())
            out.append("")

    for line in DEFAULT_CONFIGS["backups.conf"].splitlines():
        header = re.match(r"^\[(\w+)\]\s*$", line)
        if header:
            close_table()
            section = header.group(1)
            out.append(line)
            continue
        key = re.match(r"^(\w+)\s*=", line)
        if section == "backup" and key and key.group(1) in values:
            out.append(f"{key.group(1)} = {values[key.group(1)]}")
        elif section in tables and line.strip() and not line.startswith("#"):
            continue        # the template's own entries give way to ours
        else:
            out.append(line)
    close_table()
    BACKUPS_CONF.write_text("\n".join(out).rstrip("\n") + "\n", encoding="utf-8")


def backup_dest(sel: str, settings: BackupSettings) -> Path:
    value = _scoped(settings.dest, sel)
    if not value:
        raise ConfigError(f"{BACKUPS_CONF} [dest] has no entry for {sel} "
                          "(nor a DEFAULT)")
    return Path(expand_user_and_vars(value))


def _scoped(table: dict[str, str], sel: str) -> str | None:
    """The most specific entry for sel: itself, each group up, DEFAULT."""
    for scope in creds_chain(sel):
        if scope in table:
            return table[scope].strip()
    return None


def backup_folders(sel: str, settings: BackupSettings) -> list[str]:
    value = _scoped(settings.folders, sel) or ""
    folders = [f.strip().rstrip("\\") for f in value.split(";") if f.strip()]
    for folder in folders:
        if not re.match(r"^[A-Za-z]:\\", folder + "\\"):
            raise ConfigError(f"{BACKUPS_CONF} [folders] {folder!r} is not a "
                              r"full Windows path (C:\...)")
    return folders


def backup_skip(sel: str, settings: BackupSettings) -> re.Pattern | None:
    value = _scoped(settings.skip, sel)
    if not value:
        return None
    try:
        return re.compile(value, re.IGNORECASE)
    except re.error as e:
        raise ConfigError(f"{BACKUPS_CONF} [skip] {value!r}: {e}") from None


def _admin_share(path: str) -> tuple[str, str]:
    """C:\\PRODUCTION -> ("c$", "PRODUCTION")."""
    return path[0].lower() + "$", path[3:]


def _archive_stem(sel: str) -> str:
    return re.sub(r'[\\/:*?"<>|\s]+', "_", sel)


@help_topic("backups", "Backups", ("backup", "archive", "rar", "7z", "winrar",
                                   "wmi", "crash dump", "retention"),
            section="Connections")
def backup_one(c: Conn, settings: BackupSettings, stamp: str,
               dry_run: bool = False, progress=lambda text: None,
               abort=None) -> BackupResult:
    """Back up… archives folders ON each remote PC, then fetches the archive.

    Right-click a selection ▸ Back up… (a group means all of it), or run
    `rcm backup <connection or group>… [--dry-run]` from Task Scheduler.
    backups.conf says what: [folders] and [skip] are looked up per scope,
    most specific first like credentials (Group/Name → Group → DEFAULT);
    skip is a regex matched against each file's full path on the PC, and a
    matching folder is left out whole — crash dumps never get read at all.

    Per PC: its admin shares open with the credential chain (`@backup`
    entries first), the folders are listed and filtered here, the exact
    file list goes into a run folder on the PC, and WMI starts the PC's own
    archiver on it at below-normal priority — WinRAR by default, from its
    installation there, since plant PCs often let nothing else run. Only
    the finished archive crosses the network, to <dest>/<YYYYMMDD>/<Group_
    Name>_<YYYYMMDD_HHMM>.<ext> — [dest] is per scope too, so a project's
    group can send its archives straight to its own folder — with the
    archiver's log beside it; the run folder on the PC is removed. A dry
    run stops after the listing and reports what would go in, what the
    skip regex leaves out, and the largest files. An archiver exit other
    than 0 that still left an archive (files in use, typically) keeps it
    and says so — the log names them. Day folders older than keep_days are
    deleted after a backup.
    """
    result = BackupResult(c.sel, False, "")
    folders = backup_folders(c.sel, settings)
    if not folders:
        # A group usually holds PCs with nothing to keep; a whole-group run
        # from Task Scheduler must not read as failed because of them.
        result.ok = result.idle = True
        result.message = f"nothing to back up (no [folders] entry in {BACKUPS_CONF.name})"
        return result
    skip = backup_skip(c.sel, settings)
    result.dest_dir = backup_dest(c.sel, settings) / stamp[:8]
    user, password = creds_lookup(c.sel, c.username, proto="backup")
    if not password:
        result.message = "no password on its credential chain (Setup ▸ Credentials)"
        return result

    shares = {_admin_share(f)[0] for f in folders}
    if not dry_run:
        shares.add(_admin_share(settings.remote_temp)[0])
    opened: list[str] = []
    run_dir, run_unc = "", None
    leave_run_dir = False     # 7-Zip may still be using it
    try:
        roots: dict[str, str] = {}
        for share in sorted(shares):
            progress(f"opening \\\\{c.host}\\{share}")
            unc, ours = PLATFORM.smb_connect(c.host, share, user, password)
            roots[share] = unc
            if ours:
                opened.append(unc)

        progress("listing files")
        listed: list[tuple[str, int]] = []
        left_out: list[tuple[int, str]] = []

        def tally(local_dir: Path) -> tuple[int, int]:
            """(files, bytes) under a skipped folder -- listed, never read."""
            count = total = 0
            for root, _dirs, names in os.walk(local_dir):
                for name in names:
                    try:
                        total += os.stat(os.path.join(root, name)).st_size
                        count += 1
                    except OSError:
                        pass
            return count, total

        for folder in folders:
            share, rest = _admin_share(folder)
            top = Path(roots[share]) / rest
            if not top.is_dir():
                result.message = f"{folder} does not exist on {c.host}"
                return result
            stack = [(top, folder)]
            while stack:
                local_dir, remote_dir = stack.pop()
                try:
                    entries = list(os.scandir(local_dir))
                except OSError:
                    continue
                for entry in entries:
                    remote = f"{remote_dir}\\{entry.name}"
                    if entry.is_junction():
                        continue    # can loop back on itself
                    if entry.is_dir(follow_symlinks=False):
                        if not (skip and skip.search(remote + "\\")):
                            stack.append((Path(entry.path), remote))
                            continue
                        count, total = tally(Path(entry.path))
                        result.skipped += count
                        result.skipped_size += total
                        left_out.append((total, remote + "\\"))
                        continue
                    size = entry.stat(follow_symlinks=False).st_size
                    if skip and skip.search(remote):
                        result.skipped += 1
                        result.skipped_size += size
                        left_out.append((size, remote))
                    else:
                        listed.append((remote, size))
        result.files = len(listed)
        result.size = sum(size for _, size in listed)
        result.largest = sorted(((s, p) for p, s in listed), reverse=True)[:10]
        result.skipped_largest = sorted(left_out, reverse=True)[:200]
        if dry_run:
            result.ok = True
            result.message = (f"would archive {result.files} files "
                              f"({human_size(result.size)}), skip {result.skipped} "
                              f"({human_size(result.skipped_size)}) "
                              f"into {result.dest_dir}")
            return result
        if not listed:
            result.message = "nothing left to archive once skip is applied"
            return result

        import uuid
        run_dir = f"{settings.remote_temp}\\nch-backup-{uuid.uuid4().hex[:8]}"
        share, rest = _admin_share(run_dir)
        run_unc = Path(roots[share]) / rest
        packed_name = f"archive.{settings.extension}"
        progress("writing the file list on the PC")
        run_unc.mkdir(parents=True)
        (run_unc / "files.txt").write_text(
            "\n".join(p for p, _ in listed) + "\n", encoding="utf-8")
        # One cmd line, no batch file: on a Windows 10 IoT plant PC, a .cmd or
        # a copied .exe started through WMI were refused while cmd /c and the
        # installed WinRAR ran. The outer quotes are the pair cmd /c strips;
        # /v:on makes !errorlevel! the archiver's code, not the one when the
        # line was parsed; `> file echo` puts the redirect first, since
        # `echo 0> file` would redirect handle 0. The run folder holds only
        # fixed ASCII names -- the archive gets its real name once fetched.
        archiver = (settings.archiver
                    .replace("{archive}", f'"{run_dir}\\{packed_name}"')
                    .replace("{list}", f'"{run_dir}\\files.txt"'))
        command = (f'cmd.exe /d /v:on /c "{archiver} > "{run_dir}\\archiver.log" '
                   f'2>&1 & > "{run_dir}\\exit.txt" echo !errorlevel!"')

        progress("starting the archiver through WMI")
        PLATFORM.remote_start(c.host, user, password, command, run_dir)
        leave_run_dir = True
        started = time.time()
        deadline = started + settings.timeout_minutes * 60
        exit_file = run_unc / "exit.txt"
        while not exit_file.is_file():
            if abort is not None and abort.is_set():
                result.message = (f"stopped waiting; the archiver may still be "
                                  f"running in {run_dir} on {c.host}")
                return result
            if time.time() > deadline:
                result.message = (f"no archive after {settings.timeout_minutes:g} "
                                  f"min; its run folder is left at {run_dir}")
                return result
            try:
                written = (run_unc / packed_name).stat().st_size
            except OSError:
                written = 0
            minutes, seconds = divmod(int(time.time() - started), 60)
            progress(f"compressing on the PC {minutes}:{seconds:02d}, "
                     f"{human_size(written)} so far")
            time.sleep(2)
        time.sleep(0.5)   # the redirect closes the file a moment after it exists
        leave_run_dir = False
        code = int(exit_file.read_text(encoding="ascii").strip() or "255")

        # One folder per day, the time in the archive's name; a second run in
        # the same minute gets _2 rather than overwriting the first.
        dest_dir = result.dest_dir
        dest_dir.mkdir(parents=True, exist_ok=True)
        name = f"{_archive_stem(c.sel)}_{stamp}"
        n = 2
        while (dest_dir / f"{name}.{settings.extension}").exists():
            name = f"{_archive_stem(c.sel)}_{stamp}_{n}"
            n += 1
        result.log = dest_dir / f"{name}.log"
        shutil.copyfile(run_unc / "archiver.log", result.log)
        packed = run_unc / packed_name
        if packed.is_file():
            progress(f"fetching {human_size(packed.stat().st_size)}")
            result.archive = dest_dir / f"{name}.{settings.extension}"
            shutil.copyfile(packed, result.archive)
            result.ok = True
            result.message = (f"{human_size(result.archive.stat().st_size)} from "
                              f"{result.files} files ({human_size(result.size)})")
            if code:
                result.message += (f" -- archiver exit {code}, files in use "
                                   "probably; the log names them")
        else:
            result.message = f"archiver exit {code}, no archive -- see {result.log}"
        return result
    except (RuntimeError, OSError) as problem:
        result.ok = False
        result.message = str(problem)
        return result
    finally:
        if run_unc is not None and not leave_run_dir:
            shutil.rmtree(run_unc, ignore_errors=True)
            if run_unc.exists():
                result.message += f"; could not remove {run_dir} on {c.host}"
        for unc in opened:
            PLATFORM.smb_disconnect(unc)
        if not dry_run:
            log_event("backup", sel=c.sel, host=c.host, ok=result.ok,
                      message=result.message, files=result.files,
                      skipped=result.skipped,
                      archive=str(result.archive or ""), log=str(result.log or ""))


def prune_backups(settings: BackupSettings) -> list[Path]:
    """Delete day folders older than keep_days under every [dest]; them.

    Only folders named like a day (YYYYMMDD), and only the archives and
    .log files backups write in them -- anything else there is left, and
    keeps its folder too.
    """
    from datetime import date, datetime, timedelta
    if settings.keep_days <= 0:
        return []
    cutoff = date.today() - timedelta(days=settings.keep_days)
    removed = []
    roots = {Path(expand_user_and_vars(v)) for v in settings.dest.values() if v}
    for root in sorted(roots):
        if not root.is_dir():
            continue
        for day in sorted(root.iterdir()):
            if not (day.is_dir() and re.fullmatch(r"\d{8}", day.name)):
                continue
            try:
                if datetime.strptime(day.name, "%Y%m%d").date() >= cutoff:
                    continue
            except ValueError:
                continue
            for item in day.iterdir():
                if item.is_file() and item.suffix.lower() in (
                        f".{settings.extension.lower()}", ".rar", ".7z", ".zip",
                        ".log"):
                    item.unlink()
            try:
                day.rmdir()
                removed.append(day)
            except OSError:
                pass
    return removed


def human_size(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


# --------------------------------------------------------------------------- #
# event log: one JSONL line per user-visible event
# --------------------------------------------------------------------------- #
@help_topic("logging", "The event log", ("logs", "jsonl", "history"),
            section="Logs")
def log_event(kind: str, **fields) -> None:
    """Everything notable appends one JSON line to logs/YYYY-MM-DD.jsonl.

    Session launches and ends (with duration), script runs (with exit codes),
    probe transitions, Wake-on-LAN sends and credential changes all land in
    the same daily file — plain JSONL, one object per line, rotated by name.
    The Logs page reads these; `rcm history <sel>` filters to one connection.
    """
    import json
    from datetime import datetime, timezone
    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc)
    record = {"ts": stamp.isoformat(timespec="seconds"), "kind": kind, **fields}
    day_file = LOGS_DIR / f"{stamp:%Y-%m-%d}.jsonl"
    with day_file.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def read_log_events(days: int = 7, kind: str = "", sel: str = "") -> list[dict]:
    """Newest-first events from the last N daily files, optionally filtered."""
    import json
    from datetime import datetime, timedelta, timezone
    events: list[dict] = []
    today = datetime.now(timezone.utc).date()
    # Oldest file first, so the final reverse() is newest-first globally,
    # not just within each day.
    for offset in reversed(range(days)):
        day_file = LOGS_DIR / f"{today - timedelta(days=offset):%Y-%m-%d}.jsonl"
        if not day_file.is_file():
            continue
        for line in day_file.read_text(encoding="utf-8").splitlines():
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if kind and record.get("kind") != kind:
                continue
            if sel and record.get("sel") != sel:
                continue
            events.append(record)
    events.reverse()
    return events


# --------------------------------------------------------------------------- #
# online probe + Wake-on-LAN
# --------------------------------------------------------------------------- #
def probe_host(host: str, port: int, timeout: float = 1.0) -> bool:
    """One TCP connect: does anything accept on host:port."""
    import socket
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


PROBE_TIMEOUT = 1.0     # seconds, per ping and per TCP connect
PROBE_PARALLEL = 16     # hosts in flight at once, so 500 never means 500 sockets
# TEST-NET-1 (RFC 5737), assigned to no machine anywhere. A port that accepts a
# connection there is answered by something on the way -- a proxy taking every
# web connection, as on the network this was written on -- and a connect to
# that port proves nothing about a real host.
PROBE_SENTINEL = "192.0.2.1"


def probe_targets(conns: list[Conn]) -> dict[str, list[int]]:
    """{host: ports to try when it ignores ping}, in the order given.

    The ports are each enabled protocol's, default first. A connection behind
    a via gateway is left out: only the gateway can reach it.
    """
    targets: dict[str, list[int]] = {}
    for c in conns:
        if not c.host or (c.extra.get("rcm-via") or "").strip():
            continue
        ports = targets.setdefault(c.host, [])
        default = c.default_protocol
        for pid in ([default] if default else []) + [
                p for p in c.protocols if p != default]:
            port = c.port_for(pid)
            if port and port not in ports:
                ports.append(port)
    return targets


def sweep_reachability(conns: list[Conn], report, stop=lambda: False) -> None:
    """Decide every probe-able host, calling report(host, reachable, how).

    Ping first, all hosts at once: it answers for nearly every machine.
    Only hosts that stay silent get a TCP connect to each of their ports,
    skipping any port the network itself answers (PROBE_SENTINEL). `how` is
    "ping", "tcp/<port>", or "" for offline. stop() ends the sweep early.
    """
    from concurrent.futures import ThreadPoolExecutor, as_completed
    targets = probe_targets(conns)
    if not targets:
        return
    order = list(targets)

    def ping(host: str) -> bool | None:
        try:
            return PLATFORM.ping(host, PROBE_TIMEOUT)
        except Exception:
            return None

    silent: list[str] = []
    pool = ThreadPoolExecutor(PROBE_PARALLEL)
    try:
        asked = {pool.submit(ping, host): host for host in order}
        for done in as_completed(asked):
            if stop():
                return
            if done.result():
                report(asked[done], True, "ping")
            else:
                silent.append(asked[done])
        if not silent:
            return
        silent.sort(key=order.index)
        ports = sorted({p for host in silent for p in targets[host]})
        blind = {port for port, hit in zip(ports, pool.map(
            lambda p: probe_host(PROBE_SENTINEL, p, PROBE_TIMEOUT), ports)) if hit}

        def connect(host: str) -> int | None:
            for port in targets[host]:
                if stop():
                    return None
                if port not in blind and probe_host(host, port, PROBE_TIMEOUT):
                    return port
            return 0

        asked = {pool.submit(connect, host): host for host in silent}
        for done in as_completed(asked):
            if stop():
                return
            port = done.result()
            if port is not None:
                report(asked[done], bool(port), f"tcp/{port}" if port else "")
    finally:
        pool.shutdown(wait=False, cancel_futures=True)


def learn_mac(host: str) -> str:
    """The MAC from the ARP table after a successful connect, else ''."""
    return PLATFORM.mac_for_host(host)


@help_topic("wake-on-lan", "Wake-on-LAN", ("wol", "wake", "magic packet", "mac"),
            section="Connections")
def wake(mac: str, host: str = "", port: int = 9) -> None:
    """An offline machine with a known MAC can be woken from its row.

    The MAC is learned automatically from the ARP table on a successful
    connect and stored as `rcm-mac` in the .rdp. Waking sends the standard
    magic packet — 6×FF then the MAC sixteen times — as a UDP broadcast on
    port 9; no dependency, raw sockets suffice.
    """
    import socket
    raw = bytes.fromhex(mac.replace(":", "").replace("-", ""))
    if len(raw) != 6:
        raise ValueError(f"not a MAC address: {mac!r}")
    packet = b"\xff" * 6 + raw * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.sendto(packet, ("255.255.255.255", port))
    log_event("wake", mac=mac, host=host)


def set_connection_extra(c: Conn, key: str, value: str) -> None:
    """Upsert one rcm-* key in a connection's .rdp file."""
    lines = rdp_text(c.path).splitlines()
    prefix = f"{key}:s:"
    lines = [line for line in lines if not line.startswith(prefix)]
    if value:
        lines.append(f"{prefix}{value}")
    c.path.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------- #
# UI state (layout + pinned tabs) and config health
# --------------------------------------------------------------------------- #
@help_topic("layouts", "Window layouts", ("rail", "spotlight", "cockpit",
            "inspector", "classic", "layout menu"), section="The window")
def load_ui_state() -> dict:
    """The manager offers three window layouts.

    Browse (the default) is the everyday view: a filter-first flat list with a
    collapsible group sidebar, and live sessions appearing as a card strip only
    while any exist. Inspector is a read-only audit of credentials and
    configuration health. Classic is the original window, kept for continuity.

    The choice is saved as `layout =` in ui.conf and survives restarts, as do
    the pinned filter tabs and the sidebar toggle, shared by every layout.
    Older files naming rail, spotlight or cockpit are read as Browse.
    """
    state = {"layout": "browse", "tabs": [], "editor": "", "sidebar": True,
             "browse_view": "list", "dark": False}
    if not UI_CONF.is_file():
        return state
    parser = configparser.ConfigParser(inline_comment_prefixes=(";",))
    parser.optionxform = str
    parser.read(UI_CONF, encoding="utf-8")
    layout = parser.get("ui", "layout", fallback="browse").strip().lower()
    layout = LEGACY_LAYOUT_NAMES.get(layout, layout)
    state["layout"] = layout if layout in LAYOUTS else "browse"
    state["sidebar"] = parser.getboolean("ui", "sidebar", fallback=True)
    view = parser.get("ui", "browse_view", fallback="list").strip().lower()
    state["browse_view"] = view if view in ("list", "icons") else "list"
    try:
        state["dark"] = parser.getboolean("ui", "dark", fallback=False)
    except ValueError:
        state["dark"] = False
    if parser.has_section("tabs"):
        for _key, raw in sorted(parser.items("tabs")):
            parts = (raw.split("|") + ["", "", ""])[:3]
            if parts[0].strip():
                state["tabs"].append(tuple(part.strip() for part in parts))
    state["editor"] = parser.get("help", "editor", fallback="").strip()
    return state


def save_ui_state(state: dict) -> None:
    """Rewrite ui.conf. Header comments come from the documented default."""
    header, _, _ = DEFAULT_CONFIGS["ui.conf"].partition("[ui]")
    lines = [header.rstrip("\n"), "", "[ui]",
             f"layout = {state.get('layout', 'browse')}",
             f"sidebar = {'on' if state.get('sidebar', True) else 'off'}",
             f"browse_view = {state.get('browse_view', 'list')}",
             f"dark = {'on' if state.get('dark', False) else 'off'}",
             "", "[tabs]"]
    for index, (label, group, text) in enumerate(state.get("tabs", []), start=1):
        lines.append(f"tab.{index} = {label}|{group}|{text}")
    lines += ["", "[help]", f"editor = {state.get('editor', '')}"]
    UI_CONF.write_text("\n".join(lines) + "\n", encoding="utf-8")


@dataclass
class HealthWarning:
    """One actionable configuration problem, shown wherever health surfaces."""
    warning_id: str
    message: str          # human sentence, ready for the status bar
    setup_section: str    # which Setup card fixes it: protocols|credentials|shortcuts
    severity: str = "warning"   # "warning" | "error"


def connection_password_state(c: Conn, proto: str = "") -> tuple[str, str]:
    """Where a connection's password would come from: its credential fate.

    Returns (state, scope): state is "own" (a keyring entry for exactly this
    connection), "inherited" (found further up the chain — scope names the rung,
    e.g. "Plant" or "DEFAULT"), or "none" (nothing anywhere: connecting will
    prompt inside the client).
    """
    table = creds_conf_table()
    for key in creds_chain(c.sel, proto):
        entry = table.get(key)
        if secret_get(key) or (entry and entry[1] and entry[1] != "CHANGEME"):
            scope = key.split("@")[0]
            return ("own" if scope == c.sel else "inherited"), key
    return "none", ""


@help_topic("config-health", "Configuration health", ("warnings", "setup badge",
            "status bar", "broken config"), section="Setup")
def config_health() -> list[HealthWarning]:
    """Broken or incomplete configuration warns — it never blocks the window.

    Problems surface in four places, all fed by this one check: the status bar
    at the bottom of the manager, the badge on the Setup entry, the Inspector
    layout's per-row columns, and warning banners on the Setup page itself.

    Checked: protocols.conf parses; each protocol's exe exists when set; each
    protocol can detect its sessions (detect.process); every rcm-via points
    at a defined [via:*] gateway; a DEFAULT credential exists so unmatched
    connections have a password; and how many connections would prompt
    because nothing on their credential chain has one.
    """
    warnings: list[HealthWarning] = []
    try:
        registry = load_protocols()
    except ConfigError as broken:
        return [HealthWarning("protocols-broken", str(broken), "protocols", "error")]

    for proto in registry.values():
        if proto.exe and not Path(proto.exe).is_file():
            warnings.append(HealthWarning(
                f"exe-missing-{proto.id}",
                f"{proto.id}: exe not found — {proto.exe}", "protocols"))
        if not proto.detect_process:
            warnings.append(HealthWarning(
                f"no-detect-{proto.id}",
                f"{proto.id}: no detect.process — its sessions won't be seen",
                "protocols"))
        if not proto.launchers:
            warnings.append(HealthWarning(
                f"no-launchers-{proto.id}",
                f"{proto.id}: no launcher commands configured", "protocols"))

    try:
        vias = load_vias()
    except ConfigError as broken:
        vias = {}
        warnings.append(HealthWarning("vias-broken", str(broken), "protocols"))
    for c in conns_cached():
        wanted = (c.extra.get("rcm-via") or "").strip()
        if wanted and wanted not in vias:
            warnings.append(HealthWarning(
                f"via-missing-{c.sel}",
                f"{c.sel}: via {wanted!r} has no [via:{wanted}] section "
                "in protocols.conf", "protocols"))

    default_entry = creds_conf_table().get("DEFAULT")
    if not (secret_get("DEFAULT") or (default_entry and default_entry[1])):
        warnings.append(HealthWarning(
            "no-default-credential",
            "creds.conf: no DEFAULT entry — connections without a group password "
            "will prompt every time", "credentials"))

    unresolved = [c.sel for c in conns_cached()
                  if connection_password_state(c)[0] == "none"]
    if unresolved and len(unresolved) < len(conns_cached()):
        warnings.append(HealthWarning(
            "connections-without-password",
            f"{len(unresolved)} connection(s) have no password on their chain "
            "and will prompt", "credentials"))
    return warnings


# --------------------------------------------------------------------------- #
# window focus / shortcuts
# --------------------------------------------------------------------------- #
GUI_TITLE = "Remote Connections"
DCONF_ROOT = "/org/cinnamon/desktop/keybindings/custom-keybindings"
GS_LIST = "org.cinnamon.desktop.keybindings"
GS_ITEM = "org.cinnamon.desktop.keybindings.custom-keybinding"


def notify(msg: str) -> None:
    """Desktop notification -- shortcuts run detached, so stdout goes nowhere."""
    PLATFORM.notify(msg)


def gui_window() -> str:
    for w in xdotool("search", "--name", f"^{GUI_TITLE}$").splitlines():
        if w.strip():
            return w.strip()
    return ""


def focus_gui() -> str:
    """Raise the manager, starting it if it isn't running."""
    win = gui_window()
    if win:
        xdotool("windowactivate", "--sync", win)
        return "focused the manager"
    spawn_detached(self_argv() + ["gui"])
    return "starting the manager"


def self_argv() -> list[str]:
    """The command that runs rcm again: the .exe alone, or Python + this file."""
    if FROZEN:
        return [sys.executable]
    return [sys.executable, str(Path(__file__).resolve())]


def goto(sel: str) -> str:
    """Focus a connection's live session, or connect it if there isn't one."""
    c = find(sel)
    if not c:
        return f"no such connection: {sel}"
    for s in sessions():
        if s.label == sel and s.window:
            xdotool("windowactivate", "--sync", s.window)
            return f"focused {sel} ({s.proto})"
    proto = c.default_protocol
    try:
        return launch(c, proto)
    except RuntimeError as e:
        return f"{sel}: {e}"


def step_session(delta: int) -> str:
    """Focus the next/previous active session, relative to the focused window."""
    # Only windowed sessions can be focused. Including the others would park the
    # cycle on an entry it can never move off, so skip them entirely.
    ss = [s for s in sessions() if s.window]
    if not ss:
        return "no active sessions to focus"
    cur = xdotool("getwindowfocus")
    idx = next((i for i, s in enumerate(ss) if s.window == cur), None)
    if idx is None:
        # Nothing of ours focused: Super+W starts at the top, Super+Q at the end.
        idx = -1 if delta > 0 else 0
    nxt = ss[(idx + delta) % len(ss)]
    focus_session(nxt)
    return f"focused {nxt.label} ({nxt.proto})"


# "cycle" is deliberately not here any more: next/prev raise the switcher
# themselves, so a separate popup binding would just be a second way in.
GLOBAL_ACTIONS = (("focus", "Raise the manager"),
                  ("next", "Next active session"),
                  ("prev", "Previous active session"))

SWITCH_PIDFILE = Path.home() / ".cache" / "rcm-switcher.pid"


def switcher_pid() -> int:
    """Pid of a running switcher, or 0.

    Cinnamon's keybinding is a passive X grab that still fires while our popup
    holds its own grab, so a repeat press launches a *second* rcm. That process
    must drive the popup already on screen rather than exit -- otherwise the
    selection never moves, which is exactly how this failed the first time.
    """
    try:
        pid = int(SWITCH_PIDFILE.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return 0
    if pid == os.getpid():
        return 0
    try:
        os.kill(pid, 0)
    except OSError:
        return 0
    return pid


def session_bindings() -> dict[str, str]:
    """{connection sel: binding} -- for showing keys in the manager."""
    return {k: v for k, v in load_shortcuts()[1].items() if v}


def save_shortcuts(globals_: dict[str, str], per_session: dict[str, str]) -> None:
    """Rewrite shortcuts.conf. Managed file, so the header is regenerated too."""
    L = [
        "# System-wide keyboard shortcuts.",
        "#",
        "# Edited from the manager (menu -> Keyboard shortcuts...) or by hand.",
        "# Run `rcm shortcuts install` after editing by hand.",
        "#",
        "# Binding syntax is Cinnamon's: <Super> <Ctrl> <Alt> <Shift> plus a key,",
        "# e.g. <Super>r, <Super><Alt>1, <Super>grave.",
        "",
        "[global]",
    ]
    for key, desc in GLOBAL_ACTIONS:
        val = globals_.get(key, "").strip()
        L.append(f"# {desc}")
        L.append(f"{key} = {val}")
    L += ["", "[sessions]",
          "# Focuses the connection if a session is live, otherwise connects it.",
          "# `workspace:<name> = <combo>` opens that whole workspace instead."]
    for sel, binding in per_session.items():
        L.append(f"{sel} = {binding.strip()}")
    SHORTCUTS.write_text("\n".join(L) + "\n", encoding="utf-8")


def load_shortcuts() -> tuple[dict[str, str], dict[str, str]]:
    """(global_bindings, per_session_bindings) from shortcuts.conf."""
    # "=" only: the default parser also splits on ":", which would eat the
    # documented `workspace:<name> = <combo>` keys.
    cp = configparser.ConfigParser(delimiters=("=",))
    cp.optionxform = str  # connection names are case-sensitive
    if SHORTCUTS.is_file():
        cp.read(SHORTCUTS, encoding="utf-8")
    g = dict(cp.items("global")) if cp.has_section("global") else {}
    s = dict(cp.items("sessions")) if cp.has_section("sessions") else {}
    return g, s


def run_gsettings(*args: str) -> str:
    # Without gsettings (Windows, or a desktop lacking GLib's tools) every key
    # reads as empty: nothing of ours is installed and nothing conflicts.
    if not shutil.which("gsettings"):
        return ""
    return subprocess.run(["gsettings", *args], capture_output=True, text=True).stdout.strip()


def _binding_conflicts(binding: str) -> list[str]:
    """Existing Cinnamon bindings that already use this combo."""
    out = []
    for schema in ("org.cinnamon.desktop.keybindings.wm",
                   "org.cinnamon.desktop.keybindings.media-keys",
                   "org.cinnamon.muffin.keybindings"):
        for line in run_gsettings("list-recursively", schema).splitlines():
            if f"'{binding}'" in line:
                out.append(" ".join(line.split()[:2]))
    return out


def shortcut_specs() -> list[tuple[str, str, str, str]]:
    """(id, name, command, binding) for everything in shortcuts.conf."""
    me = str(Path(__file__).resolve())
    g, s = load_shortcuts()
    specs: list[tuple[str, str, str, str]] = []
    for action, desc in GLOBAL_ACTIONS:
        if g.get(action):
            specs.append((f"rcm-{action}", f"rcm: {desc.lower()}",
                          f"{me} {action}", g[action]))
    for sel, binding in s.items():
        if not binding:
            continue
        # `workspace:<name> = <combo>` opens a whole named set, as the
        # workspaces.conf comment has always promised.
        if sel.startswith("workspace:"):
            name = sel.split(":", 1)[1].strip()
            specs.append((f"rcm-workspace-{slugify(name)}",
                          f"rcm: workspace {name}",
                          f"{me} workspace {shlex.quote(name)}", binding))
            continue
        specs.append((f"rcm-goto-{slugify(sel)}", f"rcm: {sel}",
                      f"{me} goto {shlex.quote(sel)}", binding))
    return specs


def shortcuts_install() -> tuple[int, list[str]]:
    if not PLATFORM.system_shortcuts:
        raise PlatformError("system shortcuts are not available on "
                            f"{PLATFORM.name} yet -- the tray agent phase of "
                            "the port plan owns hotkeys there")
    specs = shortcut_specs()
    warnings = []
    for _id, _name, _cmd, binding in specs:
        for conflict in _binding_conflicts(binding):
            warnings.append(f"{binding} is already used by {conflict}")
    current = parse_gsettings_list(run_gsettings("get", GS_LIST, "custom-list"))
    keep = [i for i in current if not i.startswith("rcm-")]
    ids = [s[0] for s in specs]
    # Clear rcm- entries that are no longer configured, or removing a shortcut
    # would leave its Cinnamon binding live and still firing.
    for stale in [i for i in current if i.startswith("rcm-") and i not in ids]:
        subprocess.run(["dconf", "reset", "-f", f"{DCONF_ROOT}/{stale}/"],
                       capture_output=True)
    for _id, name, cmd, binding in specs:
        path = f"{DCONF_ROOT}/{_id}/"
        run_gsettings("set", f"{GS_ITEM}:{path}", "name", name)
        run_gsettings("set", f"{GS_ITEM}:{path}", "command", cmd)
        run_gsettings("set", f"{GS_ITEM}:{path}", "binding", "['" + binding + "']")
    run_gsettings("set", GS_LIST, "custom-list", str(keep + ids).replace('"', "'"))
    return len(specs), warnings


def shortcuts_remove() -> int:
    if not PLATFORM.system_shortcuts:
        return 0
    current = parse_gsettings_list(run_gsettings("get", GS_LIST, "custom-list"))
    mine = [i for i in current if i.startswith("rcm-")]
    for _id in mine:
        subprocess.run(["dconf", "reset", "-f", f"{DCONF_ROOT}/{_id}/"],
                       capture_output=True)
    keep = [i for i in current if not i.startswith("rcm-")]
    run_gsettings("set", GS_LIST, "custom-list", str(keep).replace('"', "'"))
    return len(mine)


def parse_gsettings_list(raw: str) -> list[str]:
    raw = raw.strip()
    if not raw or raw in ("@as []", "[]"):
        return []
    return [p.strip().strip("'\"") for p in raw.strip("[]").split(",") if p.strip()]


# --------------------------------------------------------------------------- #
# .desktop jump list
# --------------------------------------------------------------------------- #
ICON_NAME = "network-computing-hub"
ICON_SVG = BUNDLE / "assets" / f"{ICON_NAME}.svg"
ICON_SVG_SMALL = BUNDLE / "assets" / f"{ICON_NAME}-small.svg"
ICON_THEME_DIR = Path.home() / ".local/share/icons/hicolor"
# Below 48px the detailed icon turns to mush, so the simplified variant is used
# there -- that is exactly what per-size directories in an icon theme are for.
ICON_SMALL_UPTO = 32
ICON_SIZES = (16, 22, 24, 32, 48, 64, 128, 256)


def icon_installed() -> bool:
    return (ICON_THEME_DIR / "scalable/apps" / f"{ICON_NAME}.svg").is_file()


def install_icon() -> list[str]:
    """Install the app icon into the user's hicolor theme."""
    if not PLATFORM.desktop_files:
        raise PlatformError(f"hicolor icon themes do not exist on "
                            f"{PLATFORM.name}; the installer phase of the "
                            "port plan covers Windows shortcuts")
    if not ICON_SVG.is_file():
        raise RuntimeError(f"missing {ICON_SVG}")
    written = []
    scalable = ICON_THEME_DIR / "scalable/apps"
    scalable.mkdir(parents=True, exist_ok=True)
    shutil.copy2(ICON_SVG, scalable / f"{ICON_NAME}.svg")
    written.append(str(scalable / f"{ICON_NAME}.svg"))

    try:
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
    except Exception:
        return written  # SVG alone still works wherever librsvg is available

    for size in ICON_SIZES:
        src = ICON_SVG_SMALL if (size <= ICON_SMALL_UPTO
                                 and ICON_SVG_SMALL.is_file()) else ICON_SVG
        out = ICON_THEME_DIR / f"{size}x{size}/apps"
        out.mkdir(parents=True, exist_ok=True)
        dest = out / f"{ICON_NAME}.png"
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(src), size, size)
            pb.savev(str(dest), "png", [], [])
            written.append(str(dest))
        except Exception:
            continue
    subprocess.run(["gtk-update-icon-cache", "-f", "-t", str(ICON_THEME_DIR)],
                   capture_output=True)
    return written


def slugify(s: str) -> str:
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9-]", "-", s.lower())).strip("-")


def quote_exec_argument(s: str) -> str:
    """Quote one Exec= argument per the Desktop Entry spec.

    Connection names may contain spaces ("Line 1.rdp"); unquoted, the launcher
    splits them into separate arguments and the connection silently fails to open.
    desktop-file-validate does not flag this.
    """
    if not re.search(r"""[\s"'\\$`<>~|&;*?#()]""", s):
        return s
    esc = (s.replace("\\", "\\\\").replace('"', '\\"')
            .replace("`", "\\`").replace("$", "\\$"))
    return f'"{esc}"'


def gen_launcher() -> int:
    if not PLATFORM.desktop_files:
        return 0    # .desktop files are a freedesktop concept; nothing to do
    me = Path(__file__).resolve()
    # The .desktop is about to reference the icon by name, so make sure it exists.
    if not icon_installed():
        try:
            install_icon()
        except Exception:
            pass
    cs = conns_cached(refresh=True)
    gs = groups()   # every level, so a nested tree still gets jump-list entries
    actions = ([slugify(c.sel) for c in cs[:MAX_JUMPLIST]]
               + [f"all-{slugify(g)}" for g in gs] + ["switcher"])
    L = ["[Desktop Entry]", "Type=Application", "Name=Remote Connections",
         f"Comment=RDP, VNC and Radmin sessions from {RDP_DIR}",
         f"Exec={me} gui", f"Icon={ICON_NAME}", "Terminal=false",
         "Categories=Network;RemoteAccess;", "StartupNotify=false",
         # Without this the panel cannot match a running window (WM_CLASS "rcm")
         # to this launcher, and shows a generic icon for it instead.
         "StartupWMClass=rcm"]
    # An empty "Actions=;" is a validation error, so omit it when nothing is listed.
    if actions:
        L.append("Actions=" + ";".join(actions) + ";")
    for c in cs[:MAX_JUMPLIST]:
        L += ["", f"[Desktop Action {slugify(c.sel)}]",
              f"Name={c.sel.replace('_', ' ').replace('/', ' / ')}",
              # Absolute paths only -- Exec= does not expand ~ and fails silently.
              f"Exec={quote_exec_argument(str(me))} connect {quote_exec_argument(c.sel)}"]
    for g in gs:
        L += ["", f"[Desktop Action all-{slugify(g)}]", f"Name=Connect all ({g})",
              f"Exec={quote_exec_argument(str(me))} connect-all {quote_exec_argument(g)}"]
    L += ["", "[Desktop Action switcher]", "Name=Switch active session...",
          f"Exec={me} cycle"]
    DESKTOP_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = DESKTOP_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(L) + "\n", encoding="utf-8")
    tmp.chmod(0o644)
    tmp.replace(DESKTOP_FILE)
    subprocess.run(["update-desktop-database", str(DESKTOP_FILE.parent)],
                   capture_output=True)
    return len(cs)


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
USAGE = """rcm -- remote connection manager

  rcm init                       write any missing config file from its default
  rcm list                       list connections
  rcm sessions                   show active sessions (RDP / VNC / Radmin)
  rcm connect <sel> [--<protocol>] [--via <launcher>]
  rcm connect-all <group> [--<protocol>] [--via <launcher>]
  rcm protocols                  show configured protocols and their programs
  rcm detect <protocol> [--write]    find a protocol's exe and record it
  rcm creds list|set|clear|migrate   credentials (passwords live in the keyring)
  rcm gui                        open the manager window
  rcm focus                      raise the manager (starts it if needed)
  rcm cycle                      Alt-Tab-style switcher over active sessions
  rcm next | rcm prev            focus the next/previous active session
  rcm goto <sel>                 focus that session, or connect it if it isn't up
  rcm shortcuts list|install|remove   system-wide keys, from shortcuts.conf
  rcm calibrate <sel> [proto]    open a credential prompt, report it, type nothing
  rcm import <file.csv> [--overwrite] [--dry-run]
  rcm export [file.csv]          default: export/connections.csv
  rcm phonebook [out.rpb]        experimental Radmin phonebook (never overwrites live)
  rcm backup <sel>... [--dry-run]    archive folders on the PCs, per backups.conf
  rcm workspace [name]           open a named set of connections\n  rcm wake <sel>                 send a Wake-on-LAN magic packet\n  rcm history [sel]              recent events from the JSONL log\n  rcm gen-launcher               rebuild the .desktop jump list
  rcm install-icon               install the app icon into your icon theme
"""


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    cmd, rest = argv[0], argv[1:]

    # Report, don't write: the CLI should not create files behind your back. The
    # GUI does write them, because that is a deliberate first-run setup step.
    if cmd not in ("init", "gui"):
        gone = missing_configs()
        if gone:
            print(f"rcm: missing config: {', '.join(gone)}\n"
                  f"     create them with `rcm init` (or open the manager once)",
                  file=sys.stderr)

    if cmd == "init":
        written = write_default_configs()
        for name in written:
            print(f"  created {APP / name}")
        print(f"{len(written)} file(s) created" if written else "nothing missing")
        return 0

    if cmd == "list":
        for c in conns_cached():
            print(f"{c.sel:24} {c.host:16} {c.username or '-':12} :{c.port}")
        return 0

    if cmd == "sessions":
        ss = sessions()
        if not ss:
            print("no active sessions")
        for s in ss:
            print(f"{s.proto:7} {s.label:22} {s.host:16} pid={s.pid} win={s.window or '-'}")
        return 0

    if cmd in ("connect", "connect-all"):
        # Any configured protocol is a flag: --rdp, --vnc, --radmin, --anydesk...
        ids = protocol_ids()
        proto = ids[0] if ids else ""
        for pid in ids:
            if f"--{pid}" in rest:
                proto = pid
                rest = [a for a in rest if a != f"--{pid}"]
        via = ""
        if "--via" in rest:
            i = rest.index("--via")
            if i + 1 >= len(rest):
                print("--via needs a launcher name", file=sys.stderr)
                return 2
            via = rest[i + 1]
            rest = rest[:i] + rest[i + 2:]
        if not rest:
            flags = "|".join(f"--{i}" for i in ids) or "--<protocol>"
            print(f"usage: rcm {cmd} <{'group' if cmd=='connect-all' else 'group/name'}>"
                  f" [{flags}] [--via <launcher>]", file=sys.stderr)
            return 2

        if cmd == "connect":
            c = find(rest[0])
            if not c:
                print(f"no such connection: {rest[0]}", file=sys.stderr)
                return 1
            targets = [c]
        else:
            targets = group_members(rest[0])
            if not targets:
                print(f"group '{rest[0]}' has no connections", file=sys.stderr)
                return 1

        rc = 0
        for i, c in enumerate(targets):
            if i:
                time.sleep(2)
            try:
                msg = launch(c, proto, via)
                if msg:
                    print(msg)
            except RuntimeError as e:
                print(f"rcm: {e}", file=sys.stderr)
                rc = 1
        return rc

    if cmd in ("protocols", "launchers"):
        try:
            protos = load_protocols()
        except ConfigError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        for p in protos.values():
            bits = [f"port {p.port}" if p.port else "", f"colour {p.color}",
                    "types credentials" if p.injects else ""]
            print(f"[{p.id}] {p.label}  ({', '.join(b for b in bits if b)})")
            if p.exe:
                mark = "" if Path(p.exe).is_file() else "   <-- does not exist"
                print(f"    exe {p.exe}{mark}")
            for nm, tmpl in p.launchers.items():
                star = "*" if nm == p.default else " "
                exe0 = launcher_exe(p, tmpl)
                have = "" if (exe0 and (shutil.which(exe0) or Path(exe0).is_file())) \
                    else "   (not installed)"
                print(f"  {star} {nm:12} {tmpl}{have}")
        return 0

    if cmd == "detect":
        if not rest:
            print("usage: rcm detect <protocol> [--write]", file=sys.stderr)
            return 2
        try:
            p = protocol(rest[0])
        except ConfigError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        found = protocol_detect(p)
        if not found:
            print(f"no {Path(p.exe).name if p.exe else p.id} found", file=sys.stderr)
            return 1
        print(f"{p.label} installs found, best first:")
        for i, f in enumerate(found):
            print(f"  [{i}] {f}")
        if "--write" not in rest:
            print(f"\nre-run with --write to put [0] into {PROTOCOLS_FILE}")
            return 0
        protos = load_protocols()
        protos[p.id].exe = str(found[0])
        parts = found[0].parts
        if "drive_c" in parts:
            protos[p.id].env["WINEPREFIX"] = str(Path(*parts[:parts.index("drive_c")]))
        save_protocols(protos)
        print(f"\nwrote exe={found[0]} to {PROTOCOLS_FILE}")
        return 0

    if cmd == "creds":
        sub = rest[0] if rest else "list"
        if sub == "list":
            print(f"keyring: {'available' if keyring_available() else 'NOT AVAILABLE'}")
            table = creds_conf_table()
            keys = sorted(set(table) | {"DEFAULT"})
            for k in keys:
                u = table.get(k, ("", ""))[0]
                legacy = table.get(k, ("", ""))[1]
                where = ("keyring" if secret_get(k) else
                         "PLAINTEXT in creds.conf" if legacy else "not set")
                print(f"  {k:16} user={u or '(from .rdp)':14} password: {where}")
            return 0
        if sub == "set":
            if len(rest) < 2:
                print("usage: rcm creds set <key>", file=sys.stderr)
                return 2
            if not keyring_available():
                print("rcm: no keyring available", file=sys.stderr)
                return 1
            if not PLATFORM.console_attached():
                print("rcm: creds set prompts for the password and this "
                      "program has no console -- use rcm.exe, or the "
                      "manager's Credentials page", file=sys.stderr)
                return 2
            pw = getpass.getpass(f"password for {rest[1]} (not echoed): ")
            if not pw:
                print("aborted, nothing stored")
                return 1
            print("stored in keyring" if secret_set(rest[1], pw) else "store failed")
            return 0
        if sub == "clear":
            if len(rest) < 2:
                print("usage: rcm creds clear <key>", file=sys.stderr)
                return 2
            print("cleared" if secret_clear(rest[1]) else "nothing to clear")
            return 0
        if sub == "migrate":
            try:
                moved, skipped = creds_migrate()
            except RuntimeError as e:
                print(f"rcm: {e}", file=sys.stderr)
                return 1
            print(f"{moved} password(s) moved into the keyring, {skipped} left alone")
            if moved:
                print(f"{CREDS} now holds only key|username -- no secrets")
            return 0
        print(f"unknown creds subcommand: {sub}", file=sys.stderr)
        return 2

    if cmd == "import":
        if not rest:
            print("usage: rcm import <file.csv> [--overwrite] [--dry-run]", file=sys.stderr)
            return 2
        created, skipped = import_csv(Path(rest[0]).expanduser(),
                                      overwrite="--overwrite" in rest,
                                      dry_run="--dry-run" in rest)
        for line in created:
            print("  +", line)
        for line in skipped:
            print("  -", line)
        print(f"{len(created)} created, {len(skipped)} skipped")
        if created and "--dry-run" not in rest:
            gen_launcher()
        return 0

    if cmd == "export":
        dest = Path(rest[0]).expanduser() if rest else EXPORT_DIR / "connections.csv"
        n = export_csv(dest)
        print(f"{n} connection(s) -> {dest}")
        return 0

    if cmd == "phonebook":
        dest = Path(rest[0]).expanduser() if rest else EXPORT_DIR / "radmin.rpb"
        try:
            n = export_phonebook(dest)
        except RuntimeError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        print(f"{n} record(s) -> {dest}")
        print("EXPERIMENTAL. Test without touching your real phonebook:")
        try:
            p = protocol("radmin")
            env = " ".join(f'{k}="{v}"' for k, v in p.env.items())
            print(f'  {env} "{p.exe}" /pbpath:"{dest}"'.strip())
        except ConfigError:
            print(f'  <radmin exe> /pbpath:"{dest}"')
        return 0

    if cmd == "calibrate":
        # Opens a protocol's credential prompt, reports exactly what it is, and
        # types nothing. Use it when writing inject.steps for a new protocol.
        if not rest:
            print("usage: rcm calibrate <group/name> [protocol]", file=sys.stderr)
            return 2
        c = find(rest[0])
        if not c:
            print(f"no such connection: {rest[0]}", file=sys.stderr)
            return 1
        try:
            pid = rest[1] if len(rest) > 1 else next(
                (q.id for q in load_protocols().values() if q.injects), "")
            if not pid:
                print("rcm: no protocol defines inject.steps", file=sys.stderr)
                return 1
            p = protocol(pid)
            argv = build_argv(c, p.id)
        except (ConfigError, RuntimeError) as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        user, pw = creds_lookup(c.sel, c.username, proto=p.id)
        # Never interpolate the password: "${pw:-X}" style masking prints the value.
        print(f"protocol={p.label} host={c.host} user={user} password: "
              f"{'set (%d chars)' % len(pw) if pw and pw != 'CHANGEME' else 'NOT SET'}")
        try:
            _, new = open_credential_prompt(p, c.host, argv)
        except RuntimeError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        for w in sorted(new):
            print(f"--- window {w}")
            print(f"  name    : {xdotool('getwindowname', w)}")
            print(f"  geometry: {xdotool('getwindowgeometry', '--shell', w).replace(chr(10), ' ')}")
        foc = xdotool("getwindowfocus")
        print(f"focused   : {foc} ({xdotool('getwindowname', foc)})")
        shot = capture_window(sorted(new)[-1], Path.home() / "radmin-calibrate.png")
        print(f"image     : {shot}" if shot else
              "image     : skipped (needs gnome-screenshot + python3-pil)")
        print("\nDialog left open, nothing typed. The image shows which field holds "
              "the caret\nand whether the username is prefilled -- that is what sets "
              "inject_order.")
        return 0

    if cmd == "install-icon":
        try:
            written = install_icon()
        except RuntimeError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        print(f"{len(written)} file(s) installed under {ICON_THEME_DIR}")
        print(f"  .desktop and windows can now use Icon={ICON_NAME}")
        return 0

    if cmd == "gen-launcher":
        if not PLATFORM.desktop_files:
            raise PlatformError(f".desktop jump lists do not exist on "
                                f"{PLATFORM.name}; nothing written")
        print(f"{gen_launcher()} connection(s) -> {DESKTOP_FILE}")
        return 0

    if cmd == "workspace":
        spaces = load_workspaces()
        if not rest or rest[0] == "list":
            for name, members in spaces.items():
                print(f"  {name}: {', '.join(m['sel'] for m in members)}")
            if not spaces:
                print(f"  none defined — add [workspace:<name>] sections to "
                      f"{WORKSPACES_CONF}")
            return 0
        try:
            for line in connect_workspace(rest[0]):
                print(f"  {line}")
        except ConfigError as problem:
            print(f"rcm: {problem}", file=sys.stderr)
            return 1
        return 0

    if cmd == "wake":
        if not rest:
            print("usage: rcm wake <group/name>", file=sys.stderr)
            return 2
        c = find(rest[0])
        if not c:
            print(f"no such connection: {rest[0]}", file=sys.stderr)
            return 1
        mac = c.extra.get("rcm-mac", "")
        if not mac:
            print(f"{c.sel}: no rcm-mac recorded yet — connect once while it is "
                  "on, the MAC is learned automatically", file=sys.stderr)
            return 1
        wake(mac, host=c.host)
        print(f"magic packet sent to {mac} ({c.sel})")
        return 0

    if cmd == "backup":
        dry = "--dry-run" in rest
        names = [a for a in rest if a != "--dry-run"]
        if not names:
            print("usage: rcm backup <connection or group>... [--dry-run]",
                  file=sys.stderr)
            return 2
        targets: list[Conn] = []
        for name in names:
            found = find(name)
            members = [found] if found else group_members(name)
            if not members:
                print(f"no such connection or group: {name}", file=sys.stderr)
                return 1
            targets += [m for m in members if m not in targets]
        try:
            settings = load_backup_settings()
        except ConfigError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        stamp = time.strftime(BACKUP_STAMP)
        tty = sys.stdout.isatty()

        def show(text: str) -> None:
            # A terminal gets one line rewritten in place; a log (Task
            # Scheduler) gets the steps without the every-2-s progress.
            if tty:
                print("\r    " + text.ljust(72), end="", flush=True)
            elif not text.startswith("compressing"):
                print("    " + text, flush=True)

        failed = 0
        for c in targets:
            print(f"--- {c.sel} ({c.host})", flush=True)
            try:
                r = backup_one(c, settings, stamp, dry_run=dry, progress=show)
            except ConfigError as e:
                print(f"\nrcm: {e}", file=sys.stderr)
                return 1
            if tty:
                print("\r" + " " * 76 + "\r", end="")
            verdict = "skipped" if r.idle else "ok" if r.ok else "FAILED"
            print(f"    {verdict}: {r.message}")
            if r.archive:
                print(f"    -> {r.archive}")
            if dry and r.skipped_largest:
                print("    left out by skip (largest first):")
                for size, path in r.skipped_largest[:20]:
                    print(f"      {human_size(size):>9}  {path}")
            if dry and r.largest:
                print("    largest files kept:")
                for size, path in r.largest:
                    print(f"      {human_size(size):>9}  {path}")
            failed += not r.ok
        if not dry:
            for day in prune_backups(settings):
                print(f"removed {day} (older than {settings.keep_days} days)")
        return 1 if failed else 0

    if cmd == "history":
        sel = rest[0] if rest else ""
        for record in read_log_events(days=30, sel=sel)[:200]:
            extras = {k: v for k, v in record.items() if k not in ("ts", "kind")}
            print(f"  {record['ts']}  {record['kind']:8} "
                  + " ".join(f"{k}={v}" for k, v in extras.items()))
        return 0

    if cmd == "health":
        problems = config_health()
        if not problems:
            print("configuration healthy — no warnings")
            return 0
        for w in problems:
            print(f"  {'ERROR ' if w.severity == 'error' else 'warn  '}{w.message}")
            print(f"         fix under Setup ▸ {w.setup_section}")
        return 1

    if cmd == "help":
        # Topics register at import time, so the guide is only complete once
        # every registering module is loaded; headless (no display) skips the
        # GUI's topics rather than failing.
        sys.modules.setdefault("rcm", sys.modules["__main__"])
        for module_name in ("rcm_gui", "rcm_switch"):
            try:
                __import__(module_name)
            except Exception:
                pass
        if "--coverage" in rest:
            # The mandate check: user-facing commands must carry a topic.
            documented = {t.source_file for t in HELP_TOPICS.values()}
            print(f"{len(HELP_TOPICS)} topic(s) registered across "
                  f"{len(documented)} file(s)")
            for topic in HELP_TOPICS.values():
                print(f"  {topic.topic_id:20} {topic.source_file}:{topic.source_line}")
            return 0
        if "--dump" in rest:
            count = dump_help_html()
            print(f"{count} topic(s) -> {HELP_DIR}/index.html")
            return 0
        if not HELP_TOPICS:
            print("no help topics registered")
            return 0
        by_section: dict[str, list] = {}
        for t in HELP_TOPICS.values():
            by_section.setdefault(t.section or "General", []).append(t)
        for section, topics in by_section.items():
            print(f"[{section}]")
            for t in topics:
                print(f"  {t.topic_id:20} {t.title:32} {t.source_file}:{t.source_line}")
        return 0

    if cmd == "focus":
        msg = focus_gui()
        print(msg)
        return 0

    if cmd == "goto":
        if not rest:
            print("usage: rcm goto <group/name>", file=sys.stderr)
            return 2
        msg = goto(rest[0])
        print(msg)
        # Bound to a hotkey, so nothing is watching stdout.
        if msg.startswith("no such") or ": " in msg and "focused" not in msg:
            notify(msg)
        return 0

    if cmd in ("next", "prev", "cycle"):
        if not PLATFORM.window_control:
            raise PlatformError(f"the session switcher is not available on "
                                f"{PLATFORM.name} yet -- it needs the window "
                                "control the tray agent phase brings")
        delta = -1 if cmd == "prev" else 1
        # A switcher is already on screen: tell it to move and get out of the way.
        pid = switcher_pid()
        if pid:
            try:
                os.kill(pid, signal.SIGUSR1 if delta > 0 else signal.SIGUSR2)
            except OSError:
                pass
            return 0
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        sys.modules.setdefault("rcm", sys.modules["__main__"])
        import rcm_switch
        return rcm_switch.run(delta)

    if cmd == "shortcuts":
        sub = rest[0] if rest else "list"
        if sub == "list":
            specs = shortcut_specs()
            active = parse_gsettings_list(run_gsettings("get", GS_LIST, "custom-list"))
            if not specs:
                print("nothing configured in", SHORTCUTS)
            if not PLATFORM.system_shortcuts:
                print(f"  (system shortcuts are not available on {PLATFORM.name} "
                      "yet; these stay unregistered)")
            for _id, name, cmdline, binding in specs:
                state = "installed" if _id in active else "not installed"
                print(f"  {binding:22} {name:28} [{state}]")
                for conflict in _binding_conflicts(binding):
                    print(f"      conflict: also bound to {conflict}")
            return 0
        if sub == "install":
            try:
                n, warnings = shortcuts_install()
            except PlatformError as e:
                print(f"rcm: {e}", file=sys.stderr)
                return 1
            for w in warnings:
                print(f"  warning: {w}")
            print(f"{n} shortcut(s) registered with Cinnamon")
            print(f"remove them again with: {Path(__file__).resolve()} shortcuts remove")
            return 0
        if sub == "remove":
            print(f"{shortcuts_remove()} shortcut(s) removed")
            return 0
        print(f"unknown shortcuts subcommand: {sub}", file=sys.stderr)
        return 2

    if cmd == "gui":
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        # This file has no .py suffix, so "import rcm" cannot find it. Publish the
        # already-loaded __main__ under that name so the GUI shares this module
        # (and its caches) instead of loading a second copy.
        sys.modules.setdefault("rcm", sys.modules["__main__"])
        try:
            import rcm_gui
        except ImportError as e:
            if e.name != "gi":
                raise
            print(f"rcm: the manager needs PyGObject (GTK 3), which this Python "
                  f"({sys.executable}) does not have", file=sys.stderr)
            return 1
        return rcm_gui.run()

    print(f"unknown command: {cmd}\n\n{USAGE}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    # Windows encodes a redirected or piped stdout in the ANSI code page, where
    # a connection named in Cyrillic cannot be written at all and `rcm list`
    # dies mid-listing. UTF-8 is Python's own default from 3.15 (PEP 686).
    for stream in (sys.stdout, sys.stderr):
        if stream and stream.encoding.lower().replace("-", "") != "utf8":
            stream.reconfigure(encoding="utf-8")
    # NetworkComputingHub.exe is windowed: double-clicking it means "open the
    # manager", and a window is the only place it has to say anything. Its
    # console twin rcm.exe, like bin/rcm, prints the usage instead.
    windowed = FROZEN and not PLATFORM.console_attached()
    args = sys.argv[1:] or (["gui"] if windowed else [])
    # Anything a port phase has not reached yet says so in one line, rather
    # than as a traceback ending in the same sentence.
    try:
        sys.exit(main(args))
    except PlatformError as e:
        print(f"rcm: {e}", file=sys.stderr)
        sys.exit(1)
