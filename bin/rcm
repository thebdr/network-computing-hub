#!/usr/bin/env python3
"""rcm -- remote connection manager.

Keeps connections in one place and launches them with whatever external client
you configure; credentials live in the OS keyring, not on disk.

Everything lives under one directory:

    bin/            these scripts
    RDP/GROUP/      the .rdp files -- source of truth for host + username
    templates/      default.rdp, used to generate connections on import
    export/         generated CSV / phonebook output
    launchers.conf  which program connects each protocol, plus [radmin]
    creds.conf      scope -> username only; passwords are in the keyring
    shortcuts.conf  system-wide keys

Config is never guessed: a missing or wrong value raises ConfigError naming the
file and the key, rather than silently falling back to a built-in.

A group folder renamed with a leading dot (Plant -> .Plant) disappears everywhere.
"""
from __future__ import annotations

import configparser
import csv
import getpass
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

# This script has no .py suffix, so sibling modules need the directory on the
# path; rcm_gui/rcm_switch are imported the same way further down.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from rcm_help import HELP_TOPICS, help_topic, register_topic  # noqa: E402
from rcm_platform import PLATFORM, PlatformError, run_child  # noqa: E402

# The Windows .exe (PyInstaller) runs this file from its runtime\ folder, where
# __file__'s grandparent is whatever folder the .exe was copied into. Its data
# -- RDP/, the .conf files, logs/ -- lives beside the .exe, the same
# one-directory layout a clone has; only the read-only resources it ships
# (icons, the default template) are read from the bundle.
FROZEN = bool(getattr(sys, "frozen", False))
APP = (Path(sys.executable).resolve().parent if FROZEN
       else Path(__file__).resolve().parent.parent)
BUNDLE = Path(getattr(sys, "_MEIPASS", APP))
RDP_DIR = APP / "RDP"
TEMPLATE = APP / "templates" / "default.rdp"
EXPORT_DIR = APP / "export"
CREDS = APP / "creds.conf"
PROTOCOLS_FILE = APP / "protocols.conf"
LEGACY_LAUNCHERS = APP / "protocols.conf"
SHORTCUTS = APP / "shortcuts.conf"
UI_CONF = APP / "ui.conf"
WORKSPACES_CONF = APP / "workspaces.conf"
BACKUPS_CONF = APP / "backups.conf"
LOGS_DIR = APP / "logs"

# Window layouts a user can switch between. Browse absorbed the three flat
# variants of the original design (rail / spotlight / cockpit): they were one
# layout differing only in sidebar, filter emphasis and where live sessions
# rendered, so those became toggles inside Browse instead of modes beside it.
LAYOUTS = ("browse", "inspector", "classic")
LEGACY_LAYOUT_NAMES = {"rail": "browse", "spotlight": "browse",
                       "cockpit": "browse"}
LEGACY_CREDS = Path.home() / ".config" / "radmin" / "creds.conf"

DESKTOP_FILE = Path.home() / ".local/share/applications/rdp-menu.desktop"
MAX_JUMPLIST = 10


# --------------------------------------------------------------------------- #
# model
# --------------------------------------------------------------------------- #
@dataclass
class Conn:
    group: str
    name: str
    path: Path
    host: str = ""
    username: str = ""
    port: int = 3389
    extra: dict = field(default_factory=dict)

    @property
    def sel(self) -> str:
        return f"{self.group}/{self.name}" if self.group else self.name

    @property
    def protocols(self) -> tuple[str, ...]:
        """Which protocols this host offers. Absent key means "all of them"."""
        known = protocol_ids()
        raw = (self.extra.get("rcm-protocols") or "").strip()
        if not raw:
            return known
        want = [p.strip().lower() for p in raw.split(",") if p.strip()]
        return tuple(p for p in known if p in want) or known

    @property
    def tags(self) -> tuple[str, ...]:
        """Free labels orthogonal to groups, stored as rcm-tags in the .rdp.

        The same host may legitimately exist twice on different LANs, so tags
        never deduplicate; they only filter.
        """
        raw = (self.extra.get("rcm-tags") or "").strip()
        return tuple(t.strip() for t in raw.split(",") if t.strip())

    @property
    def default_protocol(self) -> str:
        """Which protocol a double-click uses. Falls back to the first enabled."""
        want = (self.extra.get("rcm-default-proto") or "").strip().lower()
        enabled = self.protocols
        if want and want in enabled:
            return want
        return enabled[0] if enabled else ""

    def port_for(self, proto) -> int:
        """Per-connection port for a protocol, else the protocol's default.

        RDP keeps using the .rdp file's own `server port`; anything else is
        stored as rcm-port-<id>, so a new protocol needs no code change.
        """
        pid = proto if isinstance(proto, str) else proto.id
        if pid == "rdp":
            return self.port
        raw = self.extra.get(f"rcm-port-{pid}")
        if raw:
            try:
                return int(raw)
            except ValueError:
                pass
        if not isinstance(proto, str):
            return proto.port or self.port
        try:
            return protocol(pid).port or self.port
        except ConfigError:
            return self.port


def rdp_text(path: Path, errors: str = "strict") -> str:
    """An .rdp file's text. mstsc saves UTF-16 with a BOM; ours are UTF-8.

    Newlines are normalised the way read_text() would, so a CRLF file written
    back in text mode on Windows stays CRLF instead of becoming CR CR LF.
    """
    raw = path.read_bytes()
    if raw[:2] in (b"\xff\xfe", b"\xfe\xff"):
        text = raw.decode("utf-16", errors=errors)
    else:
        text = raw.decode("utf-8-sig", errors=errors)
    return text.replace("\r\n", "\n").replace("\r", "\n")


def parse_rdp(path: Path) -> dict:
    out = {}
    for line in rdp_text(path, errors="replace").splitlines():
        m = re.match(r"^([^:]+):([sib]):(.*)$", line)
        if m:
            out[m.group(1)] = m.group(3).strip("\r")
    return out


def scan() -> list[Conn]:
    """All connections, skipping dot-prefixed groups."""
    conns: list[Conn] = []
    if not RDP_DIR.is_dir():
        return conns
    for p in sorted(RDP_DIR.rglob("*.rdp")):
        rel = p.relative_to(RDP_DIR)
        # Any dot-prefixed path component hides the connection.
        if any(part.startswith(".") for part in rel.parts):
            continue
        f = parse_rdp(p)
        conns.append(Conn(
            # Full relative parent path, so groups can nest arbitrarily:
            # RDP/Plant/Line1/Host.rdp -> group "Plant/Line1".
            group="/".join(rel.parts[:-1]),
            name=p.stem,
            path=p,
            host=f.get("full address", ""),
            username=f.get("username", ""),
            port=int(f.get("server port") or 3389),
            extra=f,
        ))
    return conns


def groups() -> list[str]:
    """Every group path, including intermediate levels of a nested tree."""
    out: set[str] = set()
    for c in conns_cached():
        parts = c.group.split("/") if c.group else []
        for i in range(1, len(parts) + 1):
            out.add("/".join(parts[:i]))
    return sorted(out)


def group_members(group: str) -> list[Conn]:
    """Connections in a group, including everything in its sub-groups."""
    return [c for c in conns_cached()
            if c.group == group or c.group.startswith(group + "/")]


_cache: list[Conn] | None = None


def conns_cached(refresh: bool = False) -> list[Conn]:
    global _cache
    if _cache is None or refresh:
        _cache = scan()
    return _cache


def find(sel: str) -> Conn | None:
    for c in conns_cached():
        if c.sel == sel:
            return c
    return None


# --------------------------------------------------------------------------- #
# filter queries
# --------------------------------------------------------------------------- #
QUERY_FIELDS = ("group", "name", "host", "user", "tag")
QUERY_OPERATORS = ("and", "or", "not")
# A key is a '#' at the start of the text or after whitespace; a '#' anywhere
# else (a#b) belongs to the regex around it.
_QUERY_KEY = re.compile(r"(?:^|(?<=\s))#(\w*)")


@dataclass
class QueryTerm:
    field: str              # one of QUERY_FIELDS, or "" for every field
    pattern: re.Pattern
    negated: bool = False

    def values(self, c: Conn) -> list[str]:
        if self.field == "group":
            return [c.group]
        if self.field == "name":
            return [c.name]
        if self.field == "host":
            return [c.host]
        if self.field == "user":
            return [c.username]
        if self.field == "tag":
            return list(c.tags)
        return [c.sel, c.host, c.username, *c.tags]

    def holds(self, c: Conn) -> bool:
        found = any(self.pattern.search(v) for v in self.values(c))
        return found != self.negated


@dataclass
class Query:
    """A parsed filter: OR of AND-groups of terms. No groups matches all."""
    groups: list[list[QueryTerm]] = field(default_factory=list)
    problems: list[str] = field(default_factory=list)
    impossible: bool = False     # an unknown key: nothing can match

    def matches(self, c: Conn) -> bool:
        if self.impossible:
            return False
        if not self.groups:
            return True
        return any(all(term.holds(c) for term in group) for group in self.groups)

    def patterns_for(self, field_name: str) -> list[re.Pattern]:
        """What to highlight in one field: its own terms and the free ones."""
        return [t.pattern for group in self.groups for t in group
                if not t.negated and t.field in (field_name, "")]


def _query_pattern(text: str, problems: list[str]) -> re.Pattern:
    try:
        return re.compile(text, re.IGNORECASE)
    except re.error as e:
        problems.append(f"{text!r} is not a regex ({e}) -- matched as plain text")
        return re.compile(re.escape(text), re.IGNORECASE)


@help_topic("filter-syntax", "Filter syntax",
            ("filter", "search", "query", "regex", "#name", "#host", "#and",
             "#or", "#not"), section="Connections")
def parse_query(text: str) -> Query:
    """The filter box takes text, or keys each followed by a regex.

    Plain text is a regex tried against every field -- the group/name path,
    host, user and tags -- so a word still finds what contains it. Keys pick
    one field: #group #name #host #user #tag (#tag tries each tag on its
    own). A key starts with # at the start or after a space, ends at the next
    space, and its regex runs up to the next " #" or the end. Matching
    ignores case and finds the regex anywhere in the value: use ^ and $ to
    pin it. Spaces around a regex are dropped; inside one they count.

    Terms side by side must all hold. #or separates alternatives, and binds
    looser than #and: "a #or b #and c" is a, or both b and c. #not negates
    the term after it; text straight after #not, #and or #or is a term over
    every field.

      #group trib #name sorter      sorters in TRIB
      #name sorter #not maint       sorters, without the maintenance ones
      #host \\.1[0-3]$ #or #tag plc  four hosts, or anything tagged plc
      #user ^$                      connections with no username set

    Half-typed input never empties the list: a key with no regex yet, a
    partial key at the end, or a trailing operator adds nothing. A regex
    that does not compile is matched as plain text, and an unknown key
    matches nothing; the status bar says which.
    """
    query = Query()
    text = text.strip()
    if not text:
        return query
    keys = list(_QUERY_KEY.finditer(text))
    pieces: list[tuple[str | None, str]] = []      # (key or None, regex)
    head = text[:keys[0].start()] if keys else text
    if head.strip():
        pieces.append((None, head.strip()))
    for i, m in enumerate(keys):
        end = keys[i + 1].start() if i + 1 < len(keys) else len(text)
        pieces.append((m.group(1).lower(), text[m.end():end].strip()))

    groups: list[list[QueryTerm]] = [[]]
    negate = False
    for n, (key, regex) in enumerate(pieces):
        if key is not None and key not in QUERY_FIELDS + QUERY_OPERATORS:
            last = n == len(pieces) - 1
            if last and not regex and any(k.startswith(key)
                                          for k in QUERY_FIELDS + QUERY_OPERATORS):
                continue                      # still typing it
            query.problems.append(
                f"unknown key #{key} -- the keys are "
                + " ".join("#" + k for k in QUERY_FIELDS + QUERY_OPERATORS))
            query.impossible = True
            continue
        if key == "or":
            if groups[-1]:
                groups.append([])
        elif key == "not":
            negate = not negate
        field_name = key if key in QUERY_FIELDS else ""
        if not regex:
            continue                          # a key with nothing after it yet
        groups[-1].append(QueryTerm(field_name,
                                    _query_pattern(regex, query.problems),
                                    negate))
        negate = False
    query.groups = [g for g in groups if g]
    return query


# --------------------------------------------------------------------------- #
# credentials
# --------------------------------------------------------------------------- #
def creds_path() -> Path | None:
    for p in (CREDS, LEGACY_CREDS):
        if p.is_file():
            return p
    return None


# Passwords live in the login keyring (libsecret), encrypted at rest and unlocked
# with the session. creds.conf keeps only "key|username" -- no secret material.
# A third field there is still honoured so pre-keyring files keep working.
# Storage itself is the platform's: libsecret here, Credential Locker on
# Windows -- rcm_platform owns the difference.


def keyring_available() -> bool:
    return PLATFORM.secret_available()


def secret_get(key: str) -> str:
    return PLATFORM.secret_get(key)


def secret_set(key: str, password: str) -> bool:
    return PLATFORM.secret_set(key, password)


def secret_clear(key: str) -> bool:
    return PLATFORM.secret_clear(key)


def creds_conf_table() -> dict[str, tuple[str, str]]:
    """key -> (username, legacy_plaintext_password_or_empty)."""
    p = creds_path()
    table: dict[str, tuple[str, str]] = {}
    if not p:
        return table
    for line in p.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("|")
        if len(parts) >= 2:
            table.setdefault(parts[0], (parts[1], parts[2] if len(parts) > 2 else ""))
    return table


def creds_keys() -> list[str]:
    return sorted(creds_conf_table())


@help_topic("credential-chain", "How passwords are resolved",
            ("credentials", "keyring", "default", "precedence"),
            section="Credentials")
def creds_chain(sel: str, proto: str = "") -> list[str]:
    """Credential keys to try, most specific first.

    Scope specificity outranks protocol: a credential set for one host is more
    precise than a protocol-wide default.

        Group/Host@radmin -> Group/Host -> Group@radmin -> Group -> DEFAULT@radmin -> DEFAULT
    """
    # Walk up every level of a nested group, most specific first:
    # Plant/Line1/Host -> Plant/Line1 -> Plant -> DEFAULT
    parts = sel.split("/")
    scopes = ["/".join(parts[:i]) for i in range(len(parts), 0, -1)] + ["DEFAULT"]
    chain = []
    for scope in scopes:
        if not scope:
            continue
        if proto:
            chain.append(f"{scope}@{proto}")
        if scope not in chain:
            chain.append(scope)
    return chain


def creds_lookup(sel: str, fallback_user: str = "", proto: str = "") -> tuple[str, str]:
    """(username, password) for a connection, optionally for one protocol."""
    table = creds_conf_table()
    user, pw = fallback_user, ""
    for key in creds_chain(sel, proto):
        secret = secret_get(key)
        entry = table.get(key)
        if secret or entry:
            if entry and entry[0]:
                user = entry[0]
            pw = secret or (entry[1] if entry else "")
            if pw:
                break
    return user.split("\\")[-1], pw


def creds_scopes() -> list[str]:
    """Editable credential scopes: DEFAULT, every group, then any per-host overrides.

    Protocol-qualified keys ("Group@radmin") are scopes in their own right, so they
    show up in the editor next to the generic entry they refine.
    """
    base = ["DEFAULT"] + groups()
    extra = {k for k in creds_conf_table() if k not in base}
    extra |= {c.sel for c in conns_cached() if secret_get(c.sel)}
    for scope in list(base):
        for proto in protocol_ids():
            if secret_get(f"{scope}@{proto}"):
                extra.add(f"{scope}@{proto}")
    return base + sorted(extra)


def secret_keys_known() -> list[str]:
    """Per-connection keys that have a stored password (checked, not enumerated)."""
    return [c.sel for c in conns_cached() if secret_get(c.sel)]


def creds_status(key: str) -> tuple[str, bool, bool]:
    """(username, password_in_keyring, password_plaintext_in_file) for one scope."""
    entry = creds_conf_table().get(key, ("", ""))
    return entry[0], bool(secret_get(key)), bool(entry[1])


def creds_set_user(key: str, username: str) -> None:
    """Upsert a scope's username in creds.conf. Passwords never go in this file."""
    path = CREDS
    lines = path.read_text(encoding="utf-8").splitlines() if path.is_file() else []
    out, done = [], False
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and s.split("|")[0] == key:
            if not done:
                out.append(f"{key}|{username}|")
                done = True
            continue
        out.append(line)
    if not done:
        out.append(f"{key}|{username}|")
    path.write_text("\n".join(out) + "\n", encoding="utf-8")
    path.chmod(0o600)


def creds_delete(key: str) -> None:
    """Drop a scope entirely: its creds.conf line and its keyring password."""
    secret_clear(key)
    if not CREDS.is_file():
        return
    out = [ln for ln in CREDS.read_text(encoding="utf-8").splitlines()
           if not (ln.strip() and not ln.strip().startswith("#")
                   and ln.strip().split("|")[0] == key)]
    CREDS.write_text("\n".join(out) + "\n", encoding="utf-8")
    CREDS.chmod(0o600)


def creds_migrate() -> tuple[int, int]:
    """Move plaintext passwords out of creds.conf into the keyring.

    Returns (moved, skipped). Rewrites creds.conf with the password column blank.
    """
    if not keyring_available():
        raise RuntimeError("no keyring available (libsecret/gnome-keyring not usable)")
    p = creds_path()
    if not p:
        raise RuntimeError("no creds.conf found")
    moved = skipped = 0
    out: list[str] = []
    for line in p.read_text(encoding="utf-8").splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            out.append(line)
            continue
        parts = s.split("|")
        if len(parts) >= 3 and parts[2] and parts[2] != "CHANGEME":
            if secret_set(parts[0], parts[2]):
                moved += 1
                out.append(f"{parts[0]}|{parts[1]}|")
                continue
            skipped += 1
            out.append(line)
        else:
            skipped += 1
            out.append(line)
    target = CREDS
    target.write_text("\n".join(out) + "\n", encoding="utf-8")
    target.chmod(0o600)
    return moved, skipped


# --------------------------------------------------------------------------- #
# writing connections
# --------------------------------------------------------------------------- #
def write_rdp(group: str, name: str, host: str, username: str,
              port: int = 3389, overwrite: bool = False,
              ports: dict | None = None,
              protocols: str = "", default_proto: str = "") -> Path:
    if not TEMPLATE.is_file():
        raise SystemExit(f"missing template: {TEMPLATE}")
    dest_dir = RDP_DIR / group if group else RDP_DIR
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / f"{name}.rdp"
    if dest.exists() and not overwrite:
        raise FileExistsError(dest)
    body = rdp_text(TEMPLATE)
    body = body.replace("{{HOST}}", host).replace("{{USERNAME}}", username)
    body = re.sub(r"^server port:i:.*$", f"server port:i:{port}", body, flags=re.M)
    # rcm-* keys are our own extensions. RDP clients ignore keys they don't know.
    body = body.rstrip("\n") + "\n"
    for pid, val in (ports or {}).items():
        body += f"rcm-port-{pid}:i:{val}\n"
    if protocols:
        body += f"rcm-protocols:s:{protocols}\n"
    if default_proto:
        body += f"rcm-default-proto:s:{default_proto}\n"
    dest.write_text(body, encoding="utf-8")
    return dest


def prune_empty_parents(start: Path) -> list[str]:
    """Remove group folders left empty, walking up from `start`.

    Only the deleted connection's own ancestors, and only genuinely empty ones.
    Sweeping the whole tree would also delete a folder you had just created to
    put connections in, and a folder holding anything else -- notes, a stray
    file -- is left alone.
    """
    removed = []
    d = start
    while d != RDP_DIR and RDP_DIR in d.parents:
        try:
            if any(d.iterdir()):
                break
            d.rmdir()
        except OSError:
            break
        removed.append(str(d.relative_to(RDP_DIR)))
        d = d.parent
    return removed


@help_topic("rename-regroup", "Renaming and regrouping a connection",
            ("rename", "move", "group", "edit"), section="Connections")
def move_connection(c: Conn, new_group: str, new_name: str) -> Conn:
    """Renaming or regrouping moves the .rdp file — everything follows.

    The connection's identity is its file path, so a rename is a move. The
    parts that hang off that identity move with it in the same operation: the
    keyring password entries (the connection's own and any per-protocol ones)
    are re-stored under the new name, and a keyboard shortcut bound to the old
    name is rebound. Typing a group that does not exist yet creates it, and a
    group folder left empty is removed, exactly as on delete.
    """
    new_group = new_group.strip().strip("/")
    new_name = new_name.strip()
    if not new_name:
        raise ValueError("a connection needs a name")
    if re.search(r"[/\\]", new_name) or "\\" in new_group:
        raise ValueError("'/' belongs in the group, not the name")
    if (new_group, new_name) == (c.group, c.name):
        return c

    dest_dir = RDP_DIR / new_group if new_group else RDP_DIR
    dest = dest_dir / f"{new_name}.rdp"
    if dest.exists():
        raise FileExistsError(dest)
    dest_dir.mkdir(parents=True, exist_ok=True)
    old_sel, old_parent = c.sel, c.path.parent
    c.path.rename(dest)
    prune_empty_parents(old_parent)

    new_sel = f"{new_group}/{new_name}" if new_group else new_name
    # Keyring entries: the connection's own, plus one per protocol.
    for suffix in ("", *(f"@{pid}" for pid in protocol_ids())):
        secret = secret_get(old_sel + suffix)
        if secret:
            secret_set(new_sel + suffix, secret)
            secret_clear(old_sel + suffix)
    # creds.conf username rows keyed to the old name.
    table = creds_conf_table()
    for key, (username, _legacy) in list(table.items()):
        if key == old_sel or key.startswith(old_sel + "@"):
            creds_delete(key)
            creds_set_user(key.replace(old_sel, new_sel, 1), username)
    # A shortcut bound to the old name follows too.
    global_keys, per_session = load_shortcuts()
    if old_sel in per_session:
        per_session[new_sel] = per_session.pop(old_sel)
        save_shortcuts(global_keys, per_session)
        shortcuts_install()

    conns_cached(refresh=True)
    moved = find(new_sel)
    if moved is None:
        raise RuntimeError(f"moved {old_sel} but cannot find {new_sel} after rescan")
    return moved


def delete_conn(c: Conn) -> list[str]:
    """Delete a connection. Returns any group folders that emptied out with it."""
    c.path.unlink()
    return prune_empty_parents(c.path.parent)


@help_topic("rename-group", "Renaming a group", ("rename", "group", "folder"),
            section="Connections")
def rename_group(group: str, new_leaf: str) -> str:
    """A group is a folder, so renaming one is a move — everything follows.

    Only the last part of the path changes: "Plant/Line2" renamed to "Line 2"
    becomes "Plant/Line 2", with every connection and sub-group inside it
    coming along. Their keyring entries are keyed by connection name, which
    includes the group, so `rcm creds migrate` re-points them if you rename a
    group whose connections carry their own passwords.
    """
    new_leaf = new_leaf.strip().strip("/")
    if not group:
        raise ValueError("the whole collection has no name to change")
    if not new_leaf:
        raise ValueError("a group needs a name")
    parent = group.rsplit("/", 1)[0] if "/" in group else ""
    if new_leaf == group.rsplit("/", 1)[-1]:
        return group
    source = RDP_DIR / group
    if not source.is_dir():
        raise ValueError(f"no such group: {group}")
    destination = ((RDP_DIR / parent) if parent else RDP_DIR) / new_leaf
    if destination.exists():
        raise FileExistsError(f"{parent + '/' if parent else ''}{new_leaf} "
                              "already exists")
    source.rename(destination)
    conns_cached(refresh=True)
    renamed = f"{parent}/{new_leaf}" if parent else new_leaf
    log_event("rename-group", old=group, new=renamed)
    return renamed


def delete_group(group: str) -> int:
    """Delete a group folder and everything under it; returns connections lost.

    Keyring entries are deliberately left alone: they are keyed by connection
    name, cost nothing, and a mistaken delete would otherwise take the
    passwords with it. `rcm creds` lists and clears them when you mean it.
    """
    if not group:
        raise ValueError("refusing to delete the whole collection")
    folder = RDP_DIR / group
    if not folder.is_dir():
        raise ValueError(f"no such group: {group}")
    lost = len(group_members(group))
    shutil.rmtree(folder)
    prune_empty_parents(folder.parent)
    conns_cached(refresh=True)
    log_event("delete-group", group=group, connections=lost)
    return lost


def copy_conn(c: Conn, new_name: str) -> Path:
    dest = c.path.with_name(f"{new_name}.rdp")
    if dest.exists():
        raise FileExistsError(dest)
    shutil.copy2(c.path, dest)
    return dest


def unique_name(group: str, wanted: str) -> str:
    """`wanted` if free in `group`, else "wanted (copy)", "(copy 2)", …

    Asks the filesystem, not the cache: pasting several copies in one go
    creates files the cache has not been refreshed for yet.
    """
    folder = (RDP_DIR / group) if group else RDP_DIR
    if not (folder / f"{wanted}.rdp").exists():
        return wanted
    candidate = f"{wanted} (copy)"
    attempt = 2
    while (folder / f"{candidate}.rdp").exists():
        candidate = f"{wanted} (copy {attempt})"
        attempt += 1
    return candidate


def unique_group(parent: str, wanted: str) -> str:
    """Same rule for a group folder: the free name under `parent`."""
    base = (RDP_DIR / parent) if parent else RDP_DIR
    if not (base / wanted).exists():
        return wanted
    candidate = f"{wanted} (copy)"
    attempt = 2
    while (base / candidate).exists():
        candidate = f"{wanted} (copy {attempt})"
        attempt += 1
    return candidate


@help_topic("copy-paste", "Copying connections and groups",
            ("copy", "paste", "duplicate", "ctrl+c", "ctrl+v", "clipboard"),
            section="Connections")
def paste_into(group: str, connections: list[Conn] | None = None,
               groups: list[str] | None = None) -> list[str]:
    """Ctrl+C on any selection, Ctrl+V into whichever group you are in.

    Copying is by file: a pasted connection is a byte copy of the .rdp,
    keeping every rcm-* setting (tags, hooks, via, MAC, per-protocol ports).
    A copied group brings its whole subtree. Names never collide — an
    existing name becomes "<name> (copy)", then "(copy 2)" — so pasting into
    the same group is how you duplicate. Paste always means "inside the
    target", including a group pasted into itself; Ctrl+D is the separate
    gesture for "beside this one". Passwords are NOT copied: the keyring
    entry belongs to the original connection's name, and the copy inherits
    from its group chain until you give it one of its own.
    """
    made: list[str] = []
    for c in connections or []:
        name = unique_name(group, c.name)
        folder = (RDP_DIR / group) if group else RDP_DIR
        folder.mkdir(parents=True, exist_ok=True)
        shutil.copy2(c.path, folder / f"{name}.rdp")
        made.append(f"{group}/{name}" if group else name)
    for source in groups or []:
        leaf = source.rsplit("/", 1)[-1]
        name = unique_group(group, leaf)
        destination = ((RDP_DIR / group) if group else RDP_DIR) / name
        if group == source or group.startswith(source + "/"):
            # Pasting a group into itself is a real request ("keep a copy in
            # here"), but copying a tree into its own subtree would walk the
            # copy it is writing. Stage it outside first, then move it in.
            staged = Path(tempfile.mkdtemp(prefix="rcm-paste-")) / name
            shutil.copytree(RDP_DIR / source, staged)
            shutil.move(str(staged), str(destination))
            staged.parent.rmdir()
        else:
            shutil.copytree(RDP_DIR / source, destination)
        made.append(f"{group}/{name}" if group else name)
    conns_cached(refresh=True)
    log_event("paste", into=group or "(top level)", created=len(made))
    return made


def set_fields(c: Conn, host: str | None = None, username: str | None = None,
               port: int | None = None, ports: dict | None = None,
               protocols: str | None = None,
               default_proto: str | None = None) -> None:
    """Rewrite the per-host fields in place, leaving every other setting alone."""
    lines = rdp_text(c.path).splitlines()
    def repl(key, val):
        pat = re.compile(rf"^{re.escape(key)}:([sib]):")
        for i, ln in enumerate(lines):
            if pat.match(ln):
                kind = pat.match(ln).group(1)
                lines[i] = f"{key}:{kind}:{val}"
                return
        lines.append(f"{key}:s:{val}")
    if host is not None:
        repl("full address", host)
        repl("alternate full address", host)
    if username is not None:
        repl("username", username)
    if port is not None:
        repl("server port", str(port))
    for pid, val in (ports or {}).items():
        repl(f"rcm-port-{pid}", str(val))
    if protocols is not None:
        repl("rcm-protocols", protocols)
    if default_proto is not None:
        repl("rcm-default-proto", default_proto)
    c.path.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------- #
# launching
# --------------------------------------------------------------------------- #
def spawn_detached(argv: list[str], env: dict | None = None) -> None:
    PLATFORM.spawn_detached(argv, env)


def open_path(target) -> None:
    """Open a file or URL with the desktop's opener (xdg-open here)."""
    PLATFORM.open_path(str(target))


class ConfigError(RuntimeError):
    """Configuration is missing or wrong. Always names the file and the key."""


@dataclass
class Protocol:
    """One way of reaching a machine, defined entirely in protocols.conf.

    Nothing about any particular protocol is special-cased in code: RDP, VNC and
    Radmin are just three sections. Radmin's Wine wrapper is an `exe` plus an
    `env.` entry; its credential dialog is an `inject.steps` sequence.
    """
    id: str
    label: str = ""
    color: str = "accent"
    order: int = 100
    port: int = 0
    exe: str = ""
    env: dict = field(default_factory=dict)
    launchers: dict = field(default_factory=dict)
    default: str = ""
    detect_process: str = ""
    detect_window: str = "{host}"
    inject_class: str = ""
    inject_title: str = ""
    inject_wait: float = 20.0
    inject_settle: float = 0.3
    inject_delay: int = 40
    inject_steps: list = field(default_factory=list)
    extras: dict = field(default_factory=dict)

    @property
    def injects(self) -> bool:
        return bool(self.inject_steps)


def parse_steps(raw: str) -> list[tuple[str, str]]:
    """'type:{user} | key:Tab' -> [('type','{user}'), ('key','Tab')]."""
    steps = []
    for chunk in raw.split("|"):
        chunk = chunk.strip()
        if not chunk:
            continue
        op, _, arg = chunk.partition(":")
        op = op.strip().lower()
        if op not in ("type", "key", "sleep", "activate", "clear"):
            raise ConfigError(f"{PROTOCOLS_FILE}: unknown inject step {op!r} "
                              "(use type, key, sleep, activate or clear)")
        steps.append((op, arg.strip()))
    return steps


def load_protocols() -> dict[str, Protocol]:
    """Every [protocol:*] section, ordered by `order`."""
    if not PROTOCOLS_FILE.is_file():
        raise ConfigError(f"no {PROTOCOLS_FILE} -- run `rcm init`, "
                          "or open the manager once")
    cp = configparser.ConfigParser(inline_comment_prefixes=(";",))
    cp.optionxform = str
    cp.read(PROTOCOLS_FILE, encoding="utf-8")

    out: dict[str, Protocol] = {}
    for section in cp.sections():
        if not section.startswith("protocol:"):
            continue
        pid = section.split(":", 1)[1].strip()
        if not pid:
            raise ConfigError(f"{PROTOCOLS_FILE}: a [protocol:] section has no id")
        raw = {k: v.strip() for k, v in cp.items(section)}
        p = Protocol(id=pid, label=raw.get("label", pid.upper()))

        def num(key, cast, default):
            v = raw.get(key, "")
            if v == "":
                return default
            try:
                return cast(v)
            except ValueError:
                raise ConfigError(f"{PROTOCOLS_FILE} [{section}] {key}={v!r} "
                                  f"is not a valid {cast.__name__}") from None

        p.color = raw.get("color", "accent")
        p.order = num("order", int, 100)
        p.port = num("port", int, 0)
        p.exe = expand_user_and_vars(raw.get("exe", ""))
        p.default = raw.get("default", "")
        p.detect_process = raw.get("detect.process", "")
        p.detect_window = raw.get("detect.window", "{host}")
        p.inject_class = raw.get("inject.window_class", "")
        p.inject_title = raw.get("inject.window_title", "")
        p.inject_wait = num("inject.wait", float, 20.0)
        p.inject_settle = num("inject.settle", float, 0.3)
        p.inject_delay = num("inject.delay", int, 40)
        if raw.get("inject.steps"):
            p.inject_steps = parse_steps(raw["inject.steps"])
        for k, v in raw.items():
            if k.startswith("launcher."):
                p.launchers[k[len("launcher."):]] = v
            elif k.startswith("env."):
                p.env[k[len("env."):]] = expand_user_and_vars(v)
            elif k not in ("label", "color", "order", "port", "exe", "default") \
                    and not k.startswith(("detect.", "inject.")):
                p.extras[k] = expand_user_and_vars(v)
        if p.default and p.default not in p.launchers:
            raise ConfigError(f"{PROTOCOLS_FILE} [{section}] default={p.default!r} "
                              "is not one of its launchers")
        if not p.default and p.launchers:
            p.default = next(iter(p.launchers))
        out[pid] = p

    if not out:
        raise ConfigError(f"{PROTOCOLS_FILE} defines no [protocol:*] sections")
    return dict(sorted(out.items(), key=lambda kv: (kv[1].order, kv[1].label)))


def protocol(pid: str) -> Protocol:
    protos = load_protocols()
    if pid not in protos:
        raise ConfigError(f"unknown protocol {pid!r} -- {PROTOCOLS_FILE} defines: "
                          + ", ".join(protos))
    return protos[pid]


def protocol_ids() -> tuple[str, ...]:
    try:
        return tuple(load_protocols())
    except ConfigError:
        return ()


