#!/usr/bin/env python3
"""rcm -- remote connection manager.

Keeps connections in one place and launches them with whatever external client
you configure; credentials live in the OS keyring, not on disk.

Everything lives under one directory:

    bin/            these scripts
    RDP/GROUP/      the .rdp files -- source of truth for host + username
    templates/      default.rdp, used to generate connections on import
    export/         generated CSV / phonebook output
    launchers.conf  which program connects each protocol, plus [radmin]
    creds.conf      scope -> username only; passwords are in the keyring
    shortcuts.conf  system-wide keys

Config is never guessed: a missing or wrong value raises ConfigError naming the
file and the key, rather than silently falling back to a built-in.

A group folder renamed with a leading dot (Plant -> .Plant) disappears everywhere.
"""
from __future__ import annotations

import configparser
import csv
import getpass
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

# This script has no .py suffix, so sibling modules need the directory on the
# path; rcm_gui/rcm_switch are imported the same way further down.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from rcm_help import HELP_TOPICS, help_topic, register_topic  # noqa: E402

APP = Path(__file__).resolve().parent.parent
RDP_DIR = APP / "RDP"
TEMPLATE = APP / "templates" / "default.rdp"
EXPORT_DIR = APP / "export"
CREDS = APP / "creds.conf"
PROTOCOLS_FILE = APP / "protocols.conf"
LEGACY_LAUNCHERS = APP / "protocols.conf"
SHORTCUTS = APP / "shortcuts.conf"
UI_CONF = APP / "ui.conf"

# Window layouts a user can switch between; "rail" is the designed default and
# "classic" is the pre-redesign window kept for continuity.
LAYOUTS = ("rail", "spotlight", "cockpit", "inspector", "classic")
LEGACY_CREDS = Path.home() / ".config" / "radmin" / "creds.conf"

DESKTOP_FILE = Path.home() / ".local/share/applications/rdp-menu.desktop"
MAX_JUMPLIST = 10


# --------------------------------------------------------------------------- #
# model
# --------------------------------------------------------------------------- #
@dataclass
class Conn:
    group: str
    name: str
    path: Path
    host: str = ""
    username: str = ""
    port: int = 3389
    extra: dict = field(default_factory=dict)

    @property
    def sel(self) -> str:
        return f"{self.group}/{self.name}" if self.group else self.name

    @property
    def protocols(self) -> tuple[str, ...]:
        """Which protocols this host offers. Absent key means "all of them"."""
        known = protocol_ids()
        raw = (self.extra.get("rcm-protocols") or "").strip()
        if not raw:
            return known
        want = [p.strip().lower() for p in raw.split(",") if p.strip()]
        return tuple(p for p in known if p in want) or known

    @property
    def default_protocol(self) -> str:
        """Which protocol a double-click uses. Falls back to the first enabled."""
        want = (self.extra.get("rcm-default-proto") or "").strip().lower()
        enabled = self.protocols
        if want and want in enabled:
            return want
        return enabled[0] if enabled else ""

    def port_for(self, proto) -> int:
        """Per-connection port for a protocol, else the protocol's default.

        RDP keeps using the .rdp file's own `server port`; anything else is
        stored as rcm-port-<id>, so a new protocol needs no code change.
        """
        pid = proto if isinstance(proto, str) else proto.id
        if pid == "rdp":
            return self.port
        raw = self.extra.get(f"rcm-port-{pid}")
        if raw:
            try:
                return int(raw)
            except ValueError:
                pass
        if not isinstance(proto, str):
            return proto.port or self.port
        try:
            return protocol(pid).port or self.port
        except ConfigError:
            return self.port


def parse_rdp(path: Path) -> dict:
    out = {}
    for line in path.read_text(errors="replace").splitlines():
        m = re.match(r"^([^:]+):([sib]):(.*)$", line)
        if m:
            out[m.group(1)] = m.group(3).strip("\r")
    return out


def scan() -> list[Conn]:
    """All connections, skipping dot-prefixed groups."""
    conns: list[Conn] = []
    if not RDP_DIR.is_dir():
        return conns
    for p in sorted(RDP_DIR.rglob("*.rdp")):
        rel = p.relative_to(RDP_DIR)
        # Any dot-prefixed path component hides the connection.
        if any(part.startswith(".") for part in rel.parts):
            continue
        f = parse_rdp(p)
        conns.append(Conn(
            # Full relative parent path, so groups can nest arbitrarily:
            # RDP/Plant/Line1/Host.rdp -> group "Plant/Line1".
            group="/".join(rel.parts[:-1]),
            name=p.stem,
            path=p,
            host=f.get("full address", ""),
            username=f.get("username", ""),
            port=int(f.get("server port") or 3389),
            extra=f,
        ))
    return conns


def groups() -> list[str]:
    """Every group path, including intermediate levels of a nested tree."""
    out: set[str] = set()
    for c in conns_cached():
        parts = c.group.split("/") if c.group else []
        for i in range(1, len(parts) + 1):
            out.add("/".join(parts[:i]))
    return sorted(out)


def group_members(group: str) -> list[Conn]:
    """Connections in a group, including everything in its sub-groups."""
    return [c for c in conns_cached()
            if c.group == group or c.group.startswith(group + "/")]


_cache: list[Conn] | None = None


def conns_cached(refresh: bool = False) -> list[Conn]:
    global _cache
    if _cache is None or refresh:
        _cache = scan()
    return _cache


def find(sel: str) -> Conn | None:
    for c in conns_cached():
        if c.sel == sel:
            return c
    return None


# --------------------------------------------------------------------------- #
# credentials
# --------------------------------------------------------------------------- #
def creds_path() -> Path | None:
    for p in (CREDS, LEGACY_CREDS):
        if p.is_file():
            return p
    return None


# Passwords live in the login keyring (libsecret), encrypted at rest and unlocked
# with the session. creds.conf keeps only "key|username" -- no secret material.
# A third field there is still honoured so pre-keyring files keep working.
_KEYRING_BACKEND = None


def keyring_backend():
    global _KEYRING_BACKEND
    if _KEYRING_BACKEND is None:
        try:
            import gi
            gi.require_version("Secret", "1")
            from gi.repository import Secret
            _KEYRING_BACKEND = (Secret, Secret.Schema.new(
                "org.hyper.rcm", Secret.SchemaFlags.NONE,
                {"app": Secret.SchemaAttributeType.STRING,
                 "key": Secret.SchemaAttributeType.STRING}))
        except Exception:
            _KEYRING_BACKEND = (None, None)
    return _KEYRING_BACKEND


def keyring_available() -> bool:
    return keyring_backend()[0] is not None


def secret_get(key: str) -> str:
    Secret, schema = keyring_backend()
    if not Secret:
        return ""
    try:
        return Secret.password_lookup_sync(schema, {"app": "rcm", "key": key}, None) or ""
    except Exception:
        return ""


def secret_set(key: str, password: str) -> bool:
    Secret, schema = keyring_backend()
    if not Secret:
        return False
    return bool(Secret.password_store_sync(
        schema, {"app": "rcm", "key": key}, Secret.COLLECTION_DEFAULT,
        f"rcm credential for {key}", password, None))


def secret_clear(key: str) -> bool:
    Secret, schema = keyring_backend()
    if not Secret:
        return False
    try:
        return bool(Secret.password_clear_sync(schema, {"app": "rcm", "key": key}, None))
    except Exception:
        return False


def creds_conf_table() -> dict[str, tuple[str, str]]:
    """key -> (username, legacy_plaintext_password_or_empty)."""
    p = creds_path()
    table: dict[str, tuple[str, str]] = {}
    if not p:
        return table
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("|")
        if len(parts) >= 2:
            table.setdefault(parts[0], (parts[1], parts[2] if len(parts) > 2 else ""))
    return table


def creds_keys() -> list[str]:
    return sorted(creds_conf_table())


def creds_chain(sel: str, proto: str = "") -> list[str]:
    """Credential keys to try, most specific first.

    Scope specificity outranks protocol: a credential set for one host is more
    precise than a protocol-wide default.

        Group/Host@radmin -> Group/Host -> Group@radmin -> Group -> DEFAULT@radmin -> DEFAULT
    """
    # Walk up every level of a nested group, most specific first:
    # Plant/Line1/Host -> Plant/Line1 -> Plant -> DEFAULT
    parts = sel.split("/")
    scopes = ["/".join(parts[:i]) for i in range(len(parts), 0, -1)] + ["DEFAULT"]
    chain = []
    for scope in scopes:
        if not scope:
            continue
        if proto:
            chain.append(f"{scope}@{proto}")
        if scope not in chain:
            chain.append(scope)
    return chain


def creds_lookup(sel: str, fallback_user: str = "", proto: str = "") -> tuple[str, str]:
    """(username, password) for a connection, optionally for one protocol."""
    table = creds_conf_table()
    user, pw = fallback_user, ""
    for key in creds_chain(sel, proto):
        secret = secret_get(key)
        entry = table.get(key)
        if secret or entry:
            if entry and entry[0]:
                user = entry[0]
            pw = secret or (entry[1] if entry else "")
            if pw:
                break
    return user.split("\\")[-1], pw


def creds_scopes() -> list[str]:
    """Editable credential scopes: DEFAULT, every group, then any per-host overrides.

    Protocol-qualified keys ("Group@radmin") are scopes in their own right, so they
    show up in the editor next to the generic entry they refine.
    """
    base = ["DEFAULT"] + groups()
    extra = {k for k in creds_conf_table() if k not in base}
    extra |= {c.sel for c in conns_cached() if secret_get(c.sel)}
    for scope in list(base):
        for proto in protocol_ids():
            if secret_get(f"{scope}@{proto}"):
                extra.add(f"{scope}@{proto}")
    return base + sorted(extra)


def secret_keys_known() -> list[str]:
    """Per-connection keys that have a stored password (checked, not enumerated)."""
    return [c.sel for c in conns_cached() if secret_get(c.sel)]


def creds_status(key: str) -> tuple[str, bool, bool]:
    """(username, password_in_keyring, password_plaintext_in_file) for one scope."""
    entry = creds_conf_table().get(key, ("", ""))
    return entry[0], bool(secret_get(key)), bool(entry[1])


def creds_set_user(key: str, username: str) -> None:
    """Upsert a scope's username in creds.conf. Passwords never go in this file."""
    path = CREDS
    lines = path.read_text().splitlines() if path.is_file() else []
    out, done = [], False
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and s.split("|")[0] == key:
            if not done:
                out.append(f"{key}|{username}|")
                done = True
            continue
        out.append(line)
    if not done:
        out.append(f"{key}|{username}|")
    path.write_text("\n".join(out) + "\n")
    path.chmod(0o600)


def creds_delete(key: str) -> None:
    """Drop a scope entirely: its creds.conf line and its keyring password."""
    secret_clear(key)
    if not CREDS.is_file():
        return
    out = [ln for ln in CREDS.read_text().splitlines()
           if not (ln.strip() and not ln.strip().startswith("#")
                   and ln.strip().split("|")[0] == key)]
    CREDS.write_text("\n".join(out) + "\n")
    CREDS.chmod(0o600)


def creds_migrate() -> tuple[int, int]:
    """Move plaintext passwords out of creds.conf into the keyring.

    Returns (moved, skipped). Rewrites creds.conf with the password column blank.
    """
    if not keyring_available():
        raise RuntimeError("no keyring available (libsecret/gnome-keyring not usable)")
    p = creds_path()
    if not p:
        raise RuntimeError("no creds.conf found")
    moved = skipped = 0
    out: list[str] = []
    for line in p.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            out.append(line)
            continue
        parts = s.split("|")
        if len(parts) >= 3 and parts[2] and parts[2] != "CHANGEME":
            if secret_set(parts[0], parts[2]):
                moved += 1
                out.append(f"{parts[0]}|{parts[1]}|")
                continue
            skipped += 1
            out.append(line)
        else:
            skipped += 1
            out.append(line)
    target = CREDS
    target.write_text("\n".join(out) + "\n")
    target.chmod(0o600)
    return moved, skipped


# --------------------------------------------------------------------------- #
# writing connections
# --------------------------------------------------------------------------- #
def write_rdp(group: str, name: str, host: str, username: str,
              port: int = 3389, overwrite: bool = False,
              ports: dict | None = None,
              protocols: str = "", default_proto: str = "") -> Path:
    if not TEMPLATE.is_file():
        raise SystemExit(f"missing template: {TEMPLATE}")
    dest_dir = RDP_DIR / group if group else RDP_DIR
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / f"{name}.rdp"
    if dest.exists() and not overwrite:
        raise FileExistsError(dest)
    body = TEMPLATE.read_text()
    body = body.replace("{{HOST}}", host).replace("{{USERNAME}}", username)
    body = re.sub(r"^server port:i:.*$", f"server port:i:{port}", body, flags=re.M)
    # rcm-* keys are our own extensions. RDP clients ignore keys they don't know.
    body = body.rstrip("\n") + "\n"
    for pid, val in (ports or {}).items():
        body += f"rcm-port-{pid}:i:{val}\n"
    if protocols:
        body += f"rcm-protocols:s:{protocols}\n"
    if default_proto:
        body += f"rcm-default-proto:s:{default_proto}\n"
    dest.write_text(body)
    return dest


def prune_empty_parents(start: Path) -> list[str]:
    """Remove group folders left empty, walking up from `start`.

    Only the deleted connection's own ancestors, and only genuinely empty ones.
    Sweeping the whole tree would also delete a folder you had just created to
    put connections in, and a folder holding anything else -- notes, a stray
    file -- is left alone.
    """
    removed = []
    d = start
    while d != RDP_DIR and RDP_DIR in d.parents:
        try:
            if any(d.iterdir()):
                break
            d.rmdir()
        except OSError:
            break
        removed.append(str(d.relative_to(RDP_DIR)))
        d = d.parent
    return removed


@help_topic("rename-regroup", "Renaming and regrouping a connection",
            ("rename", "move", "group", "edit"), section="Connections")
def move_connection(c: Conn, new_group: str, new_name: str) -> Conn:
    """Renaming or regrouping moves the .rdp file — everything follows.

    The connection's identity is its file path, so a rename is a move. The
    parts that hang off that identity move with it in the same operation: the
    keyring password entries (the connection's own and any per-protocol ones)
    are re-stored under the new name, and a keyboard shortcut bound to the old
    name is rebound. Typing a group that does not exist yet creates it, and a
    group folder left empty is removed, exactly as on delete.
    """
    new_group = new_group.strip().strip("/")
    new_name = new_name.strip()
    if not new_name:
        raise ValueError("a connection needs a name")
    if re.search(r"[/\\]", new_name) or "\\" in new_group:
        raise ValueError("'/' belongs in the group, not the name")
    if (new_group, new_name) == (c.group, c.name):
        return c

    dest_dir = RDP_DIR / new_group if new_group else RDP_DIR
    dest = dest_dir / f"{new_name}.rdp"
    if dest.exists():
        raise FileExistsError(dest)
    dest_dir.mkdir(parents=True, exist_ok=True)
    old_sel, old_parent = c.sel, c.path.parent
    c.path.rename(dest)
    prune_empty_parents(old_parent)

    new_sel = f"{new_group}/{new_name}" if new_group else new_name
    # Keyring entries: the connection's own, plus one per protocol.
    for suffix in ("", *(f"@{pid}" for pid in protocol_ids())):
        secret = secret_get(old_sel + suffix)
        if secret:
            secret_set(new_sel + suffix, secret)
            secret_clear(old_sel + suffix)
    # creds.conf username rows keyed to the old name.
    table = creds_conf_table()
    for key, (username, _legacy) in list(table.items()):
        if key == old_sel or key.startswith(old_sel + "@"):
            creds_delete(key)
            creds_set_user(key.replace(old_sel, new_sel, 1), username)
    # A shortcut bound to the old name follows too.
    global_keys, per_session = load_shortcuts()
    if old_sel in per_session:
        per_session[new_sel] = per_session.pop(old_sel)
        save_shortcuts(global_keys, per_session)
        shortcuts_install()

    conns_cached(refresh=True)
    moved = find(new_sel)
    if moved is None:
        raise RuntimeError(f"moved {old_sel} but cannot find {new_sel} after rescan")
    return moved


def delete_conn(c: Conn) -> list[str]:
    """Delete a connection. Returns any group folders that emptied out with it."""
    c.path.unlink()
    return prune_empty_parents(c.path.parent)


def copy_conn(c: Conn, new_name: str) -> Path:
    dest = c.path.with_name(f"{new_name}.rdp")
    if dest.exists():
        raise FileExistsError(dest)
    shutil.copy2(c.path, dest)
    return dest


def set_fields(c: Conn, host: str | None = None, username: str | None = None,
               port: int | None = None, ports: dict | None = None,
               protocols: str | None = None,
               default_proto: str | None = None) -> None:
    """Rewrite the per-host fields in place, leaving every other setting alone."""
    lines = c.path.read_text().splitlines()
    def repl(key, val):
        pat = re.compile(rf"^{re.escape(key)}:([sib]):")
        for i, ln in enumerate(lines):
            if pat.match(ln):
                kind = pat.match(ln).group(1)
                lines[i] = f"{key}:{kind}:{val}"
                return
        lines.append(f"{key}:s:{val}")
    if host is not None:
        repl("full address", host)
        repl("alternate full address", host)
    if username is not None:
        repl("username", username)
    if port is not None:
        repl("server port", str(port))
    for pid, val in (ports or {}).items():
        repl(f"rcm-port-{pid}", str(val))
    if protocols is not None:
        repl("rcm-protocols", protocols)
    if default_proto is not None:
        repl("rcm-default-proto", default_proto)
    c.path.write_text("\n".join(lines) + "\n")


# --------------------------------------------------------------------------- #
# launching
# --------------------------------------------------------------------------- #
def spawn_detached(argv: list[str], env: dict | None = None) -> None:
    e = dict(os.environ)
    if env:
        e.update(env)
    subprocess.Popen(argv, env=e, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


class ConfigError(RuntimeError):
    """Configuration is missing or wrong. Always names the file and the key."""


@dataclass
class Protocol:
    """One way of reaching a machine, defined entirely in protocols.conf.

    Nothing about any particular protocol is special-cased in code: RDP, VNC and
    Radmin are just three sections. Radmin's Wine wrapper is an `exe` plus an
    `env.` entry; its credential dialog is an `inject.steps` sequence.
    """
    id: str
    label: str = ""
    color: str = "accent"
    order: int = 100
    port: int = 0
    exe: str = ""
    env: dict = field(default_factory=dict)
    launchers: dict = field(default_factory=dict)
    default: str = ""
    detect_process: str = ""
    detect_window: str = "{host}"
    inject_class: str = ""
    inject_title: str = ""
    inject_wait: float = 20.0
    inject_settle: float = 0.3
    inject_delay: int = 40
    inject_steps: list = field(default_factory=list)
    extras: dict = field(default_factory=dict)

    @property
    def injects(self) -> bool:
        return bool(self.inject_steps)


def parse_steps(raw: str) -> list[tuple[str, str]]:
    """'type:{user} | key:Tab' -> [('type','{user}'), ('key','Tab')]."""
    steps = []
    for chunk in raw.split("|"):
        chunk = chunk.strip()
        if not chunk:
            continue
        op, _, arg = chunk.partition(":")
        op = op.strip().lower()
        if op not in ("type", "key", "sleep", "activate", "clear"):
            raise ConfigError(f"{PROTOCOLS_FILE}: unknown inject step {op!r} "
                              "(use type, key, sleep, activate or clear)")
        steps.append((op, arg.strip()))
    return steps


def load_protocols() -> dict[str, Protocol]:
    """Every [protocol:*] section, ordered by `order`."""
    if not PROTOCOLS_FILE.is_file():
        raise ConfigError(f"no {PROTOCOLS_FILE} -- run `rcm init`, "
                          "or open the manager once")
    cp = configparser.ConfigParser(inline_comment_prefixes=(";",))
    cp.optionxform = str
    cp.read(PROTOCOLS_FILE)

    out: dict[str, Protocol] = {}
    for section in cp.sections():
        if not section.startswith("protocol:"):
            continue
        pid = section.split(":", 1)[1].strip()
        if not pid:
            raise ConfigError(f"{PROTOCOLS_FILE}: a [protocol:] section has no id")
        raw = {k: v.strip() for k, v in cp.items(section)}
        p = Protocol(id=pid, label=raw.get("label", pid.upper()))

        def num(key, cast, default):
            v = raw.get(key, "")
            if v == "":
                return default
            try:
                return cast(v)
            except ValueError:
                raise ConfigError(f"{PROTOCOLS_FILE} [{section}] {key}={v!r} "
                                  f"is not a valid {cast.__name__}") from None

        p.color = raw.get("color", "accent")
        p.order = num("order", int, 100)
        p.port = num("port", int, 0)
        p.exe = expand_user_and_vars(raw.get("exe", ""))
        p.default = raw.get("default", "")
        p.detect_process = raw.get("detect.process", "")
        p.detect_window = raw.get("detect.window", "{host}")
        p.inject_class = raw.get("inject.window_class", "")
        p.inject_title = raw.get("inject.window_title", "")
        p.inject_wait = num("inject.wait", float, 20.0)
        p.inject_settle = num("inject.settle", float, 0.3)
        p.inject_delay = num("inject.delay", int, 40)
        if raw.get("inject.steps"):
            p.inject_steps = parse_steps(raw["inject.steps"])
        for k, v in raw.items():
            if k.startswith("launcher."):
                p.launchers[k[len("launcher."):]] = v
            elif k.startswith("env."):
                p.env[k[len("env."):]] = expand_user_and_vars(v)
            elif k not in ("label", "color", "order", "port", "exe", "default") \
                    and not k.startswith(("detect.", "inject.")):
                p.extras[k] = expand_user_and_vars(v)
        if p.default and p.default not in p.launchers:
            raise ConfigError(f"{PROTOCOLS_FILE} [{section}] default={p.default!r} "
                              "is not one of its launchers")
        if not p.default and p.launchers:
            p.default = next(iter(p.launchers))
        out[pid] = p

    if not out:
        raise ConfigError(f"{PROTOCOLS_FILE} defines no [protocol:*] sections")
    return dict(sorted(out.items(), key=lambda kv: (kv[1].order, kv[1].label)))


def protocol(pid: str) -> Protocol:
    protos = load_protocols()
    if pid not in protos:
        raise ConfigError(f"unknown protocol {pid!r} -- {PROTOCOLS_FILE} defines: "
                          + ", ".join(protos))
    return protos[pid]


def protocol_ids() -> tuple[str, ...]:
    try:
        return tuple(load_protocols())
    except ConfigError:
        return ()


# First-run defaults. These are written to disk as real, commented, hand-editable
# files -- they are never used as invisible in-code fallbacks. That is what makes
# "fail loudly on bad config" livable: a fresh clone gets files it can see.
DEFAULT_CONFIGS: dict[str, str] = {
    "protocols.conf": r"""# Protocols.
#
# Each [protocol:<id>] section defines one way of reaching a machine: what its
# button looks like, which programs can open it, how a live session is
# recognised, and -- optionally -- how credentials get typed into a prompt.
# Add as many as you like; nothing here is special-cased in the code.
#
# Keys
#   label            button text and display name
#   color            button colour (#rrggbb), or "accent" for the theme accent
#   order            sort order for buttons and menus (low first)
#   port             default port; a connection can override it
#   exe              optional path, available to commands as {exe}
#   env.NAME         environment variable set when launching
#   default          which launcher the button uses
#   launcher.<Name>  a command line; several per protocol is normal
#   detect.process   regex matched against process command lines to spot a session
#   detect.window    window-title pattern used to find that session's window
#
# Credential typing (optional; omit the whole block if the client handles auth)
#   inject.window_class  X11 class of the credential dialog
#   inject.window_title  substring of its title
#   inject.wait          seconds to wait for it to appear
#   inject.settle        pause after focusing it, before typing
#   inject.delay         milliseconds between keystrokes
#   inject.steps         what to do, in order, separated by |
#                          type:<text>   key:<keysym>   sleep:<seconds>
#                          activate      clear
#
# Placeholders in commands and steps:
#   {host} {port} {user} {password} {name} {file} {exe}
# {file} is the connection's .rdp path. {password} is read from the keyring at
# the moment it is typed and never written to disk.

[protocol:rdp]
label = RDP
color = #4e9a25
order = 10
port = 3389
default = Thincast
launcher.Thincast = flatpak run com.thincast.client {file}
launcher.xfreerdp = xfreerdp3 /v:{host}:{port} /u:{user} +clipboard +fonts /dynamic-resolution /cert:ignore
launcher.Remmina = remmina -c {file}
launcher.mstsc = mstsc {file}
detect.process = (^|/)(rdc|xfreerdp3?|freerdp|mstsc(\.exe)?)\b
detect.window = {host}

[protocol:vnc]
label = VNC
color = #2b6cb0
order = 20
port = 5900
default = Remmina
launcher.Remmina = remmina -c vnc://{host}:{port}
launcher.TigerVNC = vncviewer {host}::{port}
detect.process = vnc://|(^|/)(vncviewer|xtigervncviewer)\b
detect.window = {host}

[protocol:radmin]
label = Radmin
color = #d97a1f
order = 30
port = 4899
exe =
env.WINEPREFIX =
default = Native
launcher.Wine = wine-stable {exe} /connect:{host}:{port}
launcher.Native = {exe} /connect:{host}:{port}
detect.process = Radmin(\.exe)? .*/connect:
detect.window = {host}
# Radmin has no /password: switch by design, so the password must be typed.
inject.window_class = [Rr]admin
inject.window_title = security
inject.wait = 20
inject.settle = 0.3
inject.delay = 40
inject.steps = type:{user} | key:Tab | type:{password} | key:Return
# Only `rcm phonebook` reads this; it uses the file as a structural template.
phonebook =

# Example of adding your own. AnyDesk prompts for a password in its own window;
# adjust inject.window_title to whatever your version actually shows.
#
# [protocol:anydesk]
# label = AnyDesk
# color = #ef443b
# order = 40
# default = AnyDesk
# launcher.AnyDesk = anydesk {host}
# detect.process = (^|/)anydesk\b
# inject.window_title = Password
# inject.wait = 20
# inject.steps = type:{password} | key:Return
""",
    "creds.conf": """\
# Credentials for rcm. Passwords are NOT stored here -- they live in the OS
# keyring. This file only maps a scope to a username.
#
# Format:  key|username|
#
#   key       "GROUP/Name", "GROUP", or "DEFAULT", optionally with "@protocol"
#             (rdp / vnc / radmin). Looked up most specific first, and within a
#             scope a protocol-specific entry beats the generic one:
#
#               GROUP/Name@radmin -> GROUP/Name -> GROUP@radmin
#                                 -> GROUP -> DEFAULT@radmin -> DEFAULT
#
#   username  leave EMPTY to use username:s: from the matching .rdp file.
#
# Edit here, or in the manager under Credentials...

DEFAULT||
""",
    "ui.conf": """\
# Manager window state. The GUI writes this; editing it by hand is equally fine.

[ui]
# Which window layout the manager uses: rail | spotlight | cockpit | inspector
# | classic. The Layout button in the headerbar writes this same key.
layout = rail

[tabs]
# Pinned filter tabs, shared by every layout. One per line:
#   tab.<n> = <label>|<group filter>|<text filter>
# The "All" tab is built in and not listed here.

[help]
# Editor used by Help's "Open code" links, e.g. `code --goto {file}:{line}`.
# Leave empty to auto-detect; Help asks once when nothing is found.
editor =
""",
    "shortcuts.conf": """\
# System-wide keyboard shortcuts.
#
# Edited from the manager (menu -> Keyboard shortcuts...) or by hand.
# Run `rcm shortcuts install` after editing by hand.
#
# Binding syntax is Cinnamon's: <Super> <Ctrl> <Alt> <Shift> plus a key,
# e.g. <Super>r, <Super><Alt>1, <Super>grave.

[global]
# Raise the manager
focus = <Super>r
# Next active session
next = <Super>w
# Previous active session
prev = <Super>q

[sessions]
# Focuses the connection if a session is live, otherwise connects it.
# One line per connection, e.g.:  GROUP/Host = <Super><Alt>1
""",
}


def missing_configs() -> list[str]:
    return [name for name in DEFAULT_CONFIGS if not (APP / name).is_file()]


def write_default_configs(names: list[str] | None = None) -> list[str]:
    """Create any missing config file from its documented default."""
    written = []
    for name in (names if names is not None else missing_configs()):
        dest = APP / name
        if dest.is_file():
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(DEFAULT_CONFIGS[name])
        if name == "creds.conf":
            dest.chmod(0o600)
        written.append(name)
    return written


def expand_user_and_vars(value: str) -> str:
    return os.path.expandvars(os.path.expanduser(value.strip()))


def protocol_detect(p: Protocol) -> list[Path]:
    """Candidate paths for a protocol's `exe`, best first.

    Ranked, not first-hit: a machine can easily have a real install, an abandoned
    Wine prefix with no exe, and a couple of portable copies in Downloads.
    """
    stem = Path(p.exe).name if p.exe else f"{p.id}.exe"
    home = Path.home()
    roots = [home / ".local/share/wineprefixes", home, home / "WindowsApps",
             home / "Downloads", Path("/opt")]
    for env in ("ProgramFiles(x86)", "ProgramFiles"):
        if os.environ.get(env):
            roots.append(Path(os.environ[env]))
    seen, found = set(), []
    for root in roots:
        if not root.is_dir():
            continue
        try:
            for hit in root.glob(f"**/{stem}"):
                rp = hit.resolve()
                if rp not in seen and rp.is_file():
                    seen.add(rp)
                    found.append(rp)
        except (OSError, PermissionError):
            continue

    def rank(f: Path) -> tuple:
        s = str(f)
        return (0 if "wineprefixes" in s or "Program Files" in s else 1,
                0 if "Downloads" not in s else 1, -f.stat().st_size, s)
    return sorted(found, key=rank)


def save_protocols(protos: dict[str, Protocol]) -> None:
    """Rewrite protocols.conf.

    Regenerates the documentation header rather than round-tripping arbitrary
    comments -- configparser cannot preserve them, and a silently de-commented
    config is worse than a re-commented one.
    """
    head, _, _ = DEFAULT_CONFIGS["protocols.conf"].partition("\n[protocol:")
    L = [head.rstrip("\n"), ""]
    for p in protos.values():
        L.append(f"[protocol:{p.id}]")
        L.append(f"label = {p.label}")
        L.append(f"color = {p.color}")
        L.append(f"order = {p.order}")
        if p.port:
            L.append(f"port = {p.port}")
        if p.exe:
            L.append(f"exe = {p.exe}")
        for k, v in p.env.items():
            L.append(f"env.{k} = {v}")
        if p.default:
            L.append(f"default = {p.default}")
        for name, cmd in p.launchers.items():
            L.append(f"launcher.{name} = {cmd}")
        if p.detect_process:
            L.append(f"detect.process = {p.detect_process}")
        if p.detect_window:
            L.append(f"detect.window = {p.detect_window}")
        if p.inject_steps:
            if p.inject_class:
                L.append(f"inject.window_class = {p.inject_class}")
            if p.inject_title:
                L.append(f"inject.window_title = {p.inject_title}")
            L.append(f"inject.wait = {p.inject_wait}")
            L.append(f"inject.settle = {p.inject_settle}")
            L.append(f"inject.delay = {p.inject_delay}")
            L.append("inject.steps = " + " | ".join(
                op if not arg else f"{op}:{arg}" for op, arg in p.inject_steps))
        for k, v in p.extras.items():
            L.append(f"{k} = {v}")
        L.append("")
    PROTOCOLS_FILE.write_text("\n".join(L) + "\n")


def migrate_launchers() -> bool:
    """Turn a pre-protocols launchers.conf into protocols.conf. One-way."""
    if PROTOCOLS_FILE.is_file() or not LEGACY_LAUNCHERS.is_file():
        return False
    cp = configparser.ConfigParser(inline_comment_prefixes=(";",))
    cp.optionxform = str
    cp.read(LEGACY_LAUNCHERS)
    write_default_configs(["protocols.conf"])
    protos = load_protocols()
    for pid in ("rdp", "vnc"):
        if cp.has_section(pid):
            items = {k: v.strip() for k, v in cp.items(pid) if k != "default" and v.strip()}
            if items:
                protos[pid].launchers = items
            dflt = cp.get(pid, "default", fallback="").strip()
            if dflt in protos[pid].launchers:
                protos[pid].default = dflt
    if cp.has_section("radmin") and "radmin" in protos:
        r, p = dict(cp.items("radmin")), protos["radmin"]
        if r.get("exe"):
            p.exe = expand_user_and_vars(r["exe"])
        if r.get("wineprefix"):
            p.env["WINEPREFIX"] = expand_user_and_vars(r["wineprefix"])
        p.default = "Native" if not r.get("wine", "").strip() else "Wine"
        if r.get("wine", "").strip():
            p.launchers["Wine"] = f"{r['wine'].strip()} {{exe}} /connect:{{host}}:{{port}}"
        if r.get("phonebook"):
            p.extras["phonebook"] = expand_user_and_vars(r["phonebook"])
        for src, dst in (("port", "port"), ("dialog_wait", "inject_wait"),
                         ("settle", "inject_settle"), ("type_delay", "inject_delay")):
            if r.get(src):
                try:
                    setattr(p, dst, type(getattr(p, dst))(r[src]))
                except ValueError:
                    pass
        if r.get("window_class"):
            p.inject_class = r["window_class"]
        if r.get("title_match"):
            p.inject_title = r["title_match"]
        if r.get("inject_order") == "pass-only":
            p.inject_steps = parse_steps("type:{password} | key:Return")
    save_protocols(protos)
    LEGACY_LAUNCHERS.rename(LEGACY_LAUNCHERS.with_suffix(".conf.migrated"))
    return True


def launcher_names(proto: str) -> list[str]:
    try:
        return list(protocol(proto).launchers)
    except ConfigError:
        return []


def launch_placeholder_values(c: Conn, p: Protocol, password: str = "") -> dict[str, str]:
    return {"file": str(c.path), "host": c.host, "user": c.username,
            "port": str(c.port_for(p)), "name": c.name, "exe": p.exe,
            "password": password}


def build_argv(c: Conn, proto: str, launcher: str = "") -> list[str]:
    p = protocol(proto)
    name = launcher or p.default
    tmpl = p.launchers.get(name, "")
    if not tmpl:
        raise RuntimeError(f"{PROTOCOLS_FILE}: protocol {proto!r} has no launcher"
                           + (f" named {name!r}" if name else ""))
    vals = launch_placeholder_values(c, p)
    # Substitute per token so a path with spaces stays a single argument.
    return [tok.format(**vals) for tok in shlex.split(tmpl)]


def launch(c: Conn, proto: str = "", launcher: str = "") -> str:
    p = protocol(proto or next(iter(load_protocols())))
    argv = build_argv(c, p.id, launcher)
    if not shutil.which(argv[0]) and not Path(argv[0]).is_file():
        raise RuntimeError(f"{argv[0]} is not installed "
                           f"(launcher {launcher or p.default!r} for {p.label})")
    if p.injects:
        return inject_credentials(c, p, argv)
    spawn_detached(argv, env=p.env or None)
    return f"{p.label} -> {c.sel} ({c.host}) via {Path(argv[0]).name}"


def inject_credentials(c: Conn, p: Protocol, argv: list[str]) -> str:
    """Launch, wait for the credential prompt, then perform inject.steps.

    Generic on purpose: any client that insists on typing (Radmin has no
    /password: switch by design, and others are the same) is handled by a step
    list in protocols.conf rather than bespoke code.
    """
    # xdotool cannot inject under Wayland; without this it fails silently.
    if os.environ.get("XDG_SESSION_TYPE", "x11") != "x11":
        raise RuntimeError(
            f"session is {os.environ.get('XDG_SESSION_TYPE')}, not X11 -- "
            "credential typing will not work (ydotool is the fallback)")

    user, pw = creds_lookup(c.sel, c.username, proto=p.id)
    win, _ = open_credential_prompt(p, c.host, argv)
    if not pw or pw == "CHANGEME":
        return f"prompt open on {c.host}; no password set -- type it manually"

    vals = launch_placeholder_values(c, p, password=pw)
    vals["user"] = user
    # xdotool type --window uses XSendEvent, which Wine ignores outright.
    # Always activate first, then type to the focused window via XTEST.
    xdotool("windowactivate", "--sync", win)
    time.sleep(p.inject_settle)
    for op, arg in p.inject_steps:
        if op == "type":
            xdotool("type", "--delay", str(p.inject_delay), "--", arg.format(**vals))
        elif op == "key":
            xdotool("key", arg)
        elif op == "sleep":
            time.sleep(float(arg or 0))
        elif op == "activate":
            xdotool("windowactivate", "--sync", win)
        elif op == "clear":
            xdotool("key", "ctrl+a")
            xdotool("key", "Delete")
    return f"{p.label} -> {c.sel} ({c.host}) as {user}"


def open_credential_prompt(p: Protocol, host: str, argv: list[str]) -> tuple[str, list[str]]:
    """Launch and wait for the credential window. (chosen window, all new)."""
    before = visible_protocol_windows(p)
    spawn_detached(argv, env=p.env or None)
    deadline = time.time() + p.inject_wait
    new: list[str] = []
    while time.time() < deadline:
        new = sorted(visible_protocol_windows(p) - before)
        if new:
            break
        time.sleep(0.25)
    if not new:
        raise RuntimeError(f"no {p.label} window appeared within {p.inject_wait:.0f}s")
    # Prefer the prompt by title, falling back to the newest window if the
    # wording ever changes.
    for w in new:
        nm = xdotool("getwindowname", w)
        if p.inject_title.lower() in nm.lower() and host in nm:
            return w, new
    return new[-1], new


def visible_protocol_windows(p: Protocol) -> set[str]:
    if p.inject_class:
        out = xdotool("search", "--onlyvisible", "--class", p.inject_class)
    else:
        out = xdotool("search", "--onlyvisible", "--name", p.inject_title or p.label)
    return {w for w in out.splitlines() if w.strip()}


def launch_rdp(c: Conn) -> None:
    launch(c, "rdp")


def xdotool(*args: str) -> str:
    try:
        return subprocess.run(["xdotool", *args], capture_output=True,
                              text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


def capture_window(win: str, dest: Path) -> Path | None:
    """Save a picture of one window, or None if the tools are missing.

    Wine draws dialog controls inside a single X window, so no X query can say
    which field holds the caret. A picture can.
    """
    if not shutil.which("gnome-screenshot"):
        return None
    try:
        from PIL import Image
    except ImportError:
        return None
    geom = {}
    for line in xdotool("getwindowgeometry", "--shell", win).splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            geom[k.strip()] = v.strip()
    try:
        gx, gy = int(geom["X"]), int(geom["Y"])
        gw, gh = int(geom["WIDTH"]), int(geom["HEIGHT"])
    except (KeyError, ValueError):
        return None
    full = Path(tempfile.mkstemp(suffix=".png")[1])
    try:
        subprocess.run(["gnome-screenshot", "--file", str(full)], capture_output=True)
        if not full.stat().st_size:
            return None
        im = Image.open(full)
        pad = 10
        im.crop((max(0, gx - pad), max(0, gy - pad),
                 min(im.width, gx + gw + pad),
                 min(im.height, gy + gh + pad))).save(dest)
        return dest
    except (OSError, ValueError):
        return None
    finally:
        full.unlink(missing_ok=True)


def process_command_lines() -> list[tuple[int, str]]:
    out = subprocess.run(["ps", "-eo", "pid=,args="], capture_output=True,
                         text=True).stdout
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        pid, _, args = line.partition(" ")
        try:
            rows.append((int(pid), args.strip()))
        except ValueError:
            pass
    return rows


def launcher_exe(p: Protocol, tmpl: str) -> str:
    """The program a launcher command runs, for the 'is it installed' check.

    {exe} is substituted whole rather than through shlex: a Windows-style path
    under Wine ("Program Files/Radmin Viewer 3") contains spaces and would
    otherwise be split into fragments that exist nowhere.
    """
    tmpl = tmpl.strip()
    if tmpl.startswith("{exe}"):
        return p.exe
    try:
        return shlex.split(tmpl)[0]
    except (ValueError, IndexError):
        return ""


def classify_process_protocol(args: str, protos: dict[str, Protocol] | None = None) -> Protocol | None:
    """Which protocol a command line represents, from each detect.process regex."""
    # A shell invoked with -c carries its whole script in argv, so a command that
    # merely mentions a host or a .rdp path would otherwise register as a session.
    if re.match(r"^\S*(ba|z|k)?sh\s+-c\b", args):
        return None
    # Thincast execs into "rdc <path>.rdp" inside its flatpak sandbox; bwrap is
    # the sandbox wrapper around the same argv, so counting it would double rows.
    if "bwrap" in args:
        return None
    for p in (protos or load_protocols()).values():
        if p.detect_process and re.search(p.detect_process, args):
            return p
    return None


@dataclass
class Session:
    """One live remote session, matched back to a saved connection when possible."""
    proto: str      # protocol label as configured, e.g. "RDP"
    label: str      # connection sel, or best-effort name when unmatched
    host: str
    pid: int
    window: str = ""   # X11 window id, empty when none was found


def sessions() -> list[Session]:
    """Live sessions from any configured launcher, matched back to connections."""
    out: list[Session] = []
    by_path = {str(c.path): c for c in conns_cached()}
    seen: set[tuple[str, str, str]] = set()

    try:
        protos = load_protocols()
    except ConfigError:
        return out
    mine = {os.getpid(), os.getppid()}
    for pid, args in process_command_lines():
        if pid in mine:
            continue
        p = classify_process_protocol(args, protos)
        if not p:
            continue
        proto = p.label

        # Match the full .rdp path as a substring. A regex like (\S+\.rdp) breaks
        # the moment a connection is named "Line 1.rdp" -- it captures "1.rdp".
        c = next((cand for cand in by_path.values() if str(cand.path) in args), None)
        if c is None:
            # Fall back to matching the host anywhere in the command line.
            for cand in conns_cached():
                if cand.host and re.search(rf"(?<![\d.]){re.escape(cand.host)}(?![\d.])", args):
                    c = cand
                    break
        if c is not None:
            host, label = c.host, c.sel
        else:
            m = re.search(r"(\S+\.rdp)", args)
            host = ""
            label = Path(m.group(1)).stem if m else "?"

        key = (proto, label, host)
        if key in seen:
            continue
        seen.add(key)

        win = ""
        if host:
            pattern = (p.detect_window or "{host}").format(host=host, name=label)
            for w in xdotool("search", "--name", pattern).splitlines():
                if w.strip():
                    win = w.strip()
                    break
        out.append(Session(proto, label, host, pid, win))

    # Stable, meaningful order: follow the saved list, then protocol. next/prev
    # would otherwise jump around, since ps order is not guaranteed.
    order = {c.sel: i for i, c in enumerate(conns_cached())}
    out.sort(key=lambda s: (order.get(s.label, 10_000), s.proto, s.pid))
    return out


def active_sels() -> dict[str, list[str]]:
    """{connection sel: [protocols currently connected]} -- for the GUI highlight."""
    live: dict[str, list[str]] = {}
    for s in sessions():
        live.setdefault(s.label, [])
        if s.proto not in live[s.label]:
            live[s.label].append(s.proto)
    return live


def focus_session(s: Session) -> bool:
    if s.window:
        xdotool("windowactivate", "--sync", s.window)
        return True
    return False


def kill_session(s: Session) -> None:
    try:
        os.kill(s.pid, 15)
    except ProcessLookupError:
        pass


# --------------------------------------------------------------------------- #
# CSV import / export
# --------------------------------------------------------------------------- #
CSV_FIELDS = ["group", "name", "host", "username", "port"]


def csv_fields() -> list[str]:
    """Every column a full export writes, so it can be imported back unchanged.

    Per-protocol ports get a port_<id> column each, generated from the registry
    rather than listed, so a new protocol needs no change here.
    """
    extra = [f"port_{pid}" for pid in protocol_ids() if pid != "rdp"]
    return CSV_FIELDS + extra + ["protocols", "default_protocol", "shortcut"]


def export_csv(dest: Path, conns: list[Conn] | None = None) -> int:
    dest.parent.mkdir(parents=True, exist_ok=True)
    rows = conns if conns is not None else conns_cached(refresh=True)
    fields = csv_fields()
    keys = session_bindings()
    with dest.open("w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=fields)
        w.writeheader()
        for c in rows:
            row = {"group": c.group, "name": c.name, "host": c.host,
                   "username": c.username, "port": c.port,
                   "protocols": ",".join(c.protocols),
                   "default_protocol": c.default_protocol,
                   "shortcut": keys.get(c.sel, "")}
            for f in fields:
                if f.startswith("port_"):
                    row[f] = c.port_for(f[5:])
            w.writerow(row)
    return len(rows)


def export_rdp_files(conns: list[Conn], dest_dir: Path) -> int:
    """Copy the selected .rdp files out, keeping their group folders."""
    dest_dir.mkdir(parents=True, exist_ok=True)
    n = 0
    for c in conns:
        target = (dest_dir / c.group) if c.group else dest_dir
        target.mkdir(parents=True, exist_ok=True)
        shutil.copy2(c.path, target / c.path.name)
        n += 1
    return n


def import_csv(src: Path, overwrite: bool = False,
               dry_run: bool = False) -> tuple[list[str], list[str]]:
    """Returns (created, skipped) as human-readable lines."""
    created, skipped = [], []
    with src.open(newline="") as fh:
        reader = csv.DictReader(fh)
        missing = {"name", "host"} - set(reader.fieldnames or [])
        if missing:
            raise SystemExit(f"CSV missing required column(s): {', '.join(sorted(missing))}")
        for i, row in enumerate(reader, start=2):
            name = (row.get("name") or "").strip()
            host = (row.get("host") or "").strip()
            if not name or not host:
                skipped.append(f"line {i}: blank name or host")
                continue
            group = (row.get("group") or "").strip()
            user = (row.get("username") or "").strip()
            try:
                port = int((row.get("port") or "3389").strip() or 3389)
            except ValueError:
                skipped.append(f"line {i}: bad port {row.get('port')!r}")
                continue
            if re.search(r"[/\\]", name) or "\\" in group:
                skipped.append(f"line {i}: '/' is only allowed in group, to nest it")
                continue
            if group.startswith("/") or ".." in group.split("/"):
                skipped.append(f"line {i}: group must be a relative path")
                continue
            target = (RDP_DIR / group / f"{name}.rdp") if group else RDP_DIR / f"{name}.rdp"
            if target.exists() and not overwrite:
                skipped.append(f"{group}/{name}: already exists")
                continue
            ports = {}
            for col, val in row.items():
                if col and col.startswith("port_") and (val or "").strip():
                    try:
                        ports[col[5:]] = int(val.strip())
                    except ValueError:
                        pass
            protos = (row.get("protocols") or "").strip()
            if dry_run:
                created.append(f"{group}/{name} -> {host}:{port} (dry run)")
                continue
            write_rdp(group, name, host, user, port, overwrite=True,
                      ports=ports, protocols=protos,
                      default_proto=(row.get("default_protocol") or "").strip())
            binding = (row.get("shortcut") or "").strip()
            if binding:
                g, sess = load_shortcuts()
                sess[f"{group}/{name}" if group else name] = binding
                save_shortcuts(g, sess)
            created.append(f"{group}/{name} -> {host}:{port}")
    conns_cached(refresh=True)
    return created, skipped


# --------------------------------------------------------------------------- #
# Radmin phonebook export (experimental, never writes the live phonebook)
# --------------------------------------------------------------------------- #
# The .rpb is a fixed-stride record file: a small header, then N records of
# equal size (the stride is stored in the header at 0x0c, the count at 0x00).
# It is 99% zero padding, with UTF-16LE strings at fixed offsets inside each
# record. We clone real records as templates and patch only those strings.
PB_OFF_HOST = 4904
PB_OFF_NAME = 5104
PB_OFF_USER = 5908
PB_FIELD_CAP = 128  # bytes; conservative, verified against the live file


def phonebook_layout(raw: bytes) -> tuple[int, int, int]:
    count = int.from_bytes(raw[0:4], "little")
    stride = int.from_bytes(raw[12:16], "little")
    if not stride or count <= 0:
        raise RuntimeError("unrecognised phonebook header")
    header = len(raw) - count * stride
    if header < 0 or header > stride:
        raise RuntimeError(
            f"phonebook layout does not add up (size={len(raw)} count={count} stride={stride})")
    return header, stride, count


def phonebook_patch_string(rec: bytearray, off: int, value: str, marker: str = "") -> None:
    """Write a UTF-16LE string at off, optionally followed by a packed marker.

    Folder records store their type string ("folder") immediately after the name's
    terminator, so its position shifts with the name length -- it is packed, not at
    a fixed offset. Zeroing a flat span without rewriting it destroys the marker and
    Radmin stops seeing the record as a folder.
    """
    enc = value.encode("utf-16-le") + b"\x00\x00"
    if marker:
        enc += marker.encode("utf-16-le") + b"\x00\x00"
    if len(enc) > PB_FIELD_CAP:
        raise RuntimeError(f"value too long for phonebook field: {value!r}")
    rec[off:off + PB_FIELD_CAP] = b"\x00" * PB_FIELD_CAP
    rec[off:off + len(enc)] = enc


def export_phonebook(dest: Path, conns: list[Conn] | None = None,
                     source: Path | None = None) -> int:
    if source is None:
        pb = protocol("radmin").extras.get("phonebook", "")
        if not pb:
            raise RuntimeError(f"{PROTOCOLS_FILE} [protocol:radmin] has no "
                               "phonebook path; the export needs one as a "
                               "structural template")
        src = Path(pb)
    else:
        src = source
    if not src.is_file():
        raise RuntimeError(f"no source phonebook to use as a template: {src}")
    if dest.resolve() == src.resolve():
        raise RuntimeError("refusing to overwrite the live phonebook")
    raw = src.read_bytes()
    header_len, stride, count = phonebook_layout(raw)
    recs = [raw[header_len + i * stride: header_len + (i + 1) * stride]
            for i in range(count)]

    # A host record has an IP at PB_OFF_HOST; anything else is a folder record.
    def is_host(r: bytes) -> bool:
        s = r[PB_OFF_HOST:PB_OFF_HOST + 64].decode("utf-16-le", "ignore").split("\x00")[0]
        return bool(re.match(r"^[0-9]{1,3}(\.[0-9]{1,3}){3}$|^[A-Za-z]", s)) and bool(s)

    host_tpl = next((r for r in recs if is_host(r)), None)
    if host_tpl is None:
        raise RuntimeError("no host record found to use as a template")
    folder_tpl = next((r for r in recs if not is_host(r)), None)

    conns = conns if conns is not None else conns_cached(refresh=True)
    out_recs: list[bytes] = []
    for g in sorted({c.group for c in conns if c.group}):
        if folder_tpl is not None:
            fr = bytearray(folder_tpl)
            phonebook_patch_string(fr, PB_OFF_NAME, g, marker="folder")
            out_recs.append(bytes(fr))
    for c in conns:
        r = bytearray(host_tpl)
        phonebook_patch_string(r, PB_OFF_HOST, c.host)
        phonebook_patch_string(r, PB_OFF_NAME, c.name)
        phonebook_patch_string(r, PB_OFF_USER, c.username)
        out_recs.append(bytes(r))

    head = bytearray(raw[:header_len])
    head[0:4] = len(out_recs).to_bytes(4, "little")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(bytes(head) + b"".join(out_recs))
    return len(out_recs)


# --------------------------------------------------------------------------- #
# UI state (layout + pinned tabs) and config health
# --------------------------------------------------------------------------- #
@help_topic("layouts", "Window layouts", ("rail", "spotlight", "cockpit",
            "inspector", "classic", "layout menu"), section="The window")
def load_ui_state() -> dict:
    """The manager offers five switchable window layouts.

    Rail (the default) pairs a group sidebar with the connection list; Spotlight
    is a filter-first flat list; Cockpit leads with live-session cards;
    Inspector is a read-only audit of credentials and configuration health;
    Classic is the original window, kept for continuity.

    The choice is saved as `layout =` in ui.conf and survives restarts, as do
    the pinned filter tabs, which are shared by every layout.
    """
    state = {"layout": "rail", "tabs": [], "editor": ""}
    if not UI_CONF.is_file():
        return state
    parser = configparser.ConfigParser(inline_comment_prefixes=(";",))
    parser.optionxform = str
    parser.read(UI_CONF)
    layout = parser.get("ui", "layout", fallback="rail").strip().lower()
    state["layout"] = layout if layout in LAYOUTS else "rail"
    if parser.has_section("tabs"):
        for _key, raw in sorted(parser.items("tabs")):
            parts = (raw.split("|") + ["", "", ""])[:3]
            if parts[0].strip():
                state["tabs"].append(tuple(part.strip() for part in parts))
    state["editor"] = parser.get("help", "editor", fallback="").strip()
    return state


def save_ui_state(state: dict) -> None:
    """Rewrite ui.conf. Header comments come from the documented default."""
    header, _, _ = DEFAULT_CONFIGS["ui.conf"].partition("[ui]")
    lines = [header.rstrip("\n"), "", "[ui]",
             f"layout = {state.get('layout', 'rail')}", "", "[tabs]"]
    for index, (label, group, text) in enumerate(state.get("tabs", []), start=1):
        lines.append(f"tab.{index} = {label}|{group}|{text}")
    lines += ["", "[help]", f"editor = {state.get('editor', '')}"]
    UI_CONF.write_text("\n".join(lines) + "\n")


@dataclass
class HealthWarning:
    """One actionable configuration problem, shown wherever health surfaces."""
    warning_id: str
    message: str          # human sentence, ready for the status bar
    setup_section: str    # which Setup card fixes it: protocols|credentials|shortcuts
    severity: str = "warning"   # "warning" | "error"


def connection_password_state(c: Conn, proto: str = "") -> tuple[str, str]:
    """Where a connection's password would come from: its credential fate.

    Returns (state, scope): state is "own" (a keyring entry for exactly this
    connection), "inherited" (found further up the chain — scope names the rung,
    e.g. "Plant" or "DEFAULT"), or "none" (nothing anywhere: connecting will
    prompt inside the client).
    """
    table = creds_conf_table()
    for key in creds_chain(c.sel, proto):
        entry = table.get(key)
        if secret_get(key) or (entry and entry[1] and entry[1] != "CHANGEME"):
            scope = key.split("@")[0]
            return ("own" if scope == c.sel else "inherited"), key
    return "none", ""


@help_topic("config-health", "Configuration health", ("warnings", "setup badge",
            "status bar", "broken config"), section="Setup")
def config_health() -> list[HealthWarning]:
    """Broken or incomplete configuration warns — it never blocks the window.

    Problems surface in four places, all fed by this one check: the status bar
    at the bottom of the manager, the badge on the Setup entry, the Inspector
    layout's per-row columns, and warning banners on the Setup page itself.

    Checked: protocols.conf parses; each protocol's exe exists when set; each
    protocol can detect its sessions (detect.process); a DEFAULT credential
    exists so unmatched connections have a password; and how many connections
    would prompt because nothing on their credential chain has one.
    """
    warnings: list[HealthWarning] = []
    try:
        registry = load_protocols()
    except ConfigError as broken:
        return [HealthWarning("protocols-broken", str(broken), "protocols", "error")]

    for proto in registry.values():
        if proto.exe and not Path(proto.exe).is_file():
            warnings.append(HealthWarning(
                f"exe-missing-{proto.id}",
                f"{proto.id}: exe not found — {proto.exe}", "protocols"))
        if not proto.detect_process:
            warnings.append(HealthWarning(
                f"no-detect-{proto.id}",
                f"{proto.id}: no detect.process — its sessions won't be seen",
                "protocols"))
        if not proto.launchers:
            warnings.append(HealthWarning(
                f"no-launchers-{proto.id}",
                f"{proto.id}: no launcher commands configured", "protocols"))

    default_entry = creds_conf_table().get("DEFAULT")
    if not (secret_get("DEFAULT") or (default_entry and default_entry[1])):
        warnings.append(HealthWarning(
            "no-default-credential",
            "creds.conf: no DEFAULT entry — connections without a group password "
            "will prompt every time", "credentials"))

    unresolved = [c.sel for c in conns_cached()
                  if connection_password_state(c)[0] == "none"]
    if unresolved and len(unresolved) < len(conns_cached()):
        warnings.append(HealthWarning(
            "connections-without-password",
            f"{len(unresolved)} connection(s) have no password on their chain "
            "and will prompt", "credentials"))
    return warnings


# --------------------------------------------------------------------------- #
# window focus / shortcuts
# --------------------------------------------------------------------------- #
GUI_TITLE = "Remote Connections"
DCONF_ROOT = "/org/cinnamon/desktop/keybindings/custom-keybindings"
GS_LIST = "org.cinnamon.desktop.keybindings"
GS_ITEM = "org.cinnamon.desktop.keybindings.custom-keybinding"


def notify(msg: str) -> None:
    """Desktop notification -- shortcuts run detached, so stdout goes nowhere."""
    subprocess.run(["notify-send", "-a", "Remote Connections", "-t", "2500",
                    "Remote Connections", msg], capture_output=True)


def gui_window() -> str:
    for w in xdotool("search", "--name", f"^{GUI_TITLE}$").splitlines():
        if w.strip():
            return w.strip()
    return ""


def focus_gui() -> str:
    """Raise the manager, starting it if it isn't running."""
    win = gui_window()
    if win:
        xdotool("windowactivate", "--sync", win)
        return "focused the manager"
    spawn_detached([sys.executable, str(Path(__file__).resolve()), "gui"])
    return "starting the manager"


def goto(sel: str) -> str:
    """Focus a connection's live session, or connect it if there isn't one."""
    c = find(sel)
    if not c:
        return f"no such connection: {sel}"
    for s in sessions():
        if s.label == sel and s.window:
            xdotool("windowactivate", "--sync", s.window)
            return f"focused {sel} ({s.proto})"
    proto = c.default_protocol
    try:
        return launch(c, proto)
    except RuntimeError as e:
        return f"{sel}: {e}"


def step_session(delta: int) -> str:
    """Focus the next/previous active session, relative to the focused window."""
    # Only windowed sessions can be focused. Including the others would park the
    # cycle on an entry it can never move off, so skip them entirely.
    ss = [s for s in sessions() if s.window]
    if not ss:
        return "no active sessions to focus"
    cur = xdotool("getwindowfocus")
    idx = next((i for i, s in enumerate(ss) if s.window == cur), None)
    if idx is None:
        # Nothing of ours focused: Super+W starts at the top, Super+Q at the end.
        idx = -1 if delta > 0 else 0
    nxt = ss[(idx + delta) % len(ss)]
    focus_session(nxt)
    return f"focused {nxt.label} ({nxt.proto})"


# "cycle" is deliberately not here any more: next/prev raise the switcher
# themselves, so a separate popup binding would just be a second way in.
GLOBAL_ACTIONS = (("focus", "Raise the manager"),
                  ("next", "Next active session"),
                  ("prev", "Previous active session"))

SWITCH_PIDFILE = Path.home() / ".cache" / "rcm-switcher.pid"


def switcher_pid() -> int:
    """Pid of a running switcher, or 0.

    Cinnamon's keybinding is a passive X grab that still fires while our popup
    holds its own grab, so a repeat press launches a *second* rcm. That process
    must drive the popup already on screen rather than exit -- otherwise the
    selection never moves, which is exactly how this failed the first time.
    """
    try:
        pid = int(SWITCH_PIDFILE.read_text().strip())
    except (OSError, ValueError):
        return 0
    if pid == os.getpid():
        return 0
    try:
        os.kill(pid, 0)
    except OSError:
        return 0
    return pid


def session_bindings() -> dict[str, str]:
    """{connection sel: binding} -- for showing keys in the manager."""
    return {k: v for k, v in load_shortcuts()[1].items() if v}


def save_shortcuts(globals_: dict[str, str], per_session: dict[str, str]) -> None:
    """Rewrite shortcuts.conf. Managed file, so the header is regenerated too."""
    L = [
        "# System-wide keyboard shortcuts.",
        "#",
        "# Edited from the manager (menu -> Keyboard shortcuts...) or by hand.",
        "# Run `rcm shortcuts install` after editing by hand.",
        "#",
        "# Binding syntax is Cinnamon's: <Super> <Ctrl> <Alt> <Shift> plus a key,",
        "# e.g. <Super>r, <Super><Alt>1, <Super>grave.",
        "",
        "[global]",
    ]
    for key, desc in GLOBAL_ACTIONS:
        val = globals_.get(key, "").strip()
        L.append(f"# {desc}")
        L.append(f"{key} = {val}")
    L += ["", "[sessions]",
          "# Focuses the connection if a session is live, otherwise connects it."]
    for sel, binding in per_session.items():
        L.append(f"{sel} = {binding.strip()}")
    SHORTCUTS.write_text("\n".join(L) + "\n")


def load_shortcuts() -> tuple[dict[str, str], dict[str, str]]:
    """(global_bindings, per_session_bindings) from shortcuts.conf."""
    cp = configparser.ConfigParser()
    cp.optionxform = str  # connection names are case-sensitive
    if SHORTCUTS.is_file():
        cp.read(SHORTCUTS)
    g = dict(cp.items("global")) if cp.has_section("global") else {}
    s = dict(cp.items("sessions")) if cp.has_section("sessions") else {}
    return g, s


def run_gsettings(*args: str) -> str:
    return subprocess.run(["gsettings", *args], capture_output=True, text=True).stdout.strip()


def _binding_conflicts(binding: str) -> list[str]:
    """Existing Cinnamon bindings that already use this combo."""
    out = []
    for schema in ("org.cinnamon.desktop.keybindings.wm",
                   "org.cinnamon.desktop.keybindings.media-keys",
                   "org.cinnamon.muffin.keybindings"):
        for line in run_gsettings("list-recursively", schema).splitlines():
            if f"'{binding}'" in line:
                out.append(" ".join(line.split()[:2]))
    return out


def shortcut_specs() -> list[tuple[str, str, str, str]]:
    """(id, name, command, binding) for everything in shortcuts.conf."""
    me = str(Path(__file__).resolve())
    g, s = load_shortcuts()
    specs: list[tuple[str, str, str, str]] = []
    for action, desc in GLOBAL_ACTIONS:
        if g.get(action):
            specs.append((f"rcm-{action}", f"rcm: {desc.lower()}",
                          f"{me} {action}", g[action]))
    for sel, binding in s.items():
        if not binding:
            continue
        specs.append((f"rcm-goto-{slugify(sel)}", f"rcm: {sel}",
                      f"{me} goto {shlex.quote(sel)}", binding))
    return specs


def shortcuts_install() -> tuple[int, list[str]]:
    specs = shortcut_specs()
    warnings = []
    for _id, _name, _cmd, binding in specs:
        for conflict in _binding_conflicts(binding):
            warnings.append(f"{binding} is already used by {conflict}")
    current = parse_gsettings_list(run_gsettings("get", GS_LIST, "custom-list"))
    keep = [i for i in current if not i.startswith("rcm-")]
    ids = [s[0] for s in specs]
    # Clear rcm- entries that are no longer configured, or removing a shortcut
    # would leave its Cinnamon binding live and still firing.
    for stale in [i for i in current if i.startswith("rcm-") and i not in ids]:
        subprocess.run(["dconf", "reset", "-f", f"{DCONF_ROOT}/{stale}/"],
                       capture_output=True)
    for _id, name, cmd, binding in specs:
        path = f"{DCONF_ROOT}/{_id}/"
        run_gsettings("set", f"{GS_ITEM}:{path}", "name", name)
        run_gsettings("set", f"{GS_ITEM}:{path}", "command", cmd)
        run_gsettings("set", f"{GS_ITEM}:{path}", "binding", "['" + binding + "']")
    run_gsettings("set", GS_LIST, "custom-list", str(keep + ids).replace('"', "'"))
    return len(specs), warnings


def shortcuts_remove() -> int:
    current = parse_gsettings_list(run_gsettings("get", GS_LIST, "custom-list"))
    mine = [i for i in current if i.startswith("rcm-")]
    for _id in mine:
        subprocess.run(["dconf", "reset", "-f", f"{DCONF_ROOT}/{_id}/"],
                       capture_output=True)
    keep = [i for i in current if not i.startswith("rcm-")]
    run_gsettings("set", GS_LIST, "custom-list", str(keep).replace('"', "'"))
    return len(mine)


def parse_gsettings_list(raw: str) -> list[str]:
    raw = raw.strip()
    if not raw or raw in ("@as []", "[]"):
        return []
    return [p.strip().strip("'\"") for p in raw.strip("[]").split(",") if p.strip()]


# --------------------------------------------------------------------------- #
# .desktop jump list
# --------------------------------------------------------------------------- #
ICON_NAME = "network-computing-hub"
ICON_SVG = APP / "assets" / f"{ICON_NAME}.svg"
ICON_SVG_SMALL = APP / "assets" / f"{ICON_NAME}-small.svg"
ICON_THEME_DIR = Path.home() / ".local/share/icons/hicolor"
# Below 48px the detailed icon turns to mush, so the simplified variant is used
# there -- that is exactly what per-size directories in an icon theme are for.
ICON_SMALL_UPTO = 32
ICON_SIZES = (16, 22, 24, 32, 48, 64, 128, 256)


def icon_installed() -> bool:
    return (ICON_THEME_DIR / "scalable/apps" / f"{ICON_NAME}.svg").is_file()


def install_icon() -> list[str]:
    """Install the app icon into the user's hicolor theme."""
    if not ICON_SVG.is_file():
        raise RuntimeError(f"missing {ICON_SVG}")
    written = []
    scalable = ICON_THEME_DIR / "scalable/apps"
    scalable.mkdir(parents=True, exist_ok=True)
    shutil.copy2(ICON_SVG, scalable / f"{ICON_NAME}.svg")
    written.append(str(scalable / f"{ICON_NAME}.svg"))

    try:
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
    except Exception:
        return written  # SVG alone still works wherever librsvg is available

    for size in ICON_SIZES:
        src = ICON_SVG_SMALL if (size <= ICON_SMALL_UPTO
                                 and ICON_SVG_SMALL.is_file()) else ICON_SVG
        out = ICON_THEME_DIR / f"{size}x{size}/apps"
        out.mkdir(parents=True, exist_ok=True)
        dest = out / f"{ICON_NAME}.png"
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(src), size, size)
            pb.savev(str(dest), "png", [], [])
            written.append(str(dest))
        except Exception:
            continue
    subprocess.run(["gtk-update-icon-cache", "-f", "-t", str(ICON_THEME_DIR)],
                   capture_output=True)
    return written


def slugify(s: str) -> str:
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9-]", "-", s.lower())).strip("-")


def quote_exec_argument(s: str) -> str:
    """Quote one Exec= argument per the Desktop Entry spec.

    Connection names may contain spaces ("Line 1.rdp"); unquoted, the launcher
    splits them into separate arguments and the connection silently fails to open.
    desktop-file-validate does not flag this.
    """
    if not re.search(r"""[\s"'\\$`<>~|&;*?#()]""", s):
        return s
    esc = (s.replace("\\", "\\\\").replace('"', '\\"')
            .replace("`", "\\`").replace("$", "\\$"))
    return f'"{esc}"'


def gen_launcher() -> int:
    me = Path(__file__).resolve()
    # The .desktop is about to reference the icon by name, so make sure it exists.
    if not icon_installed():
        try:
            install_icon()
        except Exception:
            pass
    cs = conns_cached(refresh=True)
    gs = groups()   # every level, so a nested tree still gets jump-list entries
    actions = ([slugify(c.sel) for c in cs[:MAX_JUMPLIST]]
               + [f"all-{slugify(g)}" for g in gs] + ["switcher"])
    L = ["[Desktop Entry]", "Type=Application", "Name=Remote Connections",
         f"Comment=RDP, VNC and Radmin sessions from {RDP_DIR}",
         f"Exec={me} gui", f"Icon={ICON_NAME}", "Terminal=false",
         "Categories=Network;RemoteAccess;", "StartupNotify=false",
         # Without this the panel cannot match a running window (WM_CLASS "rcm")
         # to this launcher, and shows a generic icon for it instead.
         "StartupWMClass=rcm"]
    # An empty "Actions=;" is a validation error, so omit it when nothing is listed.
    if actions:
        L.append("Actions=" + ";".join(actions) + ";")
    for c in cs[:MAX_JUMPLIST]:
        L += ["", f"[Desktop Action {slugify(c.sel)}]",
              f"Name={c.sel.replace('_', ' ').replace('/', ' / ')}",
              # Absolute paths only -- Exec= does not expand ~ and fails silently.
              f"Exec={quote_exec_argument(str(me))} connect {quote_exec_argument(c.sel)}"]
    for g in gs:
        L += ["", f"[Desktop Action all-{slugify(g)}]", f"Name=Connect all ({g})",
              f"Exec={quote_exec_argument(str(me))} connect-all {quote_exec_argument(g)}"]
    L += ["", "[Desktop Action switcher]", "Name=Switch active session...",
          f"Exec={me} cycle"]
    DESKTOP_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = DESKTOP_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(L) + "\n")
    tmp.chmod(0o644)
    tmp.replace(DESKTOP_FILE)
    subprocess.run(["update-desktop-database", str(DESKTOP_FILE.parent)],
                   capture_output=True)
    return len(cs)


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
USAGE = """rcm -- remote connection manager

  rcm init                       write any missing config file from its default
  rcm list                       list connections
  rcm sessions                   show active sessions (RDP / VNC / Radmin)
  rcm connect <sel> [--<protocol>] [--via <launcher>]
  rcm connect-all <group> [--<protocol>] [--via <launcher>]
  rcm protocols                  show configured protocols and their programs
  rcm detect <protocol> [--write]    find a protocol's exe and record it
  rcm creds list|set|clear|migrate   credentials (passwords live in the keyring)
  rcm gui                        open the manager window
  rcm focus                      raise the manager (starts it if needed)
  rcm cycle                      Alt-Tab-style switcher over active sessions
  rcm next | rcm prev            focus the next/previous active session
  rcm goto <sel>                 focus that session, or connect it if it isn't up
  rcm shortcuts list|install|remove   system-wide keys, from shortcuts.conf
  rcm calibrate <sel> [proto]    open a credential prompt, report it, type nothing
  rcm import <file.csv> [--overwrite] [--dry-run]
  rcm export [file.csv]          default: export/connections.csv
  rcm phonebook [out.rpb]        experimental Radmin phonebook (never overwrites live)
  rcm gen-launcher               rebuild the .desktop jump list
  rcm install-icon               install the app icon into your icon theme
"""


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    cmd, rest = argv[0], argv[1:]

    # Report, don't write: the CLI should not create files behind your back. The
    # GUI does write them, because that is a deliberate first-run setup step.
    if cmd not in ("init", "gui"):
        gone = missing_configs()
        if gone:
            print(f"rcm: missing config: {', '.join(gone)}\n"
                  f"     create them with `rcm init` (or open the manager once)",
                  file=sys.stderr)

    if cmd == "init":
        written = write_default_configs()
        for name in written:
            print(f"  created {APP / name}")
        print(f"{len(written)} file(s) created" if written else "nothing missing")
        return 0

    if cmd == "list":
        for c in conns_cached():
            print(f"{c.sel:24} {c.host:16} {c.username or '-':12} :{c.port}")
        return 0

    if cmd == "sessions":
        ss = sessions()
        if not ss:
            print("no active sessions")
        for s in ss:
            print(f"{s.proto:7} {s.label:22} {s.host:16} pid={s.pid} win={s.window or '-'}")
        return 0

    if cmd in ("connect", "connect-all"):
        # Any configured protocol is a flag: --rdp, --vnc, --radmin, --anydesk...
        ids = protocol_ids()
        proto = ids[0] if ids else ""
        for pid in ids:
            if f"--{pid}" in rest:
                proto = pid
                rest = [a for a in rest if a != f"--{pid}"]
        via = ""
        if "--via" in rest:
            i = rest.index("--via")
            if i + 1 >= len(rest):
                print("--via needs a launcher name", file=sys.stderr)
                return 2
            via = rest[i + 1]
            rest = rest[:i] + rest[i + 2:]
        if not rest:
            flags = "|".join(f"--{i}" for i in ids) or "--<protocol>"
            print(f"usage: rcm {cmd} <{'group' if cmd=='connect-all' else 'group/name'}>"
                  f" [{flags}] [--via <launcher>]", file=sys.stderr)
            return 2

        if cmd == "connect":
            c = find(rest[0])
            if not c:
                print(f"no such connection: {rest[0]}", file=sys.stderr)
                return 1
            targets = [c]
        else:
            targets = group_members(rest[0])
            if not targets:
                print(f"group '{rest[0]}' has no connections", file=sys.stderr)
                return 1

        rc = 0
        for i, c in enumerate(targets):
            if i:
                time.sleep(2)
            try:
                msg = launch(c, proto, via)
                if msg:
                    print(msg)
            except RuntimeError as e:
                print(f"rcm: {e}", file=sys.stderr)
                rc = 1
        return rc

    if cmd in ("protocols", "launchers"):
        try:
            protos = load_protocols()
        except ConfigError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        for p in protos.values():
            bits = [f"port {p.port}" if p.port else "", f"colour {p.color}",
                    "types credentials" if p.injects else ""]
            print(f"[{p.id}] {p.label}  ({', '.join(b for b in bits if b)})")
            if p.exe:
                mark = "" if Path(p.exe).is_file() else "   <-- does not exist"
                print(f"    exe {p.exe}{mark}")
            for nm, tmpl in p.launchers.items():
                star = "*" if nm == p.default else " "
                exe0 = launcher_exe(p, tmpl)
                have = "" if (exe0 and (shutil.which(exe0) or Path(exe0).is_file())) \
                    else "   (not installed)"
                print(f"  {star} {nm:12} {tmpl}{have}")
        return 0

    if cmd == "detect":
        if not rest:
            print("usage: rcm detect <protocol> [--write]", file=sys.stderr)
            return 2
        try:
            p = protocol(rest[0])
        except ConfigError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        found = protocol_detect(p)
        if not found:
            print(f"no {Path(p.exe).name if p.exe else p.id} found", file=sys.stderr)
            return 1
        print(f"{p.label} installs found, best first:")
        for i, f in enumerate(found):
            print(f"  [{i}] {f}")
        if "--write" not in rest:
            print(f"\nre-run with --write to put [0] into {PROTOCOLS_FILE}")
            return 0
        protos = load_protocols()
        protos[p.id].exe = str(found[0])
        parts = found[0].parts
        if "drive_c" in parts:
            protos[p.id].env["WINEPREFIX"] = str(Path(*parts[:parts.index("drive_c")]))
        save_protocols(protos)
        print(f"\nwrote exe={found[0]} to {PROTOCOLS_FILE}")
        return 0

    if cmd == "creds":
        sub = rest[0] if rest else "list"
        if sub == "list":
            print(f"keyring: {'available' if keyring_available() else 'NOT AVAILABLE'}")
            table = creds_conf_table()
            keys = sorted(set(table) | {"DEFAULT"})
            for k in keys:
                u = table.get(k, ("", ""))[0]
                legacy = table.get(k, ("", ""))[1]
                where = ("keyring" if secret_get(k) else
                         "PLAINTEXT in creds.conf" if legacy else "not set")
                print(f"  {k:16} user={u or '(from .rdp)':14} password: {where}")
            return 0
        if sub == "set":
            if len(rest) < 2:
                print("usage: rcm creds set <key>", file=sys.stderr)
                return 2
            if not keyring_available():
                print("rcm: no keyring available", file=sys.stderr)
                return 1
            pw = getpass.getpass(f"password for {rest[1]} (not echoed): ")
            if not pw:
                print("aborted, nothing stored")
                return 1
            print("stored in keyring" if secret_set(rest[1], pw) else "store failed")
            return 0
        if sub == "clear":
            if len(rest) < 2:
                print("usage: rcm creds clear <key>", file=sys.stderr)
                return 2
            print("cleared" if secret_clear(rest[1]) else "nothing to clear")
            return 0
        if sub == "migrate":
            try:
                moved, skipped = creds_migrate()
            except RuntimeError as e:
                print(f"rcm: {e}", file=sys.stderr)
                return 1
            print(f"{moved} password(s) moved into the keyring, {skipped} left alone")
            if moved:
                print(f"{CREDS} now holds only key|username -- no secrets")
            return 0
        print(f"unknown creds subcommand: {sub}", file=sys.stderr)
        return 2

    if cmd == "import":
        if not rest:
            print("usage: rcm import <file.csv> [--overwrite] [--dry-run]", file=sys.stderr)
            return 2
        created, skipped = import_csv(Path(rest[0]).expanduser(),
                                      overwrite="--overwrite" in rest,
                                      dry_run="--dry-run" in rest)
        for line in created:
            print("  +", line)
        for line in skipped:
            print("  -", line)
        print(f"{len(created)} created, {len(skipped)} skipped")
        if created and "--dry-run" not in rest:
            gen_launcher()
        return 0

    if cmd == "export":
        dest = Path(rest[0]).expanduser() if rest else EXPORT_DIR / "connections.csv"
        n = export_csv(dest)
        print(f"{n} connection(s) -> {dest}")
        return 0

    if cmd == "phonebook":
        dest = Path(rest[0]).expanduser() if rest else EXPORT_DIR / "radmin.rpb"
        try:
            n = export_phonebook(dest)
        except RuntimeError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        print(f"{n} record(s) -> {dest}")
        print("EXPERIMENTAL. Test without touching your real phonebook:")
        try:
            p = protocol("radmin")
            env = " ".join(f'{k}="{v}"' for k, v in p.env.items())
            print(f'  {env} "{p.exe}" /pbpath:"{dest}"'.strip())
        except ConfigError:
            print(f'  <radmin exe> /pbpath:"{dest}"')
        return 0

    if cmd == "calibrate":
        # Opens a protocol's credential prompt, reports exactly what it is, and
        # types nothing. Use it when writing inject.steps for a new protocol.
        if not rest:
            print("usage: rcm calibrate <group/name> [protocol]", file=sys.stderr)
            return 2
        c = find(rest[0])
        if not c:
            print(f"no such connection: {rest[0]}", file=sys.stderr)
            return 1
        try:
            pid = rest[1] if len(rest) > 1 else next(
                (q.id for q in load_protocols().values() if q.injects), "")
            if not pid:
                print("rcm: no protocol defines inject.steps", file=sys.stderr)
                return 1
            p = protocol(pid)
            argv = build_argv(c, p.id)
        except (ConfigError, RuntimeError) as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        user, pw = creds_lookup(c.sel, c.username, proto=p.id)
        # Never interpolate the password: "${pw:-X}" style masking prints the value.
        print(f"protocol={p.label} host={c.host} user={user} password: "
              f"{'set (%d chars)' % len(pw) if pw and pw != 'CHANGEME' else 'NOT SET'}")
        try:
            _, new = open_credential_prompt(p, c.host, argv)
        except RuntimeError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        for w in sorted(new):
            print(f"--- window {w}")
            print(f"  name    : {xdotool('getwindowname', w)}")
            print(f"  geometry: {xdotool('getwindowgeometry', '--shell', w).replace(chr(10), ' ')}")
        foc = xdotool("getwindowfocus")
        print(f"focused   : {foc} ({xdotool('getwindowname', foc)})")
        shot = capture_window(sorted(new)[-1], Path.home() / "radmin-calibrate.png")
        print(f"image     : {shot}" if shot else
              "image     : skipped (needs gnome-screenshot + python3-pil)")
        print("\nDialog left open, nothing typed. The image shows which field holds "
              "the caret\nand whether the username is prefilled -- that is what sets "
              "inject_order.")
        return 0

    if cmd == "install-icon":
        try:
            written = install_icon()
        except RuntimeError as e:
            print(f"rcm: {e}", file=sys.stderr)
            return 1
        print(f"{len(written)} file(s) installed under {ICON_THEME_DIR}")
        print(f"  .desktop and windows can now use Icon={ICON_NAME}")
        return 0

    if cmd == "gen-launcher":
        print(f"{gen_launcher()} connection(s) -> {DESKTOP_FILE}")
        return 0

    if cmd == "health":
        problems = config_health()
        if not problems:
            print("configuration healthy — no warnings")
            return 0
        for w in problems:
            print(f"  {'ERROR ' if w.severity == 'error' else 'warn  '}{w.message}")
            print(f"         fix under Setup ▸ {w.setup_section}")
        return 1

    if cmd == "help":
        # `rcm help` lists the registered topics; `--dump` (the generated HTML
        # guide) arrives with the Help window itself.
        if not HELP_TOPICS:
            print("no help topics registered")
            return 0
        by_section: dict[str, list] = {}
        for t in HELP_TOPICS.values():
            by_section.setdefault(t.section or "General", []).append(t)
        for section, topics in by_section.items():
            print(f"[{section}]")
            for t in topics:
                print(f"  {t.topic_id:20} {t.title:32} {t.source_file}:{t.source_line}")
        return 0

    if cmd == "focus":
        msg = focus_gui()
        print(msg)
        return 0

    if cmd == "goto":
        if not rest:
            print("usage: rcm goto <group/name>", file=sys.stderr)
            return 2
        msg = goto(rest[0])
        print(msg)
        # Bound to a hotkey, so nothing is watching stdout.
        if msg.startswith("no such") or ": " in msg and "focused" not in msg:
            notify(msg)
        return 0

    if cmd in ("next", "prev", "cycle"):
        delta = -1 if cmd == "prev" else 1
        # A switcher is already on screen: tell it to move and get out of the way.
        pid = switcher_pid()
        if pid:
            try:
                os.kill(pid, signal.SIGUSR1 if delta > 0 else signal.SIGUSR2)
            except OSError:
                pass
            return 0
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        sys.modules.setdefault("rcm", sys.modules["__main__"])
        import rcm_switch
        return rcm_switch.run(delta)

    if cmd == "shortcuts":
        sub = rest[0] if rest else "list"
        if sub == "list":
            specs = shortcut_specs()
            active = parse_gsettings_list(run_gsettings("get", GS_LIST, "custom-list"))
            if not specs:
                print("nothing configured in", SHORTCUTS)
            for _id, name, cmdline, binding in specs:
                state = "installed" if _id in active else "not installed"
                print(f"  {binding:22} {name:28} [{state}]")
                for conflict in _binding_conflicts(binding):
                    print(f"      conflict: also bound to {conflict}")
            return 0
        if sub == "install":
            n, warnings = shortcuts_install()
            for w in warnings:
                print(f"  warning: {w}")
            print(f"{n} shortcut(s) registered with Cinnamon")
            print(f"remove them again with: {Path(__file__).resolve()} shortcuts remove")
            return 0
        if sub == "remove":
            print(f"{shortcuts_remove()} shortcut(s) removed")
            return 0
        print(f"unknown shortcuts subcommand: {sub}", file=sys.stderr)
        return 2

    if cmd == "gui":
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        # This file has no .py suffix, so "import rcm" cannot find it. Publish the
        # already-loaded __main__ under that name so the GUI shares this module
        # (and its caches) instead of loading a second copy.
        sys.modules.setdefault("rcm", sys.modules["__main__"])
        import rcm_gui
        return rcm_gui.run()

    print(f"unknown command: {cmd}\n\n{USAGE}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
